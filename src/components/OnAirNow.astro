---
type Props = {
  variant?: "compact" | "full";
};

const { variant = "compact" } = Astro.props;
const columns = [
  { key: "park", label: "Park", ascending: "A–Z", descending: "Z–A" },
  { key: "activator", label: "Activator", ascending: "A–Z", descending: "Z–A" },
  { key: "frequency", label: "Frequency", ascending: "low to high", descending: "high to low" },
  { key: "mode", label: "Mode", ascending: "A–Z", descending: "Z–A" },
  { key: "spotted", label: "Spotted", ascending: "oldest first", descending: "newest first" },
  { key: "source", label: "Source", ascending: "A–Z", descending: "Z–A" },
];
---

<div
  class:list={["on-air-now", `on-air-now--${variant}`]}
  data-on-air-now
>
  <div class="section-header section-header--compact">
    <p class="eyebrow">Live official spots</p>
    <h2 id="on-air-now-title">On air now</h2>
    {
      variant === "compact" && (
        <p class="lead">Rhode Island parks with a current official POTA spot.</p>
      )
    }
  </div>

  <p class="on-air-now__status" data-on-air-status aria-live="polite">
    Checking current spots...
  </p>
  {
    variant === "full" ? (
      <>
        <div class="on-air-now__sort-controls">
          <label class="on-air-now__sort-select">
            Sort live spots
            <select data-on-air-sort-select>
              {columns.map(({ key, label, ascending, descending }) => (
                <>
                  <option value={`${key}:asc`}>{label}: {ascending}</option>
                  <option value={`${key}:desc`} selected={key === "spotted"}>{label}: {descending}</option>
                </>
              ))}
            </select>
          </label>
          <p class="on-air-now__sort-hint">Select a column to sort; select again to reverse.</p>
          <button type="button" class="on-air-now__sort-reset" data-on-air-sort-reset hidden>Reset sort</button>
        </div>
        <table class="on-air-now__table" aria-labelledby="on-air-now-title" data-on-air-table hidden>
          <thead class="on-air-now__table-header" data-on-air-table-header>
            <tr>
              {columns.map(({ key, label }) => (
                <th scope="col" data-on-air-sort-column={key} aria-sort={key === "spotted" ? "descending" : undefined}>
                  <button type="button" data-on-air-sort={key} aria-label={`Sort by ${label}`}>
                    {label}<span data-on-air-sort-indicator aria-hidden="true">{key === "spotted" ? "↓" : "↕"}</span>
                  </button>
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="on-air-now__list" data-on-air-list />
        </table>
      </>
    ) : (
      <ul class="on-air-now__list" data-on-air-list hidden />
    )
  }
  <p class="on-air-now__empty" data-on-air-empty hidden>
    No Rhode Island parks have a current active spot.
  </p>
  <p class="on-air-now__updated" data-on-air-updated hidden></p>
  {
    variant === "compact" && (
      <>
        <p class="on-air-now__source">
          Spots can expire or change at any time. Confirm details in the
          <a href="https://pota.app/">official POTA app</a> before calling.
        </p>
        <p class="on-air-now__action">
          <a class="text-link" href="/on-air/">Open the full on-air view</a>
        </p>
      </>
    )
  }
</div>

<script>
  import {
    shouldWarnAboutStaleSnapshot,
    type LivePotaSpotsSnapshot,
  } from "../lib/pota/live-spots-client";
  import {
    livePotaSpotsStore,
    type LivePotaSpotsState,
  } from "../lib/pota/live-spots-store";
  import type { LivePotaSpot } from "../lib/pota/spots";
  import { parkGuidePath } from "../lib/parks/directory";
  import { formatRadioDetails } from "../lib/pota/radio-details";
  import {
    defaultLiveSpotsSort,
    formatSpotSource,
    readLiveSpotsSort,
    sortLiveSpots,
    writeLiveSpotsSort,
    type LiveSpotsSort,
    type LiveSpotsSortColumn,
  } from "../lib/pota/live-spots-view";

  document.querySelectorAll<HTMLElement>("[data-on-air-now]").forEach((root) => {
    setupOnAirNow(root);
  });

  function setupOnAirNow(root: HTMLElement): void {
    const full = root.classList.contains("on-air-now--full");
    let sort = full ? readLiveSpotsSort(new URLSearchParams(window.location.search)) : defaultLiveSpotsSort;
    let state: LivePotaSpotsState = { status: "loading" };
    const select = root.querySelector("[data-on-air-sort-select]") as HTMLSelectElement | null;
    const reset = root.querySelector<HTMLButtonElement>("[data-on-air-sort-reset]");

    if (full) {
      updateUrl("replace");
      updateControls();
      root.querySelectorAll<HTMLButtonElement>("[data-on-air-sort]").forEach((button) => {
        button.addEventListener("click", () => {
          const column = button.dataset.onAirSort as LiveSpotsSortColumn;
          setSort({
            column,
            direction: column === sort.column
              ? (sort.direction === "asc" ? "desc" : "asc")
              : (column === "spotted" ? "desc" : "asc"),
          });
        });
      });
      select?.addEventListener("change", () => {
        const [column, direction] = select.value.split(":");
        setSort(readLiveSpotsSort(new URLSearchParams({ sort: column, direction })));
      });
      reset?.addEventListener("click", () => setSort(defaultLiveSpotsSort));
      window.addEventListener("popstate", () => {
        sort = readLiveSpotsSort(new URLSearchParams(window.location.search));
        updateUrl("replace");
        render();
      });
    }

    livePotaSpotsStore.subscribe((nextState) => {
      state = nextState;
      render();
    });
    livePotaSpotsStore.start();

    function setSort(nextSort: LiveSpotsSort): void {
      sort = nextSort;
      updateUrl("push");
      render();
    }

    function updateUrl(mode: "push" | "replace"): void {
      const url = writeLiveSpotsSort(new URL(window.location.href), sort);
      if (url.href === window.location.href) return;
      if (mode === "push") window.history.pushState(window.history.state, "", url);
      else window.history.replaceState(window.history.state, "", url);
    }

    function updateControls(): void {
      if (select) select.value = `${sort.column}:${sort.direction}`;
      if (reset) {
        reset.hidden = sort.column === defaultLiveSpotsSort.column && sort.direction === defaultLiveSpotsSort.direction;
      }
      root.querySelectorAll<HTMLElement>("[data-on-air-sort-column]").forEach((header) => {
        const active = header.dataset.onAirSortColumn === sort.column;
        if (active) header.setAttribute("aria-sort", sort.direction === "asc" ? "ascending" : "descending");
        else header.removeAttribute("aria-sort");
        const indicator = header.querySelector("[data-on-air-sort-indicator]");
        if (indicator) indicator.textContent = active ? (sort.direction === "asc" ? "↑" : "↓") : "↕";
      });
    }

    function render(): void {
      if (full) updateControls();
      renderState(root, state, full ? sort : undefined);
    }
  }

  function renderState(root: HTMLElement, state: LivePotaSpotsState, sort?: LiveSpotsSort): void {
    if (state.status === "ready") {
      renderSpots(root, state.snapshot, sort);
    } else if (state.status === "unavailable") {
      renderUnavailable(root);
    }
  }

  function renderSpots(
    root: HTMLElement,
    snapshot: LivePotaSpotsSnapshot,
    sort?: LiveSpotsSort,
  ): void {
    const spots = sort ? sortLiveSpots(snapshot.spots, sort) : snapshot.spots;
    const status = root.querySelector<HTMLElement>("[data-on-air-status]");
    const table = root.querySelector<HTMLElement>("[data-on-air-table]");
    const list = root.querySelector<HTMLElement>("[data-on-air-list]");
    const empty = root.querySelector<HTMLElement>("[data-on-air-empty]");
    const updated = root.querySelector<HTMLElement>("[data-on-air-updated]");
    const activeParkCount = new Set(spots.map((spot) => spot.parkReference)).size;

    list?.replaceChildren(...spots.map((spot) => renderSpot(spot, Boolean(sort))));
    if (list) {
      list.hidden = spots.length === 0;
    }
    if (table) {
      table.hidden = spots.length === 0;
    }
    if (empty) {
      empty.hidden = spots.length > 0;
    }
    if (status) {
      status.textContent = spots.length > 0
        ? `${activeParkCount} ${activeParkCount === 1 ? "park has" : "parks have"} current spot${spots.length === 1 ? "" : "s"}.`
        : "Live check complete.";
    }
    if (updated) {
      updated.textContent = shouldWarnAboutStaleSnapshot(snapshot)
        ? `Temporarily showing the last successful update from ${formatCheckedTime(new Date(snapshot.generatedAt))}.`
        : `Last updated ${formatCheckedTime(new Date(snapshot.generatedAt))}.`;
      updated.hidden = false;
    }
    setPanelVisible(root, true);
  }

  function renderUnavailable(root: HTMLElement): void {
    const status = root.querySelector<HTMLElement>("[data-on-air-status]");
    if (status) {
      status.textContent = "Live spots are temporarily unavailable.";
    }
    const list = root.querySelector<HTMLElement>("[data-on-air-list]");
    list?.replaceChildren();
    if (list) {
      list.hidden = true;
    }
    const table = root.querySelector<HTMLElement>("[data-on-air-table]");
    if (table) {
      table.hidden = true;
    }
    const empty = root.querySelector<HTMLElement>("[data-on-air-empty]");
    if (empty) {
      empty.hidden = true;
    }
    const updated = root.querySelector<HTMLElement>("[data-on-air-updated]");
    if (updated) {
      updated.hidden = true;
    }
    setPanelVisible(root, root.classList.contains("on-air-now--full"));
  }

  function setPanelVisible(root: HTMLElement, visible: boolean): void {
    const panel = root.closest<HTMLElement>("[data-on-air-section]") ?? root;
    panel.hidden = !visible;
  }

  function renderSpot(spot: LivePotaSpot, full: boolean): HTMLLIElement | HTMLTableRowElement {
    const item = document.createElement(full ? "tr" : "li");
    const park = document.createElement("a");
    const activator = document.createElement("a");
    const radio = document.createElement("span");
    const time = document.createElement("time");
    const source = document.createElement("span");

    park.className = "on-air-now__park";
    park.href = parkGuidePath(spot.parkReference);
    park.textContent = `${spot.parkReference} · ${spot.parkName}`;

    activator.className = "on-air-now__activator";
    activator.href = `https://www.qrz.com/db/${encodeURIComponent(spot.activatorCallsign)}`;
    activator.target = "_blank";
    activator.rel = "noreferrer";
    activator.textContent = spot.activatorCallsign;

    radio.className = "on-air-now__radio";
    radio.textContent = formatRadioDetails(spot.frequency, spot.mode);

    time.className = "on-air-now__time";
    time.dateTime = normalizedSpotTimestamp(spot.spotTime);
    time.textContent = full ? formatSpotTime(spot.spotTime) : `Spotted ${formatSpotTime(spot.spotTime)}`;

    source.className = "on-air-now__spotter";
    source.textContent = formatSpotSource(spot);

    if (full) {
      const frequency = document.createElement("span");
      frequency.className = "on-air-now__frequency";
      frequency.textContent = formatRadioDetails(spot.frequency, "");
      const mode = document.createElement("span");
      mode.className = "on-air-now__mode";
      mode.textContent = spot.mode || "Not provided";
      source.textContent ||= "Not provided";
      const cells = [
        ["Park", park], ["Activator", activator], ["Frequency", frequency],
        ["Mode", mode], ["Spotted", time], ["Source", source],
      ] as const;
      for (const [label, content] of cells) {
        const cell = document.createElement("td");
        cell.dataset.label = label;
        cell.appendChild(content);
        item.appendChild(cell);
      }
      return item;
    }

    item.appendChild(park);
    item.appendChild(activator);
    item.appendChild(radio);
    item.appendChild(time);
    if (source.textContent) {
      item.appendChild(source);
    }
    return item;
  }

  function normalizedSpotTimestamp(value: string): string {
    return /(Z|[+-]\d{2}:?\d{2})$/i.test(value) ? value : `${value}Z`;
  }

  function formatSpotTime(value: string): string {
    const date = new Date(normalizedSpotTimestamp(value));
    if (!Number.isFinite(date.valueOf())) {
      return value;
    }

    return new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: "UTC",
      timeZoneName: "short",
    }).format(date);
  }

  function formatCheckedTime(date: Date): string {
    return new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      second: "2-digit",
    }).format(date);
  }
</script>
