---
import { activateRi2026Event } from "../../data/activate-ri-2026/event";
---

<section class="pota-progress" data-pota-progress data-phase={activateRi2026Event.phase} aria-labelledby="pota-progress-title">
  <div class="pota-progress__summary">
    <div>
      <p class="eyebrow">Unofficial event results</p>
      <h2 id="pota-progress-title">Progress across all 61 parks</h2>
      <p data-pota-summary-status role="status" aria-live="polite">Loading event progress…</p>
    </div>
    <progress max="61" value="0" aria-label="Parks confirmed by POTA" data-pota-progress-bar>0 of 61</progress>
    <dl class="coverage-summary" aria-label="POTA evidence summary">
      <div><dt>Confirmed by POTA</dt><dd data-pota-confirmed>—</dd></div>
      <div><dt>Observed, not confirmed</dt><dd data-pota-observed>—</dd></div>
      <div><dt>Scheduled, not confirmed</dt><dd data-pota-scheduled>—</dd></div>
      <div><dt>Still needed</dt><dd data-pota-needed>—</dd></div>
    </dl>
  </div>

  <p class="pota-progress__notice">
    This is an unofficial RI POTA community summary. Official Parks on the Air references, spots, logs, rules, and activation validity remain the source of truth. A planned or organizer-completed stop is never POTA confirmation.
  </p>
</section>

<script>
  import { potaParkStatusStore } from "../../lib/activate-ri/pota-status-store";
  import { subscribeEventPhase } from "../../lib/activate-ri/event-phase";
  import type { PublicPotaParkStatusSnapshot } from "../../lib/activate-ri/pota-status-client";

  document.querySelectorAll<HTMLElement>("[data-pota-progress]").forEach(setupPotaProgress);

  function setupPotaProgress(root: HTMLElement): void {
    let snapshot: PublicPotaParkStatusSnapshot | undefined;
    let refreshFailed = false;

    potaParkStatusStore.subscribe((state) => {
      if (state.status === "ready") {
        snapshot = state.snapshot;
        refreshFailed = state.refreshFailed;
        renderSummary(state.snapshot);
      } else if (state.status === "unavailable") {
        root.querySelector("[data-pota-progress-bar]")?.removeAttribute("value");
        setText(
          "[data-pota-summary-status]",
          "Event progress is temporarily unavailable. Refresh the parks below to try again.",
        );
      }
    });
    subscribeEventPhase((phase) => {
      root.dataset.phase = phase;
      if (phase === "event-live" || phase === "post-event") potaParkStatusStore.start();
      if (snapshot) renderSummary(snapshot);
    });

    function renderSummary(value: PublicPotaParkStatusSnapshot): void {
      setText("[data-pota-confirmed]", `${value.summary.confirmed} / ${value.summary.total}`);
      setText("[data-pota-observed]", String(value.summary.observedNotConfirmed));
      setText("[data-pota-scheduled]", String(value.summary.scheduledNotConfirmed));
      setText("[data-pota-needed]", String(value.summary.stillNeeded));
      const progress = root.querySelector<HTMLProgressElement>("[data-pota-progress-bar]");
      if (progress) {
        progress.max = value.summary.total;
        progress.value = value.summary.confirmed;
        progress.textContent = `${value.summary.confirmed} of ${value.summary.total}`;
      }
      const lastUpdated = value.lastPotaSyncAt ? formatUtcTimestamp(value.lastPotaSyncAt) : "not yet reconciled";
      setText(
        "[data-pota-summary-status]",
        value.warning ?? (refreshFailed
          ? `Showing the last successful result as of ${lastUpdated}; refresh failed.`
          : `${root.dataset.phase === "post-event" ? "Provisional results" : "Progress"} as of ${lastUpdated}.`),
      );
    }

    function setText(selector: string, value: string): void {
      root.querySelector(selector)?.replaceChildren(value);
    }
  }

  function formatUtcTimestamp(value: string): string {
    const date = new Date(value);
    return Number.isFinite(date.valueOf())
      ? new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZone: "UTC", timeZoneName: "short" }).format(date)
      : value;
  }
</script>
