<section class="admin-panel admin-view" id="admin-security" aria-labelledby="admin-security-title" data-admin-view="security" hidden>
  <div class="admin-panel__header">
    <div>
      <p class="eyebrow">Account safety</p>
      <h2 id="admin-security-title">Administrator and activator accounts</h2>
      <p>
        Reset links are non-destructive until the replacement passkey is installed.
        Emergency disable immediately revokes credentials and sessions but preserves event data.
      </p>
    </div>
    <button class="button" data-variant="light" type="button" data-admin-account-refresh>Refresh accounts</button>
  </div>
  <p class="admin-status" data-admin-account-status aria-live="polite">Loading account security status…</p>
  <div class="admin-list" data-admin-account-list></div>
</section>

<script>
  const list = document.querySelector<HTMLElement>("[data-admin-account-list]");
  const status = document.querySelector<HTMLElement>("[data-admin-account-status]");
  const refresh = document.querySelector<HTMLButtonElement>("[data-admin-account-refresh]");
  refresh?.addEventListener("click", () => void loadAccounts());
  void loadAccounts();

  async function loadAccounts(successMessage?: string): Promise<void> {
    if (refresh) refresh.disabled = true;
    status?.replaceChildren("Loading account security status…");
    try {
      const response = await fetch("/api/activate-ri-2026/admin/accounts");
      if (response.status === 401 || response.status === 403) {
        status?.replaceChildren("Sign in with your administrator passkey, then refresh accounts.");
        return;
      }
      const body = await response.json();
      if (!response.ok || !isRecord(body) || !Array.isArray(body.accounts)) throw new Error("Unavailable");
      const accounts = body.accounts.filter(isAccount);
      const focusedButton = list?.contains(document.activeElement) && document.activeElement instanceof HTMLButtonElement
        ? document.activeElement.getAttribute("aria-label") : null;
      list?.replaceChildren(...accounts.map(accountCard));
      if (focusedButton) [...list?.querySelectorAll<HTMLButtonElement>("button") ?? []]
        .find((button) => button.getAttribute("aria-label") === focusedButton)?.focus();
      status?.replaceChildren(successMessage ?? (accounts.length ? `${accounts.length} accounts loaded.` : "No accounts found."));
    } catch {
      status?.replaceChildren("Unable to load accounts. Check your connection and try Refresh accounts again.");
    } finally {
      if (refresh) refresh.disabled = false;
    }
  }

  function accountCard(account: Account): HTMLElement {
    const card = document.createElement("article");
    card.className = "admin-card admin-account-card";
    const title = document.createElement("h3");
    title.textContent = account.callsign ?? account.email;
    const detail = document.createElement("p");
    const lastUse = account.lastPasskeyUse
      ? ` · last passkey use ${new Date(account.lastPasskeyUse).toLocaleString()}`
      : " · no passkey use recorded";
    detail.textContent = account.claimed
      ? `${account.admin ? "Administrator" : "Activator member"} · ${account.email} · ${account.passkeyCount} active passkey(s)${lastUse} · ${account.activeSessionCount} active session(s)${account.disabled ? " · DISABLED" : ""}`
      : "Activator account not yet claimed";
    card.appendChild(title);
    card.appendChild(detail);
    if (!account.userId) return card;

    const actions = document.createElement("div");
    actions.className = "button-row";
    actions.appendChild(actionButton("Send reset link", "passkey-reset", account, false));
    actions.appendChild(actionButton("Revoke sessions", "revoke-auth-sessions", account, false));
    actions.appendChild(actionButton(account.disabled ? "Re-enable" : "Emergency disable", account.disabled ? "enable-auth" : "disable-auth", account, !account.disabled));
    card.appendChild(actions);
    return card;
  }

  function actionButton(label: string, action: string, account: Account, destructive: boolean): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "button";
    button.dataset.variant = destructive ? "danger" : "light";
    button.textContent = label;
    button.setAttribute("aria-label", `${label} for ${account.callsign ?? account.email}`);
    button.addEventListener("click", async () => {
      let confirmation = "";
      const target = account.callsign ?? account.email;
      if (destructive) {
        confirmation = window.prompt(`Type ${target} to immediately disable this account and revoke its access.`) ?? "";
        if (!confirmation) return;
        if (account.admin && !window.confirm("This account also has the administrator role. Continue?")) return;
      } else {
        const effect = action === "passkey-reset"
          ? "Existing passkeys and sessions remain active until a replacement passkey is installed."
          : action === "revoke-auth-sessions"
            ? "This signs out unified and legacy sessions but leaves passkeys usable."
            : "Re-enabling requires the user to complete account recovery.";
        confirmation = window.prompt(`${effect}\n\nType ${target} to continue.`) ?? "";
        if (!confirmation) return;
      }
      button.disabled = true;
      status?.replaceChildren(`${label} in progress…`);
      try {
        const response = await fetch(`/api/activate-ri-2026/admin/accounts/${encodeURIComponent(account.userId!)}/${action}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ confirmation }),
        });
        if (response.ok) await loadAccounts(`${label} completed for ${target}.`);
        else status?.replaceChildren(`${label} did not complete. Check the confirmation and try again.`);
      } catch {
        status?.replaceChildren(`${label} did not complete. Check your connection and try again.`);
      } finally {
        button.disabled = false;
      }
    });
    return button;
  }

  type Account = {
    userId: string | null; email: string; callsign: string | null; admin: boolean;
    claimed: boolean; disabled: boolean; passkeyCount: number; lastPasskeyUse: string | null;
    activeSessionCount: number;
  };
  function isAccount(value: unknown): value is Account {
    return isRecord(value) && (value.userId === null || typeof value.userId === "string") &&
      typeof value.email === "string" && (value.callsign === null || typeof value.callsign === "string") &&
      typeof value.admin === "boolean" && typeof value.claimed === "boolean" &&
      typeof value.disabled === "boolean" && typeof value.passkeyCount === "number" &&
      (value.lastPasskeyUse === null || typeof value.lastPasskeyUse === "string") &&
      typeof value.activeSessionCount === "number";
  }
  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === "object" && value !== null && !Array.isArray(value);
  }
</script>

<style>
  #admin-security :global(.admin-account-card) { display: block; }
  #admin-security :global(.admin-account-card p) { overflow-wrap: anywhere; }
</style>
