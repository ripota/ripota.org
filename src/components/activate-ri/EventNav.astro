---
export interface Props {
  showProgress?: boolean;
}

const { showProgress = false } = Astro.props;
const progressPath = "/activate-ri-2026/progress/";
const links = [
  ["Overview", "/activate-ri-2026/"],
  ["Schedule", "/activate-ri-2026/schedule/"],
  ["Parks", "/activate-ri-2026/parks/"],
  ["Progress", progressPath],
  ["Hunter", "/activate-ri-2026/hunter/"],
  ["Photos & videos", "/activate-ri-2026/media/"],
  ["FAQ", "/activate-ri-2026/help/"],
  ["Activator", "/activate-ri-2026/activator/"],
];

const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const progressAlwaysVisible = showProgress || currentPath === progressPath;

function isCurrent(href: string): boolean {
  if (href === "/activate-ri-2026/activator/") {
    return currentPath.startsWith(href) || [
      "/activate-ri-2026/access/",
      "/activate-ri-2026/volunteer/",
    ].includes(currentPath);
  }

  return currentPath === href;
}
---

<nav class="event-nav" aria-label="Activate All RI navigation">
  {
    links.map(([label, href]) => (
      <a
        href={href}
        aria-current={isCurrent(href) ? (currentPath === href ? "page" : "location") : undefined}
        hidden={href === progressPath && !progressAlwaysVisible}
        data-event-progress-link={href === progressPath || undefined}
        data-progress-always-visible={href === progressPath && progressAlwaysVisible ? "true" : undefined}
      >
        {label}
      </a>
    ))
  }
</nav>

<script>
  import { subscribeEventPhase } from "../../lib/activate-ri/event-phase";

  subscribeEventPhase((phase) => {
    const eventStarted = phase === "event-live" || phase === "post-event";
    document.querySelectorAll<HTMLAnchorElement>("[data-event-progress-link]").forEach((link) => {
      link.hidden = !eventStarted && link.dataset.progressAlwaysVisible !== "true";
    });
    revealCurrentDestinations();
  });

  window.addEventListener("resize", revealCurrentDestinations);

  function revealCurrentDestinations(): void {
    // Keep the current destination visible in the compact, horizontally scrolling nav.
    // Scroll only the navigation itself, so deep links keep their page position.
    document.querySelectorAll<HTMLElement>('.event-nav[aria-label="Activate All RI navigation"]').forEach((nav) => {
      const current = nav.querySelector<HTMLAnchorElement>("[aria-current]");
      if (!current || nav.scrollWidth <= nav.clientWidth) return;
      const navBounds = nav.getBoundingClientRect();
      const currentBounds = current.getBoundingClientRect();
      nav.scrollLeft += currentBounds.left - navBounds.left - (nav.clientWidth - currentBounds.width) / 2;
    });
  }
</script>

<style>
  [data-event-progress-link][hidden] { display: none !important; }
</style>
