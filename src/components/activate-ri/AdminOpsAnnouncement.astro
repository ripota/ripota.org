<section class="admin-activity admin-announcement" aria-labelledby="admin-ops-announcement-title">
  <div>
    <p class="eyebrow">Reach everyone</p>
    <h3 id="admin-ops-announcement-title">Post an announcement</h3>
    <p class="lead">Room posts are immediate. Email copies are optional and require confirmation.</p>
  </div>
  <form class="event-form admin-ops-form" data-admin-ops-announcement>
    <label>
      <span class="sr-only">Announcement text</span>
      <textarea name="body" rows="3" maxlength="1000" required placeholder="What does the room need to know?"></textarea>
    </label>
    <label class="admin-ops-check"><input type="checkbox" name="pin" /> Pin this announcement</label>
    <label class="admin-ops-check"><input type="checkbox" name="email" /> Also email eligible activators</label>
    <p class="ops-meta" data-admin-ops-recipient-preview></p>
    <button class="button" data-variant="primary" type="submit">Post announcement</button>
  </form>
</section>
