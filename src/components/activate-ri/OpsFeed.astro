---
import OpsComposer from "./OpsComposer.astro";
---

<section class="ops-card ops-feed-card" aria-labelledby="ops-feed-title">
  <div class="ops-card__heading">
    <div>
      <p class="eyebrow">Newest first</p>
      <h2 id="ops-feed-title">Room chat</h2>
    </div>
    <div class="ops-feed-navigation">
      <button class="button" data-variant="light" type="button" data-ops-unread hidden>Jump to unread</button>
      <button class="button" data-variant="light" type="button" data-ops-latest>Latest</button>
      <button class="button" data-variant="light" type="button" data-ops-refresh aria-label="Refresh room updates">↻</button>
    </div>
  </div>
  <OpsComposer />
  <fieldset class="ops-filters" data-ops-filters>
    <legend class="sr-only">Filter room updates</legend>
    <label><input type="radio" name="ops-filter" value="all" checked /> All</label>
    <label><input type="radio" name="ops-filter" value="announcement" /> Announcements</label>
    <label><input type="radio" name="ops-filter" value="need-backup" /> Backup</label>
    <label><input type="radio" name="ops-filter" value="access-note" /> Access</label>
    <label><input type="radio" name="ops-filter" value="my-parks" /> My parks</label>
  </fieldset>
  <ol class="ops-feed" data-ops-feed tabindex="-1" aria-label="Room messages" aria-live="polite" aria-relevant="additions text">
    <li class="ops-empty ops-empty--room">
      <strong>Opening the room…</strong>
      <span>Recent announcements and field updates will appear here.</span>
    </li>
  </ol>
  <p class="sr-only" data-ops-unread-status aria-live="polite"></p>
</section>
