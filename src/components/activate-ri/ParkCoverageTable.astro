---
import parks from "../../../public/data/activate-ri-2026/parks.json";
import { timelineOptions, uniqueSortedValues } from "../../lib/activate-ri/listing";
import type { PublicParkSummary } from "../../lib/activate-ri/types";

const publicParks = parks as PublicParkSummary[];
const counties = uniqueSortedValues(publicParks.map((park) => park.counties));
---

<div data-park-planning>
  <form class="event-filters park-planning-filters" data-event-filters aria-label="Park planning filters">
    <label class="event-filter">
      Search parks
      <input class="event-filter__control" type="search" data-planning-search placeholder="Reference or park name" />
    </label>
    <label class="event-filter">
      Sort parks
      <select class="event-filter__control" data-filter="sort">
        <option value="activators">Fewest activators</option>
        <option value="slots">Fewest time slots</option>
        <option value="name">Park name</option>
      </select>
    </label>
    <label class="event-filter">
      Event day (Rhode Island time)
      <select class="event-filter__control" data-filter="timeline">
        {timelineOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
    <label class="event-filter">
      County
      <select class="event-filter__control" data-filter="county">
        <option value="all">Any county</option>
        {counties.map((county) => <option value={county}>{county}</option>)}
      </select>
    </label>
    <div class="park-planning-personal">
      <label class="event-coverage-toggle">
        <input type="checkbox" data-my-parks disabled aria-describedby="my-parks-help" />
        <span data-my-parks-label>My parks</span>
      </label>
      <p id="my-parks-help" data-my-parks-help>Checking sign-in…</p>
      <a data-my-parks-sign-in href="/account/sign-in/?returnTo=%2Factivate-ri-2026%2Fparks%2F%3Fmine%3D1" hidden>Sign in to see my parks</a>
      <a data-my-plan href="/activate-ri-2026/activator/plan/" hidden>Edit my plan</a>
    </div>
    <details class="park-planning-more">
      <summary data-planning-more-summary>More filters</summary>
      <div class="event-filters">
        <label class="event-filter">
          Mode
          <select class="event-filter__control" data-filter="mode"><option value="all">Any mode</option></select>
        </label>
        <label class="event-filter">
          Band
          <select class="event-filter__control" data-filter="band"><option value="all">Any band</option></select>
        </label>
      </div>
    </details>
  </form>
  <p class="park-planning-note">Counts include published scheduled and delayed plans for the selected dates, bands, and modes. Parks with no matching plans stay in the list. Expand a count to see the planned times.</p>
  <div class="park-planning-status">
    <p data-planning-status role="status">Loading the event schedule…</p>
    <div class="park-planning-actions">
      <button class="button" data-variant="light" type="button" data-clear-planning disabled>Clear filters</button>
      <button class="button" data-variant="light" type="button" data-reload-planning>Refresh plans</button>
    </div>
  </div>
  <div class="event-table-wrap">
    <table class="event-table park-planning-table" data-live-coverage data-parks={JSON.stringify(publicParks)}>
      <thead><tr><th scope="col">Park</th><th scope="col">Scheduled plans</th><th scope="col">Your next activation</th></tr></thead>
      <tbody><tr><td colspan="3">Loading the event schedule…</td></tr></tbody>
    </table>
  </div>
  <noscript><p>Enable JavaScript to compare current plans, or <a href="/activate-ri-2026/volunteer/">add an activation</a>.</p></noscript>
</div>

<script>
  import { fetchPublicActivationStops } from "../../lib/activate-ri/public-stops-client";
  import { deriveParkPlans, myScheduledParkReferences, type ParkPlanSummary } from "../../lib/activate-ri/planning";
  import { readPlanningView, writePlanningView } from "../../lib/activate-ri/planning-view";
  import { filterPublicStops, uniqueSortedValues } from "../../lib/activate-ri/listing";
  import { formatActivationDate, formatActivationTimeRange } from "../../lib/activate-ri/time";
  import type { PublicActivationStop, PublicParkSummary } from "../../lib/activate-ri/types";
  import { trackAnalyticsEvent } from "../../lib/analytics/client";
  import { replaceLiveContent } from "../../lib/activate-ri/live-content";

  document.querySelectorAll<HTMLElement>("[data-park-planning]").forEach(setupPlanning);

  function setupPlanning(root: HTMLElement): void {
    const table = root.querySelector<HTMLTableElement>("[data-live-coverage]")!;
    const body = table.querySelector("tbody")!;
    const form = root.querySelector<HTMLFormElement>("form")!;
    const controls = Array.from(form.querySelectorAll("[data-filter]")) as unknown as HTMLSelectElement[];
    const mine = root.querySelector<HTMLInputElement>("[data-my-parks]")!;
    const mineLabel = root.querySelector<HTMLElement>("[data-my-parks-label]")!;
    const mineHelp = root.querySelector<HTMLElement>("[data-my-parks-help]")!;
    const moreFilters = root.querySelector<HTMLDetailsElement>(".park-planning-more")!;
    const signIn = root.querySelector<HTMLAnchorElement>("[data-my-parks-sign-in]")!;
    const myPlan = root.querySelector<HTMLAnchorElement>("[data-my-plan]")!;
    const status = root.querySelector<HTMLElement>("[data-planning-status]")!;
    const refresh = root.querySelector<HTMLButtonElement>("[data-reload-planning]")!;
    const clear = root.querySelector<HTMLButtonElement>("[data-clear-planning]")!;
    const search = root.querySelector<HTMLInputElement>("[data-planning-search]")!;
    const parks = JSON.parse(table.dataset.parks ?? "[]") as PublicParkSummary[];
    let view = readPlanningView(new URL(window.location.href), parks);
    let stops: PublicActivationStop[] | null = null;
    let callsign = "";
    let sessionLoading = true;
    let loadedAt: Date | null = null;
    let loading = false;
    let accountSignedIn = false;
    let sessionFailed = false;
    let searchEditing = false;

    search.value = new URL(window.location.href).searchParams.get("q")?.trim() ?? "";
    syncControls();
    updateUrl("replace");
    render();
    form.addEventListener("submit", (event) => event.preventDefault());
    search.addEventListener("input", () => {
      searchEditing = updateUrl(searchEditing ? "replace" : "push") || searchEditing;
      render();
    });
    search.addEventListener("blur", () => { searchEditing = false; });
    search.addEventListener("change", () => { searchEditing = false; });
    clear.addEventListener("click", () => {
      search.value = "";
      searchEditing = false;
      view = { ...view, sort: "activators", timeline: "all", county: "all", mode: "all", band: "all", activator: "", mine: false };
      syncControls();
      updateUrl();
      render();
      search.focus();
    });
    form.addEventListener("change", (event) => {
      searchEditing = false;
      const target = event.target;
      if (target === mine) {
        view.activator = mine.checked ? callsign : "";
        view.mine = mine.checked && !callsign;
      } else if (target instanceof HTMLSelectElement) {
        const key = target.dataset.filter;
        if (key === "sort") view.sort = target.value === "name" || target.value === "slots" ? target.value : "activators";
        else if (key === "timeline" || key === "county" || key === "mode" || key === "band") view[key] = target.value;
      }
      syncControls();
      updateUrl();
      render();
      const category = target === mine ? "activator" : target instanceof HTMLSelectElement ? target.dataset.filter : "";
      if (category === "timeline" || category === "county" || category === "mode" || category === "band" || category === "activator") {
        void trackAnalyticsEvent("activate-ri-2026", "coverage_filter_used", { filterCategory: category });
      }
    });
    moreFilters.addEventListener("toggle", () => {
      // Hydration also queues toggle events; only record an actual user change.
      if (moreFilters.open === view.moreFilters) return;
      view.moreFilters = moreFilters.open;
      updateUrl();
    });
    moreFilters.querySelector("summary")!.addEventListener("click", (event) => {
      event.preventDefault();
      view.moreFilters = !moreFilters.open;
      moreFilters.open = view.moreFilters;
      updateUrl();
    });
    window.addEventListener("popstate", () => {
      searchEditing = false;
      search.value = new URL(window.location.href).searchParams.get("q")?.trim() ?? "";
      view = readPlanningView(new URL(window.location.href), parks);
      resolveMyParks();
      syncControls();
      updateUrl("replace");
      render();
    });
    signIn.addEventListener("click", updateSignInLink);
    refresh.addEventListener("click", () => { void load(true); });
    void load();

    function resolveMyParks(): void {
      if (view.mine && callsign && !sessionLoading) {
        view.activator = callsign;
        view.mine = false;
      }
    }

    function syncControls(): void {
      const active = (stops ?? []).filter((stop) => !stop.id.startsWith("sample-") && (stop.status === "scheduled" || stop.status === "delayed"));
      for (const key of ["mode", "band"] as const) {
        const control = controls.find((candidate) => candidate.dataset.filter === key)!;
        const options = uniqueSortedValues(active.map((stop) => key === "mode" ? stop.modes : stop.bands));
        // A shared filter remains useful even when there are no matching plans.
        if (view[key] !== "all" && !options.includes(view[key])) options.push(view[key]);
        control.replaceChildren(new Option(key === "mode" ? "Any mode" : "Any band", "all"), ...options.map((option) => new Option(option, option)));
      }
      for (const control of controls) {
        const key = control.dataset.filter as "sort" | "timeline" | "county" | "mode" | "band";
        control.value = view[key];
      }
      moreFilters.open = view.moreFilters;
      mine.checked = !!view.activator || view.mine;
      mine.disabled = !mine.checked && (sessionLoading || !callsign);
      const sharedScope = view.activator && view.activator !== callsign;
      mineLabel.textContent = sharedScope ? `${view.activator}'s parks` : "My parks";
      mineHelp.textContent = sharedScope
        ? `${view.activator}'s scheduled parks across the event, with counts for everyone.`
        : sessionLoading ? "Checking sign-in…"
        : sessionFailed ? "Could not check your account. Refresh plans to try again."
        : callsign ? `Your scheduled parks across the event, with counts for everyone. Signed in as ${callsign}.`
        : accountSignedIn ? "Your parks will appear after your activation plan is approved."
        : "Sign in to filter to parks in your activation plan.";
      signIn.hidden = sessionLoading || accountSignedIn;
      myPlan.hidden = !callsign;
    }

    function updateUrl(mode: "push" | "replace" = "push"): boolean {
      const url = writePlanningView(new URL(window.location.href), view);
      if (search.value.trim()) url.searchParams.set("q", search.value.trim());
      else url.searchParams.delete("q");
      const changed = url.href !== window.location.href;
      if (changed) {
        if (mode === "push") window.history.pushState(window.history.state, "", url);
        else window.history.replaceState(window.history.state, "", url);
      }
      updateSignInLink();
      return changed;
    }

    function updateSignInLink(): void {
      const returnTo = new URL(window.location.href);
      returnTo.searchParams.delete("activator");
      returnTo.searchParams.set("mine", "1");
      signIn.href = `/account/sign-in/?returnTo=${encodeURIComponent(returnTo.pathname + returnTo.search + returnTo.hash)}`;
    }

    async function load(force = false): Promise<void> {
      if (loading) return;
      loading = true;
      refresh.disabled = true;
      status.textContent = "Loading the event schedule…";
      await Promise.all([loadStops(force), loadSession()]);
      loading = false;
      refresh.disabled = false;
    }

    async function loadStops(force: boolean): Promise<void> {
      try {
        stops = await fetchPublicActivationStops(force ? (input, init) => {
          const headers = new Headers(init?.headers);
          headers.set("cache-control", "no-cache");
          return fetch(input, { ...init, headers, cache: "no-store" });
        } : undefined);
        loadedAt = new Date();
        syncControls();
        render();
      } catch {
        stops = null;
        status.textContent = "Live coverage is unavailable. Use Refresh plans to try again.";
        showMessage("Live coverage is unavailable. Use Refresh plans to try again.");
      }
    }

    async function loadSession(): Promise<void> {
      sessionLoading = true;
      sessionFailed = false;
      syncControls();
      try {
        const response = await fetch("/api/auth/session", { headers: { accept: "application/json" }, cache: "no-store" });
        if (!response.ok) throw new Error("Session unavailable");
        const session = await response.json() as { signedIn?: boolean; activator?: { callsign?: string } | null };
        if (!session || typeof session.signedIn !== "boolean") throw new Error("Invalid session response");
        accountSignedIn = session.signedIn === true;
        callsign = session.signedIn === true && typeof session.activator?.callsign === "string" ? session.activator.callsign.trim().toUpperCase() : "";
      } catch {
        sessionFailed = true;
        accountSignedIn = false;
        callsign = "";
      } finally {
        sessionLoading = false;
        resolveMyParks();
        syncControls();
        updateUrl("replace");
        render();
      }
    }

    function render(): void {
      const query = search.value.trim().toLowerCase();
      clear.disabled = !query && !mine.checked && controls.every((control) => control.value === "all" || (control.dataset.filter === "sort" && control.value === "activators"));
      const activeMore = (["mode", "band"] as const).filter((key) => view[key] !== "all").length;
      root.querySelector("[data-planning-more-summary]")!.textContent = activeMore ? `More filters (${activeMore} active)` : "More filters";
      if (!stops) return;
      if (view.mine) {
        const message = sessionLoading ? "Checking your activation plan…" : accountSignedIn ? "Your account has no published activation plan yet. Clear My parks to find a park to activate." : "Sign in with an activator account to see your scheduled parks, or clear My parks to see all parks.";
        status.textContent = message;
        showMessage(message);
        return;
      }
      const personalParks = callsign ? myScheduledParkReferences(stops, callsign) : new Set<string>();
      const filteredStops = filterPublicStops(stops, parks, { mode: view.mode, band: view.band });
      const rows = deriveParkPlans(parks, filteredStops, {
        timeline: view.timeline, county: view.county, sort: view.sort,
        ...(view.activator ? { myParkReferences: myScheduledParkReferences(stops, view.activator) } : {}),
      }).filter((park) => !query || `${park.reference} ${park.name}`.toLowerCase().includes(query));
      const selectedScope = controls.filter((control) => control.dataset.filter !== "sort" && control.value !== "all")
        .map((control) => control.selectedOptions[0]?.textContent ?? "");
      const scope = selectedScope.length ? selectedScope.join(" · ") : "All event dates";
      const loaded = loadedAt ? ` Updated ${new Intl.DateTimeFormat(undefined, { timeStyle: "short" }).format(loadedAt)}.` : "";
      status.textContent = `${rows.length} ${rows.length === 1 ? "park" : "parks"}${query ? ` matching “${search.value.trim()}”` : ""} · ${view.activator ? `${mineLabel.textContent} · ` : ""}${scope}.${loaded}`;
      if (!rows.length) {
        showMessage(view.activator ? `No published scheduled parks in ${view.activator === callsign ? "your plan" : `${view.activator}'s plan`} match these filters. Clear ${mineLabel.textContent} to find another park to activate.` : "No parks match these filters.");
        return;
      }
      replaceLiveContent(body, rows.map((park) => createRow(park, personalParks.has(park.reference))));
    }

    function showMessage(message: string): void {
      const row = document.createElement("tr");
      row.dataset.filterEmpty = "";
      const cell = document.createElement("td");
      cell.colSpan = 3;
      cell.textContent = message;
      row.appendChild(cell);
      body.replaceChildren(row);
    }

    function createRow(park: ParkPlanSummary, isMine: boolean): HTMLTableRowElement {
      const row = document.createElement("tr");
      row.dataset.filterRow = "";
      row.dataset.parkReference = park.reference;
      const heading = document.createElement("th");
      heading.scope = "row";
      heading.dataset.label = "Park";
      const guideLink = document.createElement("a");
      guideLink.className = "event-table-park-link";
      guideLink.dataset.liveKey = `${park.reference}-guide`;
      guideLink.href = `/parks/${encodeURIComponent(park.reference.toLowerCase())}/`;
      guideLink.textContent = park.name;
      heading.appendChild(guideLink);
      for (const text of [park.reference, park.counties.join(", ")]) {
        const line = document.createElement("span");
        line.textContent = text;
        heading.appendChild(line);
      }
      if (isMine) {
        const badge = document.createElement("span");
        badge.className = "park-planning-mine";
        badge.textContent = "In my plan";
        heading.appendChild(badge);
      }
      const plans = document.createElement("td");
      plans.dataset.label = "Scheduled plans";
      const details = document.createElement("details");
      details.className = "park-plan-details";
      details.open = view.expanded.includes(park.reference);
      details.addEventListener("toggle", () => {
        if (!details.isConnected || details.open === view.expanded.includes(park.reference)) return;
        view.expanded = details.open ? [...view.expanded, park.reference] : view.expanded.filter((reference) => reference !== park.reference);
        updateUrl();
      });
      const summary = document.createElement("summary");
      summary.textContent = `${park.activatorCount} ${park.activatorCount === 1 ? "activator" : "activators"} · ${park.timeSlotCount} ${park.timeSlotCount === 1 ? "time slot" : "time slots"}`;
      summary.dataset.liveKey = `${park.reference}-plans`;
      summary.addEventListener("click", (event) => {
        // Record the choice before an in-flight response can replace this row.
        event.preventDefault();
        details.open = !details.open;
        view.expanded = details.open ? [...view.expanded, park.reference] : view.expanded.filter((reference) => reference !== park.reference);
        updateUrl();
      });
      details.appendChild(summary);
      if (!park.stops.length) {
        const empty = document.createElement("p");
        empty.textContent = "No scheduled activations match these dates, bands, and modes. Add an activation to give hunters another opportunity.";
        details.appendChild(empty);
      } else {
        const list = document.createElement("ul");
        list.className = "park-plan-stops";
        for (const stop of park.stops) {
          const item = document.createElement("li");
          const operator = document.createElement("strong");
          operator.textContent = stop.activatorCallsign;
          const time = document.createElement("span");
          time.textContent = `${formatActivationDate(stop)}, ${formatActivationTimeRange(stop)}${stop.status === "delayed" ? " · Delayed" : ""}`;
          const radio = document.createElement("span");
          radio.textContent = `${stop.bands.join(", ") || "Bands TBD"} · ${stop.modes.join(", ") || "Modes TBD"}`;
          item.appendChild(operator);
          item.appendChild(time);
          item.appendChild(radio);
          if (stop.publicNotes.trim()) {
            const note = document.createElement("span");
            note.textContent = stop.publicNotes;
            item.appendChild(note);
          }
          list.appendChild(item);
        }
        details.appendChild(list);
      }
      plans.appendChild(details);
      const actions = document.createElement("td");
      actions.dataset.label = "Your next activation";
      const add = document.createElement("a");
      const query = new URLSearchParams({ park: park.reference });
      const day = view.timeline === "soft-start" ? "2026-09-10" : view.timeline;
      if (/^2026-09-1[0-3]$/.test(day)) query.set("date", day);
      add.href = `/activate-ri-2026/${callsign ? "activator/plan" : "volunteer"}/?${query}`;
      add.className = "button event-table-action";
      add.dataset.variant = "primary";
      add.dataset.analyticsEvent = "event_cta_clicked";
      add.dataset.analyticsFeature = "coverage";
      add.dataset.analyticsPlacement = "coverage";
      add.dataset.analyticsAction = "volunteer";
      add.textContent = "Add an activation";
      add.dataset.liveKey = `${park.reference}-add`;
      actions.appendChild(add);
      if (isMine) {
        const edit = document.createElement("a");
        edit.className = "park-planning-edit";
        edit.href = "/activate-ri-2026/activator/plan/";
        edit.textContent = "Edit my plan";
        edit.dataset.liveKey = `${park.reference}-edit`;
        actions.appendChild(edit);
      }
      row.appendChild(heading);
      row.appendChild(plans);
      row.appendChild(actions);
      return row;
    }
  }
</script>

<style is:global>
  .park-planning-filters { align-items: start; }
  .park-planning-filters .event-filter { align-content: start; }
  .park-planning-filters .event-filter__control { min-height: 46px; }
  .park-planning-personal { display: grid; align-content: start; gap: 0.4rem; }
  .park-planning-personal p { margin: 0; color: var(--text-muted); font-size: 0.85rem; }
  .park-planning-personal a { font-size: 0.9rem; }
  .park-planning-more { grid-column: 1 / -1; }
  .park-planning-more > summary { cursor: pointer; font-weight: 700; }
  .park-planning-more .event-filters { margin: 0.7rem 0 0; }
  .park-planning-note { color: var(--text-muted); font-size: 0.9rem; }
  .park-planning-status { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 1rem 0; }
  .park-planning-status p { margin: 0; color: var(--text-muted); }
  .park-planning-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .park-planning-table { table-layout: fixed; }
  .park-planning-table th:first-child { width: 38%; }
  .park-planning-table th:nth-child(2) { width: 38%; }
  .park-planning-table td, .park-planning-table th { overflow-wrap: anywhere; }
  .park-plan-details summary { cursor: pointer; color: var(--link-strong); font-weight: 800; }
  .park-plan-details summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .park-plan-stops { display: grid; gap: 0.85rem; padding: 0; margin: 0.9rem 0 0; list-style: none; }
  .park-plan-stops li { display: grid; gap: 0.2rem; padding-top: 0.7rem; border-top: 1px solid var(--border-subtle); }
  .park-plan-stops span { color: var(--text-muted); font-size: 0.9rem; }
  .park-planning-table .event-table-action { margin: 0; min-height: 44px; }
  .park-planning-edit { display: block; margin-top: 0.65rem; }
  .park-planning-table th .park-planning-mine { margin-top: 0.45rem; color: var(--link-strong); font-weight: 800; }
  @media (max-width: 700px) {
    .park-planning-status { align-items: stretch; flex-direction: column; }
    .park-planning-table th:first-child { width: auto; }
    .park-planning-table { table-layout: auto; }
    .park-plan-details summary { padding: 0.4rem 0; }
  }
</style>
