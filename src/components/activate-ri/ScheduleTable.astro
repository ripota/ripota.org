---
import parks from "../../../public/data/activate-ri-2026/parks.json";
import {
  timelineOptions,
  uniqueSortedValues,
} from "../../lib/activate-ri/listing";
import { activationTimeZoneOptions } from "../../lib/activate-ri/time";
import type { PublicParkSummary } from "../../lib/activate-ri/types";
import { siteIdentity } from "../../data/site";

const publicParks = parks as PublicParkSummary[];
const countyOptions = uniqueSortedValues(
  publicParks.map((park) => (park.counties?.length ? park.counties : ["Unknown county"])),
);
---

<header class="schedule-print-heading" data-schedule-print-heading>
  <p class="eyebrow">Activate All RI 2026</p>
  <h1 data-schedule-print-title>Event schedule</h1>
  <p data-schedule-print-summary></p>
  <p data-schedule-print-generated></p>
  <p>Activation windows are planned estimates. Confirm live activity with official POTA spots.</p>
  <p>{siteIdentity.disclaimer}</p>
</header>

<p class="event-coverage-shortcut">
  <a href="/activate-ri-2026/parks/?coverage=needed" data-coverage-shortcut>
    Find parks that still need coverage <span data-coverage-gap-count></span><span aria-hidden="true"> →</span>
  </a>
</p>

<section class="personal-schedule-summary" data-personal-schedule-summary hidden>
  <p class="eyebrow">Your browser-local checklist</p>
  <h2 data-personal-schedule-title>Schedule for your remaining parks</h2>
  <p data-personal-schedule-copy aria-live="polite"></p>
  <p data-personal-schedule-import hidden>
    Import your official POTA Hunted Parks CSV to build a personal schedule on this device.
    <a href="/activate-ri-2026/hunter/">Open the Hunter checklist</a>
  </p>
  <details class="personal-schedule-unscheduled" data-personal-schedule-unscheduled hidden>
    <summary data-personal-schedule-unscheduled-title></summary>
    <ul data-personal-schedule-unscheduled-list></ul>
  </details>
</section>

<form class="event-filters" data-event-filters aria-label="Schedule filters">
  <label class="event-filter">
    Parks
    <select class="event-filter__control" name="schedule-scope" data-hunter-scope>
      <option value="all">All scheduled parks</option>
      <option value="remaining">My remaining parks</option>
    </select>
  </label>
  <label class="event-filter">
    Time zone
    <select class="event-filter__control" name="schedule-timezone" data-timezone>
      {activationTimeZoneOptions.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>
  </label>
  <label class="event-filter">
    Activator
    <select class="event-filter__control" data-filter="activator">
      <option value="all">Any activator</option>
    </select>
  </label>
  <label class="event-filter">
    Mode
    <select class="event-filter__control" data-filter="mode">
      <option value="all">Any mode</option>
    </select>
  </label>
  <label class="event-filter">
    Band
    <select class="event-filter__control" data-filter="band">
      <option value="all">Any band</option>
    </select>
  </label>
  <label class="event-filter">
    Timeline
    <select class="event-filter__control" data-filter="timeline">
      {timelineOptions.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
  </label>
  <label class="event-filter">
    County
    <select class="event-filter__control" data-filter="county">
      <option value="all">Any county</option>
      {countyOptions.map((county) => <option value={county}>{county}</option>)}
    </select>
  </label>
</form>

<div class="schedule-actions">
  <button class="button" data-variant="light" type="button" data-print-schedule>
    Print filtered schedule
  </button>
  <p>Printing uses the park scope, timezone, and filters shown above.</p>
</div>

<div class="event-table-wrap" data-schedule-table-wrap>
  <table class="event-table" data-filtered-table data-live-schedule data-parks={JSON.stringify(publicParks)}>
    <thead>
      <tr>
        <th scope="col">Date</th>
        <th scope="col">Time</th>
        <th scope="col">Park</th>
        <th scope="col">Activator</th>
        <th scope="col">Bands</th>
        <th scope="col">Modes</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      <tr data-live-loading>
        <td colspan="7" data-label="Schedule">Loading approved activation windows...</td>
      </tr>
      <tr data-filter-empty hidden>
        <td colspan="7" data-label="Schedule">No scheduled activation windows match these filters.</td>
      </tr>
    </tbody>
  </table>
</div>

<script>
  import type { PublicParkSummary } from "../../lib/activate-ri/types";
  import { summarizeParkCoverage } from "../../lib/activate-ri/coverage";
  import {
    hasHunterChecklistData,
    readHunterChecklistState,
    remainingHunterReferences,
  } from "../../lib/activate-ri/hunter-checklist";
  import { scheduleVisibleStops } from "../../lib/activate-ri/listing";
  import { fetchPublicActivationStops } from "../../lib/activate-ri/public-stops-client";
  import {
    formatActivationDate,
    formatActivationTimeRange,
    timeZoneOptionForValue,
  } from "../../lib/activate-ri/time";
  import { trackAnalyticsEvent } from "../../lib/analytics/client";

  document.querySelectorAll<HTMLTableElement>("[data-live-schedule]").forEach(setupLiveSchedule);

  function setupEventFilters(
    root: Element,
    table: HTMLTableElement,
    parks: PublicParkSummary[],
    stops: PublicStop[],
    scheduleAvailable: boolean,
  ): void {
    const filters = root as HTMLFormElement;
    const rows = Array.from(table?.querySelectorAll<HTMLElement>("[data-filter-row]") ?? []);
    const empty = table?.querySelector<HTMLElement>("[data-filter-empty]");
    const tableWrap = table.closest<HTMLElement>("[data-schedule-table-wrap]");
    const controls = Array.from(
      filters.querySelectorAll("[data-filter]"),
    ) as unknown as HTMLSelectElement[];
    const timezone = filters.querySelector("[data-timezone]") as HTMLSelectElement | null;
    const hunterScope = filters.querySelector("[data-hunter-scope]") as HTMLSelectElement | null;
    const printButton = document.querySelector<HTMLButtonElement>("[data-print-schedule]");
    const unscheduledDisclosure = document.querySelector<HTMLDetailsElement>("[data-personal-schedule-unscheduled]");
    let unscheduledWasOpen = false;
    let checklistAvailable = false;
    let storageAvailable = true;
    let remainingParks: PublicParkSummary[] = [];
    try {
      const state = readHunterChecklistState(localStorage, parks);
      checklistAvailable = hasHunterChecklistData(state);
      remainingParks = remainingHunterReferences(state, parks);
    } catch {
      storageAvailable = false;
    }
    const remainingIds = new Set(remainingParks.map(({ reference }) => reference));
    const remainingOption = hunterScope?.querySelector<HTMLOptionElement>('option[value="remaining"]');
    if (remainingOption) {
      remainingOption.textContent = checklistAvailable
        ? `Remaining parks (${remainingParks.length})`
        : "Import checklist first";
    }

    restoreFiltersFromUrl(controls, timezone, hunterScope);

    const applyFilters = () => {
      const values = Object.fromEntries(
        controls.map((control) => [control.dataset.filter ?? "", control.value]),
      );
      let visibleCount = 0;
      const visibleParkIds = new Set<string>();
      const useRemaining = hunterScope?.value === "remaining";
      const missingChecklist = useRemaining && !checklistAvailable;

      for (const row of rows) {
        const isVisible =
          !missingChecklist &&
          (!useRemaining || remainingIds.has(row.dataset.parkReference ?? "")) &&
          matchesList(row.dataset.modes, values.mode) &&
          matchesList(row.dataset.activator, values.activator) &&
          matchesList(row.dataset.bands, values.band) &&
          matchesTimeline(row.dataset.date, values.timeline) &&
          matchesList(row.dataset.counties, values.county);

        row.hidden = !isVisible;
        visibleCount += isVisible ? 1 : 0;
        if (isVisible && row.dataset.parkReference) {
          visibleParkIds.add(row.dataset.parkReference);
        }
      }

      if (tableWrap) tableWrap.hidden = missingChecklist;
      if (empty) {
        empty.hidden = visibleCount > 0 || rows.length === 0;
        const emptyCell = empty.querySelector<HTMLElement>("td");
        if (emptyCell) {
          emptyCell.textContent = useRemaining
            ? "No activation windows for your remaining parks match these filters."
            : "No scheduled activation windows match these filters.";
        }
      }
      renderPersonalScheduleSummary({
        checklistAvailable,
        remainingParks,
        scheduleAvailable,
        storageAvailable,
        stops,
        useRemaining,
        visibleCount,
        visibleParkCount: visibleParkIds.size,
      });
      updatePrintSummary({
        controls,
        hunterScope,
        remainingParkCount: remainingParks.length,
        timezone,
        useRemaining,
        visibleCount,
      });
      if (printButton) {
        printButton.disabled = missingChecklist || !scheduleAvailable;
      }
    };

    controls.forEach((control) => control.addEventListener("change", () => {
      applyFilters();
      const filterCategory = control.dataset.filter as
        | "activator"
        | "band"
        | "county"
        | "mode"
        | "timeline";
      void trackAnalyticsEvent("activate-ri-2026", "schedule_filter_used", {
        filterCategory,
      });
    }));
    controls.forEach((control) => control.addEventListener("change", () => {
      updateScheduleUrl(controls, timezone, hunterScope);
    }));
    hunterScope?.addEventListener("change", () => {
      applyFilters();
      updateScheduleUrl(controls, timezone, hunterScope);
    });
    timezone?.addEventListener("change", () => {
      applySelectedTime(table, timezone.value);
      updateScheduleUrl(controls, timezone, hunterScope);
      void trackAnalyticsEvent("activate-ri-2026", "schedule_filter_used", {
        filterCategory: "time_zone",
      });
    });
    const preparePrint = () => {
      const generated = document.querySelector<HTMLElement>("[data-schedule-print-generated]");
      if (generated) {
        generated.textContent = `Prepared ${new Intl.DateTimeFormat(undefined, {
          dateStyle: "medium",
          timeStyle: "short",
        }).format(new Date())}`;
      }
      if (unscheduledDisclosure && !unscheduledDisclosure.hidden) {
        unscheduledWasOpen = unscheduledDisclosure.open;
        unscheduledDisclosure.open = true;
      }
    };
    window.addEventListener("beforeprint", preparePrint);
    window.addEventListener("afterprint", () => {
      if (unscheduledDisclosure) unscheduledDisclosure.open = unscheduledWasOpen;
    });
    printButton?.addEventListener("click", () => {
      window.print();
    });
    applySelectedTime(table, timezone?.value);
    applyFilters();
    updateScheduleUrl(controls, timezone, hunterScope);
  }

  async function setupLiveSchedule(table: HTMLTableElement): Promise<void> {
    const body = table.querySelector("tbody");
    if (!body) {
      return;
    }

    let parks: PublicParkSummary[] = [];
    try {
      parks = JSON.parse(table.dataset.parks ?? "[]");
    } catch {
      parks = [];
    }

    try {
      const stops = await fetchPublicActivationStops();
      const visibleStops = scheduleVisibleStops(stops);
      const gapCount = summarizeParkCoverage(parks, stops).gaps;
      document.querySelectorAll<HTMLElement>("[data-coverage-gap-count]").forEach((count) => {
        count.textContent = `(${gapCount})`;
      });
      const filters = document.querySelector("[data-event-filters]") as HTMLFormElement | null;
      if (filters) {
        updateSelectOptions(filters, "activator", uniqueSortedValues(visibleStops.map((stop) => [stop.activatorCallsign])));
        updateSelectOptions(filters, "mode", uniqueSortedValues(visibleStops.map((stop) => stop.modes)));
        updateSelectOptions(filters, "band", uniqueSortedValues(visibleStops.map((stop) => stop.bands)));
      }
      renderLiveSchedule(body, visibleStops, parks);
      if (filters) {
        setupEventFilters(filters, table, parks, visibleStops, true);
      }
    } catch {
      renderScheduleUnavailable(body);
      const filters = document.querySelector("[data-event-filters]") as HTMLFormElement | null;
      if (filters) {
        setupEventFilters(filters, table, parks, [], false);
      }
    }
  }

  function updateSelectOptions(
    filters: HTMLFormElement,
    filterName: "activator" | "mode" | "band",
    values: string[],
  ): void {
    const control = filters.querySelector(`[data-filter="${filterName}"]`) as HTMLSelectElement | null;
    if (!control) {
      return;
    }

    const current = control.value;
    const defaultLabels = {
      activator: "Any activator",
      mode: "Any mode",
      band: "Any band",
    };
    control.replaceChildren(new Option(defaultLabels[filterName], "all"));
    for (const value of values) {
      control.appendChild(new Option(value, value));
    }
    control.value = values.includes(current) ? current : "all";
  }

  function uniqueSortedValues(values: string[][]): string[] {
    return [...new Set(values.flat().filter(Boolean))].sort((left, right) =>
      left.localeCompare(right),
    );
  }

  type PublicStop = {
    id: string;
    parkReference: string;
    plannedDate: string;
    startTime: string;
    endTime: string;
    activatorCallsign: string;
    activatorName?: string;
    bands: string[];
    modes: string[];
    publicNotes?: string;
    status: string;
  };

  function renderLiveSchedule(
    body: HTMLTableSectionElement,
    stops: PublicStop[],
    parks: Array<{ reference: string; name: string; counties?: string[] }>,
  ): void {
    const parkByReference = new Map(parks.map((park) => [park.reference, park]));
    body.replaceChildren();

    if (stops.length === 0) {
      const row = document.createElement("tr");
      const cell = document.createElement("td");
      cell.colSpan = 7;
      cell.dataset.label = "Schedule";
      cell.textContent = "Approved activation windows will appear here after organizer review.";
      row.appendChild(cell);
      body.appendChild(row);
    } else {
      body.replaceChildren(
        ...stops.map((stop, index) =>
          createScheduleRow(stop, stops, parkByReference, index),
        ),
      );
      setupActivatorPopovers(body);
    }

    const empty = document.createElement("tr");
    empty.dataset.filterEmpty = "";
    empty.hidden = true;
    const emptyCell = document.createElement("td");
    emptyCell.colSpan = 7;
    emptyCell.dataset.label = "Schedule";
    emptyCell.textContent = "No scheduled activation windows match these filters.";
    empty.appendChild(emptyCell);
    body.appendChild(empty);
  }

  function renderScheduleUnavailable(body: HTMLTableSectionElement): void {
    const row = document.createElement("tr");
    const cell = document.createElement("td");
    cell.colSpan = 7;
    cell.dataset.label = "Schedule";
    cell.textContent = "Live schedule is unavailable. Try refreshing this page.";
    row.appendChild(cell);
    body.replaceChildren(row);
  }

  function createScheduleRow(
    stop: PublicStop,
    stops: PublicStop[],
    parkByReference: Map<string, { reference: string; name: string; counties?: string[] }>,
    index: number,
  ): HTMLTableRowElement {
    const park = parkByReference.get(stop.parkReference);
    const row = document.createElement("tr");
    row.dataset.filterRow = "";
    row.dataset.bands = stop.bands.join("|");
    row.dataset.activator = stop.activatorCallsign;
    row.dataset.counties = (park?.counties?.length ? park.counties : ["Unknown county"]).join("|");
    row.dataset.date = stop.plannedDate;
    row.dataset.modes = stop.modes.join("|");
    row.dataset.parkReference = stop.parkReference;

    appendCell(row, "Date", formatActivationDate(stop));
    appendCell(row, "Time", formatActivationTimeRange(stop));
    row.dataset.startTime = stop.startTime;
    row.dataset.endTime = stop.endTime;
    row.querySelector('[data-label="Date"]')?.setAttribute("data-schedule-date", "");
    row.querySelector('[data-label="Time"]')?.setAttribute("data-schedule-time", "");

    const parkHeader = document.createElement("th");
    parkHeader.scope = "row";
    parkHeader.dataset.label = "Park";
    parkHeader.append(park?.name ?? stop.parkReference);
    const reference = document.createElement("span");
    reference.textContent = stop.parkReference;
    parkHeader.appendChild(reference);
    row.appendChild(parkHeader);

    appendActivatorCell(
      row,
      stop,
      stops.filter((candidate) => candidate.activatorCallsign === stop.activatorCallsign),
      parkByReference,
      index,
    );
    appendCell(row, "Bands", stop.bands.length > 0 ? stop.bands.join(", ") : "TBD");
    appendCell(row, "Modes", stop.modes.length > 0 ? stop.modes.join(", ") : "TBD");
    appendCell(row, "Status", statusLabel(stop.status));

    return row;
  }

  function appendCell(row: HTMLTableRowElement, label: string, text: string): void {
    const cell = document.createElement("td");
    cell.dataset.label = label;
    cell.textContent = text;
    row.appendChild(cell);
  }

  function appendActivatorCell(
    row: HTMLTableRowElement,
    stop: PublicStop,
    activatorStops: PublicStop[],
    parkByReference: Map<string, { reference: string; name: string; counties?: string[] }>,
    index: number,
  ): void {
    const cell = document.createElement("td");
    cell.dataset.label = "Activator";

    const wrapper = document.createElement("div");
    wrapper.className = "activator-popover";
    wrapper.dataset.activatorPopover = "";

    const trigger = document.createElement("button");
    trigger.className = "activator-popover__trigger";
    trigger.type = "button";
    trigger.textContent = `${stop.activatorCallsign}${stop.modes.length > 0 ? ` (${stop.modes.join(", ")})` : ""}`;
    trigger.setAttribute("aria-expanded", "false");
    trigger.setAttribute("aria-haspopup", "dialog");

    const card = document.createElement("div");
    const cardId = `activator-popover-${index + 1}`;
    card.id = cardId;
    card.className = "activator-popover__card";
    card.dataset.activatorPopoverCard = "";
    card.hidden = true;
    card.setAttribute("role", "dialog");
    card.setAttribute("aria-label", `Activation plan for ${stop.activatorCallsign}`);
    trigger.setAttribute("aria-controls", cardId);

    const identity = document.createElement("div");
    identity.className = "activator-popover__identity";
    const name = document.createElement("strong");
    name.textContent = stop.activatorName?.trim() || stop.activatorCallsign;
    identity.appendChild(name);
    if (stop.activatorName?.trim()) {
      const callsign = document.createElement("span");
      callsign.textContent = stop.activatorCallsign;
      identity.appendChild(callsign);
    }
    card.appendChild(identity);

    const qrzLink = document.createElement("a");
    qrzLink.href = `https://www.qrz.com/db/${encodeURIComponent(stop.activatorCallsign)}`;
    qrzLink.target = "_blank";
    qrzLink.rel = "noreferrer";
    qrzLink.textContent = "View on QRZ ↗";
    card.appendChild(qrzLink);

    const schedule = document.createElement("ul");
    schedule.className = "activator-popover__schedule";
    for (const activation of activatorStops) {
      schedule.appendChild(createActivatorScheduleItem(activation, parkByReference));
    }
    card.appendChild(schedule);

    const scheduleLink = document.createElement("a");
    scheduleLink.dataset.activatorScheduleLink = stop.activatorCallsign;
    scheduleLink.textContent = `View full schedule for ${stop.activatorCallsign}`;
    card.appendChild(scheduleLink);

    wrapper.appendChild(trigger);
    wrapper.appendChild(card);
    cell.appendChild(wrapper);
    row.appendChild(cell);
  }

  function createActivatorScheduleItem(
    stop: PublicStop,
    parkByReference: Map<string, { reference: string; name: string; counties?: string[] }>,
  ): HTMLLIElement {
    const item = document.createElement("li");
    item.dataset.activatorScheduleStop = "";
    item.dataset.date = stop.plannedDate;
    item.dataset.startTime = stop.startTime;
    item.dataset.endTime = stop.endTime;

    const park = parkByReference.get(stop.parkReference);
    const heading = document.createElement("strong");
    heading.textContent = `${park?.name ?? stop.parkReference} (${stop.parkReference})`;
    item.appendChild(heading);

    const dateTime = document.createElement("span");
    const date = document.createElement("span");
    date.dataset.activatorScheduleDate = "";
    date.textContent = formatActivationDate(stop);
    const time = document.createElement("span");
    time.dataset.activatorScheduleTime = "";
    time.textContent = formatActivationTimeRange(stop);
    dateTime.appendChild(date);
    dateTime.appendChild(document.createTextNode(" · "));
    dateTime.appendChild(time);
    item.appendChild(dateTime);

    const operatingPlan = document.createElement("span");
    operatingPlan.textContent = `${stop.bands.length ? stop.bands.join(", ") : "TBD"} / ${stop.modes.length ? stop.modes.join(", ") : "TBD"} · ${statusLabel(stop.status)}`;
    item.appendChild(operatingPlan);

    if (stop.publicNotes?.trim()) {
      const notes = document.createElement("span");
      notes.textContent = stop.publicNotes;
      item.appendChild(notes);
    }

    return item;
  }

  function applySelectedTime(table: Element | null | undefined, value?: string): void {
    const option = timeZoneOptionForValue(value);

    table?.querySelectorAll<HTMLTableRowElement>("[data-filter-row]").forEach((row) => {
      const plannedDate = row.dataset.date;
      const startTime = row.dataset.startTime;
      const endTime = row.dataset.endTime;
      if (!plannedDate || !startTime || !endTime) {
        return;
      }

      const dateCell = row.querySelector<HTMLElement>("[data-schedule-date]");
      const timeCell = row.querySelector<HTMLElement>("[data-schedule-time]");
      if (dateCell) {
        dateCell.textContent = formatActivationDate({ plannedDate, startTime }, option);
      }
      if (timeCell) {
        timeCell.textContent = formatActivationTimeRange({ plannedDate, startTime, endTime }, option);
      }
    });

    table?.querySelectorAll<HTMLElement>("[data-activator-schedule-stop]").forEach((item) => {
      const plannedDate = item.dataset.date;
      const startTime = item.dataset.startTime;
      const endTime = item.dataset.endTime;
      if (!plannedDate || !startTime || !endTime) {
        return;
      }
      item.querySelector<HTMLElement>("[data-activator-schedule-date]")?.replaceChildren(
        formatActivationDate({ plannedDate, startTime }, option),
      );
      item.querySelector<HTMLElement>("[data-activator-schedule-time]")?.replaceChildren(
        formatActivationTimeRange({ plannedDate, startTime, endTime }, option),
      );
    });

    table?.querySelectorAll<HTMLAnchorElement>("[data-activator-schedule-link]").forEach((link) => {
      const callsign = link.dataset.activatorScheduleLink;
      if (!callsign) {
        return;
      }
      const params = new URLSearchParams({ activator: callsign });
      if (option.value !== "eastern") {
        params.set("timezone", option.value);
      }
      link.href = `/activate-ri-2026/schedule/?${params.toString()}`;
    });
  }

  function setupActivatorPopovers(root: Element): void {
    root.querySelectorAll<HTMLElement>("[data-activator-popover]").forEach((wrapper) => {
      const trigger = wrapper.querySelector<HTMLButtonElement>(".activator-popover__trigger");
      if (!trigger) {
        return;
      }

      wrapper.addEventListener("mouseenter", () => setActivatorPopoverOpen(wrapper, true));
      wrapper.addEventListener("mouseleave", () => {
        if (wrapper.dataset.pinned !== "true" && !wrapper.contains(document.activeElement)) {
          setActivatorPopoverOpen(wrapper, false);
        }
      });
      trigger.addEventListener("focus", () => setActivatorPopoverOpen(wrapper, true));
      trigger.addEventListener("click", () => {
        const pinned = wrapper.dataset.pinned === "true";
        wrapper.dataset.pinned = String(!pinned);
        setActivatorPopoverOpen(wrapper, !pinned);
        if (!pinned) {
          void trackAnalyticsEvent("activate-ri-2026", "schedule_detail_opened");
        }
      });
      wrapper.addEventListener("focusout", (event) => {
        const next = event.relatedTarget;
        if (
          wrapper.dataset.pinned !== "true" &&
          (!(next instanceof Node) || !wrapper.contains(next))
        ) {
          setActivatorPopoverOpen(wrapper, false);
        }
      });
      wrapper.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          wrapper.dataset.pinned = "false";
          trigger.focus();
          setActivatorPopoverOpen(wrapper, false);
        }
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) {
        return;
      }
      root.querySelectorAll<HTMLElement>("[data-activator-popover]").forEach((wrapper) => {
        if (!wrapper.contains(target)) {
          wrapper.dataset.pinned = "false";
          setActivatorPopoverOpen(wrapper, false);
        }
      });
    });
    window.addEventListener("resize", () => {
      root.querySelectorAll<HTMLElement>("[data-activator-popover]").forEach((wrapper) => {
        const card = wrapper.querySelector<HTMLElement>("[data-activator-popover-card]");
        if (!card?.hidden) {
          positionActivatorPopover(wrapper);
        }
      });
    });
  }

  function setActivatorPopoverOpen(wrapper: HTMLElement, isOpen: boolean): void {
    const trigger = wrapper.querySelector<HTMLButtonElement>(".activator-popover__trigger");
    const card = wrapper.querySelector<HTMLElement>("[data-activator-popover-card]");
    if (!trigger || !card) {
      return;
    }

    if (isOpen) {
      document.querySelectorAll<HTMLElement>("[data-activator-popover]").forEach((candidate) => {
        if (candidate !== wrapper) {
          candidate.dataset.pinned = "false";
          setActivatorPopoverOpen(candidate, false);
        }
      });
    }
    card.hidden = !isOpen;
    trigger.setAttribute("aria-expanded", String(isOpen));
    if (isOpen) {
      positionActivatorPopover(wrapper);
    }
  }

  function positionActivatorPopover(wrapper: HTMLElement): void {
    const trigger = wrapper.querySelector<HTMLElement>(".activator-popover__trigger");
    const card = wrapper.querySelector<HTMLElement>("[data-activator-popover-card]");
    if (!trigger || !card) {
      return;
    }

    const margin = 12;
    const triggerRect = trigger.getBoundingClientRect();
    const cardRect = card.getBoundingClientRect();
    const left = Math.min(
      Math.max(margin, triggerRect.left),
      Math.max(margin, window.innerWidth - cardRect.width - margin),
    );
    const below = triggerRect.bottom + 8;
    const top = below + cardRect.height <= window.innerHeight - margin
      ? below
      : Math.max(margin, triggerRect.top - cardRect.height - 8);
    card.style.left = `${left}px`;
    card.style.top = `${top}px`;
  }

  function statusLabel(status: string): string {
    const labels: Record<string, string> = {
      "pending-review": "Pending review",
      scheduled: "Scheduled",
      delayed: "Delayed",
      cancelled: "Cancelled",
      completed: "Completed",
    };

    return labels[status] ?? status;
  }

  type PersonalScheduleSummary = {
    checklistAvailable: boolean;
    remainingParks: PublicParkSummary[];
    scheduleAvailable: boolean;
    storageAvailable: boolean;
    stops: PublicStop[];
    useRemaining: boolean;
    visibleCount: number;
    visibleParkCount: number;
  };

  type PrintSummary = {
    controls: HTMLSelectElement[];
    hunterScope: HTMLSelectElement | null;
    remainingParkCount: number;
    timezone: HTMLSelectElement | null;
    useRemaining: boolean;
    visibleCount: number;
  };

  function updatePrintSummary({
    controls,
    hunterScope,
    remainingParkCount,
    timezone,
    useRemaining,
    visibleCount,
  }: PrintSummary): void {
    const title = document.querySelector<HTMLElement>("[data-schedule-print-title]");
    const summary = document.querySelector<HTMLElement>("[data-schedule-print-summary]");
    if (title) {
      title.textContent = useRemaining ? "My remaining-parks schedule" : "Event schedule";
    }
    if (!summary) return;

    const activeFilters = controls
      .filter(({ value }) => value !== "all")
      .map((control) => control.selectedOptions[0]?.textContent?.trim())
      .filter((label): label is string => Boolean(label));
    const scopeLabel = useRemaining
      ? `${remainingParkCount} remaining park${remainingParkCount === 1 ? "" : "s"}`
      : hunterScope?.selectedOptions[0]?.textContent?.trim() ?? "All scheduled parks";
    const timezoneLabel = timezone?.selectedOptions[0]?.textContent?.trim();
    const details = [scopeLabel, timezoneLabel, ...activeFilters].filter(Boolean).join(" · ");
    summary.textContent = `${visibleCount} matching activation window${visibleCount === 1 ? "" : "s"} · ${details}`;
  }

  function renderPersonalScheduleSummary({
    checklistAvailable,
    remainingParks,
    scheduleAvailable,
    storageAvailable,
    stops,
    useRemaining,
    visibleCount,
    visibleParkCount,
  }: PersonalScheduleSummary): void {
    const summary = document.querySelector<HTMLElement>("[data-personal-schedule-summary]");
    if (!summary) return;
    summary.hidden = !useRemaining;
    if (!useRemaining) return;

    const title = summary.querySelector<HTMLElement>("[data-personal-schedule-title]");
    const copy = summary.querySelector<HTMLElement>("[data-personal-schedule-copy]");
    const importPrompt = summary.querySelector<HTMLElement>("[data-personal-schedule-import]");
    const unscheduled = summary.querySelector<HTMLElement>("[data-personal-schedule-unscheduled]");
    const unscheduledTitle = summary.querySelector<HTMLElement>("[data-personal-schedule-unscheduled-title]");
    const unscheduledList = summary.querySelector<HTMLUListElement>("[data-personal-schedule-unscheduled-list]");

    if (!checklistAvailable) {
      if (title) title.textContent = "Build your personal schedule";
      if (copy) {
        copy.textContent = storageAvailable
          ? "No Hunter checklist has been saved in this browser yet."
          : "Browser storage is unavailable, so a personal checklist cannot be loaded on this device.";
      }
      if (importPrompt) importPrompt.hidden = false;
      if (unscheduled) unscheduled.hidden = true;
      return;
    }

    if (importPrompt) importPrompt.hidden = true;
    if (title) title.textContent = "Schedule for your remaining parks";
    if (!scheduleAvailable) {
      if (copy) copy.textContent = "The live schedule is temporarily unavailable. Try refreshing this page.";
      if (unscheduled) unscheduled.hidden = true;
      return;
    }

    if (copy) {
      copy.textContent = `${visibleCount} activation window${visibleCount === 1 ? "" : "s"} covering ${visibleParkCount} of your ${remainingParks.length} remaining park${remainingParks.length === 1 ? "" : "s"} ${visibleCount === 1 ? "matches" : "match"} the current filters.`;
    }
    const remainingIds = new Set(remainingParks.map(({ reference }) => reference));
    const scheduledIds = new Set(
      stops
        .filter(({ parkReference }) => remainingIds.has(parkReference))
        .map(({ parkReference }) => parkReference),
    );
    const unscheduledParks = remainingParks.filter(({ reference }) => !scheduledIds.has(reference));
    if (unscheduled) unscheduled.hidden = unscheduledParks.length === 0;
    if (unscheduledTitle) {
      unscheduledTitle.textContent = `Not currently scheduled (${unscheduledParks.length})`;
    }
    unscheduledList?.replaceChildren(...unscheduledParks.map((park) => {
      const item = document.createElement("li");
      const reference = document.createElement("strong");
      reference.textContent = park.reference;
      item.appendChild(reference);
      item.append(` ${park.name}`);
      return item;
    }));
  }

  function restoreFiltersFromUrl(
    controls: HTMLSelectElement[],
    timezone: HTMLSelectElement | null,
    hunterScope: HTMLSelectElement | null,
  ): void {
    const params = new URL(window.location.href).searchParams;
    for (const control of controls) {
      const key = control.dataset.filter;
      let requested = key ? params.get(key) : null;
      if (key === "activator") {
        requested = requested?.toUpperCase() ?? null;
      }
      control.value = requested && hasOption(control, requested) ? requested : "all";
    }

    const requestedTimezone = params.get("timezone");
    if (timezone) {
      timezone.value = requestedTimezone && hasOption(timezone, requestedTimezone)
        ? requestedTimezone
        : "eastern";
    }
    if (hunterScope) {
      hunterScope.value = params.get("scope") === "remaining" ? "remaining" : "all";
    }
  }

  function updateScheduleUrl(
    controls: HTMLSelectElement[],
    timezone: HTMLSelectElement | null,
    hunterScope: HTMLSelectElement | null,
  ): void {
    const url = new URL(window.location.href);
    for (const control of controls) {
      const key = control.dataset.filter;
      if (!key) {
        continue;
      }
      if (control.value && control.value !== "all") {
        url.searchParams.set(key, control.value);
      } else {
        url.searchParams.delete(key);
      }
    }

    if (timezone?.value && timezone.value !== "eastern") {
      url.searchParams.set("timezone", timezone.value);
    } else {
      url.searchParams.delete("timezone");
    }
    if (hunterScope?.value === "remaining") {
      url.searchParams.set("scope", "remaining");
    } else {
      url.searchParams.delete("scope");
    }
    window.history.replaceState({}, "", url);
  }

  function hasOption(control: HTMLSelectElement, value: string): boolean {
    return Array.from(control.options).some((option) => option.value === value);
  }

  function matchesList(value: string | undefined, filter: string | undefined): boolean {
    return !filter || filter === "all" || String(value ?? "").split("|").includes(filter);
  }

  function matchesTimeline(date: string | undefined, filter: string | undefined): boolean {
    if (!filter || filter === "all") {
      return true;
    }

    if (filter === "soft-start") {
      return date === "2026-09-10";
    }

    if (filter === "main") {
      return date === "2026-09-11" || date === "2026-09-12" || date === "2026-09-13";
    }

    return date === filter;
  }
</script>
