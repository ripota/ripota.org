---
import parks from "../../../public/data/activate-ri-2026/parks.json";
import ReferenceMap from "../ReferenceMap.astro";
import { activateRi2026Event } from "../../data/activate-ri-2026/event";
import type { PublicParkSummary } from "../../lib/activate-ri/types";

export interface Props { results?: boolean; }
const { results: showPotaResults = false } = Astro.props;
const phase = showPotaResults ? "event-live" : activateRi2026Event.phase;
const ctas = activateRi2026Event.phaseCtas[phase];
const titleId = showPotaResults ? "event-results-title" : "event-title";
const dateRangeLabel = formatDateRange(
  activateRi2026Event.mainStartDate,
  activateRi2026Event.mainEndDate,
);
const softStartLabel = formatMonthDay(activateRi2026Event.softStartDate);
const publicParks = parks as PublicParkSummary[];

function parseEventDate(date: string) {
  const [year, month, day] = date.split("-").map(Number);
  return { year, month, day, value: new Date(Date.UTC(year, month - 1, day)) };
}

function formatMonthDay(date: string) {
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(parseEventDate(date).value);
}

function formatDateRange(startDate: string, endDate: string) {
  const start = parseEventDate(startDate);
  const end = parseEventDate(endDate);
  const startMonth = formatMonthDay(startDate).replace(` ${start.day}`, "");
  const endMonthDay = formatMonthDay(endDate);

  if (start.year === end.year && start.month === end.month) {
    return `${startMonth} ${start.day}-${end.day}, ${start.year}`;
  }

  if (start.year === end.year) {
    return `${formatMonthDay(startDate)}-${endMonthDay}, ${start.year}`;
  }

  return `${formatMonthDay(startDate)}, ${start.year}-${endMonthDay}, ${end.year}`;
}
---

<section class="event-hero" aria-labelledby={titleId} data-share-card-capture>
  <div class="container event-hero__inner">
    <div class="event-hero__content">
      <p class="eyebrow event-hero__date">{dateRangeLabel}</p>
      <h1 id={titleId}>Activate All RI</h1>
      <p class="event-hero__copy">
        Help the Rhode Island POTA community cover all {activateRi2026Event.goalParkCount}
        Rhode Island references during one coordinated weekend. A soft start is
        planned for {softStartLabel}.
      </p>
      <dl
        class="event-hero__stats"
        aria-label="Activate All RI coverage progress"
        data-live-hero-coverage
        data-phase={phase}
        data-parks={JSON.stringify(publicParks)}
      >
        <div>
          <dt data-hero-primary-label>{showPotaResults ? "Confirmed by POTA" : "Parks scheduled"}</dt>
          <dd data-hero-scheduled>Loading...</dd>
        </div>
        <div>
          <dt data-hero-secondary-label>{showPotaResults ? "Activity observed" : "Coverage gaps"}</dt>
          <dd data-hero-gaps>Loading...</dd>
        </div>
        {showPotaResults && (
          <div>
            <dt>Without confirmation</dt>
            <dd data-hero-without-confirmation>Loading...</dd>
          </div>
        )}
      </dl>
      {showPotaResults && (
        <div class="event-hero__progress">
          <progress max={activateRi2026Event.goalParkCount} value="0" data-hero-pota-progress>
            0 of {activateRi2026Event.goalParkCount}
          </progress>
          <p data-hero-pota-updated aria-live="polite">Loading the unofficial RI POTA evidence summary…</p>
          <a href="/activate-ri-2026/parks/">See all 61 parks and evidence <span aria-hidden="true">→</span></a>
        </div>
      )}
      <div class="button-row" aria-label="Event actions">
        <a class="button" data-variant="primary" href={ctas.primary.href} data-analytics-event="event_cta_clicked" data-analytics-feature="event_hero" data-analytics-placement="hero" data-analytics-action="primary">
          {ctas.primary.label}
        </a>
        <a class="button" data-variant="light" href={ctas.secondary.href} data-analytics-event="event_cta_clicked" data-analytics-feature="event_hero" data-analytics-placement="hero" data-analytics-action="secondary">
          {ctas.secondary.label}
        </a>
      </div>
    </div>
    <div class="event-hero__map">
      <ReferenceMap
        id={showPotaResults ? "activate-ri-hero-results-map" : "activate-ri-hero-coverage-map"}
        variant="coverage"
        title="Map of Activate All RI 2026 coverage"
        caption=""
        phaseFocus="volunteer"
        legendPlacement="overlay"
        showBoundaries={false}
        resultsMode={showPotaResults}
      />
    </div>
  </div>
</section>

<script>
  import { summarizeParkCoverage } from "../../lib/activate-ri/coverage";
  import { fetchPublicActivationStops } from "../../lib/activate-ri/public-stops-client";
  import { potaParkStatusStore } from "../../lib/activate-ri/pota-status-store";
  import { subscribeEventPhase } from "../../lib/activate-ri/event-phase";
  import { activateRi2026Event } from "../../data/activate-ri-2026/event";
  import type { PublicParkSummary } from "../../lib/activate-ri/types";

  function setHeroCoverageText(
    summary: Element,
    scheduled: string,
    gaps: string,
  ): void {
    const scheduledValue = summary.querySelector("[data-hero-scheduled]");
    const gapsValue = summary.querySelector("[data-hero-gaps]");

    if (scheduledValue) {
      scheduledValue.textContent = scheduled;
    }

    if (gapsValue) {
      gapsValue.textContent = gaps;
    }
  }

  async function setupLiveHeroCoverage(summary: HTMLElement): Promise<void> {
    let phase = summary.dataset.phase;
    if (phase === "event-live" || phase === "post-event") {
      potaParkStatusStore.subscribe((state) => {
        if (state.status === "ready") {
          const { snapshot } = state;
          setHeroCoverageText(
            summary,
            `${snapshot.summary.confirmed} / ${snapshot.summary.total}`,
            String(snapshot.summary.observedNotConfirmed),
          );
          summary.querySelector("[data-hero-without-confirmation]")?.replaceChildren(
            String(snapshot.summary.withoutConfirmation),
          );
          const progress = document.querySelector("[data-hero-pota-progress]") as HTMLProgressElement | null;
          if (progress) {
            progress.max = snapshot.summary.total;
            progress.value = snapshot.summary.confirmed;
            progress.textContent = `${snapshot.summary.confirmed} of ${snapshot.summary.total}`;
          }
          const updated = document.querySelector("[data-hero-pota-updated]");
          const asOf = snapshot.lastPotaSyncAt
            ? new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(new Date(snapshot.lastPotaSyncAt)) + " UTC"
            : "not yet reconciled";
          updated?.replaceChildren(
            snapshot.warning ?? `${phase === "post-event" ? "Provisional results" : "Evidence"} as of ${asOf}.`,
          );
        } else if (state.status === "unavailable") {
          setHeroCoverageText(summary, "Unavailable", "Unavailable");
          document.querySelector("[data-hero-pota-updated]")?.replaceChildren(
            "Persisted POTA evidence is temporarily unavailable. Try again shortly.",
          );
        }
      });
      subscribeEventPhase((nextPhase) => {
        phase = nextPhase;
        summary.dataset.phase = phase;
        const ctas = activateRi2026Event.phaseCtas[nextPhase];
        for (const action of ["primary", "secondary"] as const) {
          const link = summary.closest("section")?.querySelector<HTMLAnchorElement>(`[data-analytics-action="${action}"]`);
          if (link) { link.href = ctas[action].href; link.textContent = ctas[action].label; }
        }
        if (phase === "event-live" || phase === "post-event") potaParkStatusStore.start();
      });
      return;
    }
    try {
      const parks = JSON.parse(summary.dataset.parks ?? "[]") as PublicParkSummary[];
      const stops = await fetchPublicActivationStops();

      const coverageSummary = summarizeParkCoverage(parks, stops);
      setHeroCoverageText(
        summary,
        `${coverageSummary.scheduled} / ${coverageSummary.total}`,
        `${coverageSummary.gaps}`,
      );
    } catch {
      setHeroCoverageText(summary, "Unavailable", "Unavailable");
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-live-hero-coverage]")
    .forEach((summary) => {
      void setupLiveHeroCoverage(summary);
    });
</script>
