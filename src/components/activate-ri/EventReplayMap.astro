---
import "leaflet/dist/leaflet.css";
import parks from "../../../public/data/activate-ri-2026/parks.json";
import { displayReferences } from "@ripota/parks/display";
import { buildReferenceMapItems } from "../../lib/reference-map";

const items = buildReferenceMapItems({ references: parks, displayReferences })
  .filter(item => item.marker)
  .map(({ reference, name, marker }) => ({ reference, name, ...marker }));
---

<figure class="event-replay" data-event-replay data-state="loading" aria-label="Replay of Rhode Island park activity during Activate All RI">
  <header class="event-replay__heading">
    <div>
      <p class="event-replay__eyebrow">The weekend, replayed</p>
      <h2>Watch Rhode Island light up.</h2>
    </div>
    <button type="button" class="event-replay__badge" data-replay-badge disabled>▶ Play</button>
  </header>
  <a class="event-replay__skip" href="#event-replay-time">Skip to replay controls</a>
  <div class="event-replay__map" data-replay-map aria-label="Rhode Island parks. Select a park to pause and explore its reported activity."></div>
  <div class="event-replay__deck">
    <div class="event-replay__readout">
      <div>
        <span class="event-replay__label" data-replay-phase>Loading the weekend</span>
        <time data-replay-clock>Sep 10, 00:00 UTC</time>
      </div>
      <div class="event-replay__count">
        <span class="event-replay__label" data-replay-count-label>Parks heard so far</span>
        <span><strong data-replay-count>—</strong><span class="event-replay__total"> / {parks.length}</span></span>
      </div>
    </div>
    <div class="event-replay__timeline">
      <div class="event-replay__activity" data-replay-activity aria-hidden="true"></div>
      <label class="sr-only" for="event-replay-time">Event replay time</label>
      <input id="event-replay-time" data-replay-scrubber type="range" min="0" max="1000" step="1" value="0" disabled />
      <div class="event-replay__days" aria-hidden="true"><span>Sep 10</span><span>Sep 11</span><span>Sep 12</span><span>Sep 13</span><span>End</span></div>
    </div>
    <div class="event-replay__controls">
      <button type="button" class="event-replay__play" data-replay-play disabled><span data-replay-play-icon aria-hidden="true">▶</span> <span data-replay-play-label>Play weekend</span></button>
      <button type="button" data-replay-end disabled>See final map <span aria-hidden="true">→</span></button>
      <button type="button" data-replay-retry hidden>Try again</button>
    </div>
    <p class="event-replay__detail" data-replay-detail>Loading archived park activity…</p>
    <p class="event-replay__key"><span class="event-replay__key-dot" aria-hidden="true"></span> Reported on air <span class="event-replay__key-muted" aria-hidden="true">○</span> Not yet heard</p>
  </div>
  <figcaption>POTA spot reports, September 10–13 UTC, including early activations. Timing shows reported activity; official activation credit follows submitted logs.<span class="event-replay__notice" data-replay-notice hidden></span></figcaption>
  <p class="sr-only" data-replay-announcement role="status" aria-live="polite"></p>
  <script is:inline type="application/json" data-replay-parks set:html={JSON.stringify({ items })} />
</figure>

<script>
  import { setupEventReplay } from "../../lib/activate-ri/event-replay-map";
  document.querySelectorAll<HTMLElement>("[data-event-replay]").forEach(setupEventReplay);
</script>

<style is:global>
  .event-replay { --replay-gold: #f6c967; position: relative; margin: 0; min-width: 0; overflow: hidden; border: 1px solid #63817a; border-radius: 16px; background: #142c2a; color: #fffaf0; box-shadow: 0 24px 70px #0004; }
  .event-replay__skip { position: absolute; z-index: 1000; top: -10rem; left: 1rem; padding: .7rem 1rem; background: #fffaf0; color: #18312f; border-radius: 6px; }
  .event-replay__skip:focus { top: 4.5rem; }
  .event-replay__heading { display: flex; justify-content: space-between; align-items: center; gap: .75rem; padding: 1rem 1.25rem; }
  .event-replay__eyebrow { color: var(--replay-gold); font-size: .68rem; font-weight: 850; letter-spacing: .16em; text-transform: uppercase; margin: 0 0 .2rem; }
  .event-replay__heading > div { min-width: 0; }
  .event-replay__heading h2 { max-width: none; color: #fffaf0; font-size: clamp(1rem, 1.6vw, 1.2rem); line-height: 1.3; margin: 0; }
  .event-replay__badge { flex-shrink: 0; min-height: 36px; min-width: 75px; border: 1px solid #698079; border-radius: 20px; padding: .2rem .55rem; background: transparent; color: #e1ebe5; cursor: pointer; font-size: .7rem; font-weight: 800; }
  .event-replay__badge:hover { background: #ffffff15; }
  .event-replay__badge:disabled { opacity: .5; cursor: default; }
  .event-replay__map { height: clamp(315px, 31vw, 415px); background: #263f3d; isolation: isolate; }
  .event-replay__map .leaflet-tile-pane { filter: grayscale(.95) invert(1) hue-rotate(145deg) brightness(.7) contrast(.85); }
  .event-replay__map .leaflet-control-attribution { max-width: calc(100% - 18px); background: #142c2aee; color: #b8ccc4; font-size: 9px; }
  .event-replay__map .leaflet-control-attribution a { color: #d9e6e0; }
  .event-replay__map .leaflet-control-zoom { border: 1px solid #607b74; box-shadow: none; }
  .event-replay__map .leaflet-control-zoom a { background: #1c3935; color: #fffaf0; border-color: #607b74; }
  .event-replay__map .leaflet-popup-content-wrapper, .event-replay__map .leaflet-popup-tip { background: #fffaf0; color: #18312f; }
  .event-replay__map .leaflet-popup-content { line-height: 1.5; }
  .event-replay__map .leaflet-popup-content p { margin: .3rem 0; }
  .event-replay__map .leaflet-popup-content a { color: #0b5d70; text-decoration: underline; }
  .event-replay__marker { background: transparent; border: 0; }
  .event-replay__dot { display: block; position: absolute; width: 11px; height: 11px; left: 10px; top: 10px; border: 1.5px solid #b0c6bc; border-radius: 50%; background: #2b4744; transition: background-color .25s, border-color .25s, box-shadow .25s; }
  .event-replay__marker[data-heard="true"] .event-replay__dot { background: #f6c967; border-color: #fff0bd; box-shadow: 0 0 9px #f6c96770; }
  .event-replay__marker[data-pulse] .event-replay__dot::after { content: ""; position: absolute; inset: -2px; border: 2px solid #f6c967; border-radius: 50%; animation: replay-signal 1.5s ease-out forwards; }
  .event-replay__marker[data-pulse="again"] .event-replay__dot::after { animation-duration: 1s; border-width: 1px; }
  .event-replay__marker:focus-visible { outline: 2px solid #fffaf0; outline-offset: 2px; border-radius: 50%; }
  @keyframes replay-signal { from { transform: scale(1); opacity: 1; } to { transform: scale(5); opacity: 0; } }
  .event-replay__deck { position: relative; border-top: 1px solid #547069; padding: 1rem 1.25rem .85rem; background: linear-gradient(120deg, #1c3833, #122a28); }
  .event-replay__readout { display: flex; align-items: flex-end; justify-content: space-between; gap: .5rem; margin-bottom: .75rem; font-variant-numeric: tabular-nums; }
  .event-replay__label { display: block; color: #c0d0c8; font-size: .7rem; font-weight: 750; letter-spacing: .04em; text-transform: uppercase; }
  .event-replay__readout time { display: block; color: var(--replay-gold); font-size: clamp(.9rem, 1.6vw, 1.15rem); font-weight: 750; margin-top: .2rem; white-space: nowrap; }
  .event-replay__count { text-align: right; }
  .event-replay__count strong { font-size: 1.7rem; line-height: 1; font-weight: 800; }
  .event-replay__total { color: #c0d0c8; font-size: .9rem; }
  .event-replay__activity { height: 28px; display: flex; align-items: flex-end; gap: 2px; }
  .event-replay__activity span { flex: 1; min-width: 0; border-radius: 2px 2px 0 0; background: #55726a; }
  .event-replay__activity span[data-past="true"] { background: var(--replay-gold); }
  .event-replay__timeline input { display: block; width: 100%; height: 22px; margin: 0; cursor: pointer; accent-color: var(--replay-gold); }
  .event-replay__days { display: grid; grid-template-columns: repeat(4, 1fr) 0; color: #c0d0c8; font-size: .65rem; font-variant-numeric: tabular-nums; }
  .event-replay__days span:last-child { justify-self: end; }
  .event-replay__controls { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: .85rem 0 .6rem; }
  .event-replay__controls button { border: 1px solid transparent; border-radius: 6px; min-height: 40px; padding: .4rem .75rem; background: transparent; color: #fffaf0; cursor: pointer; font-size: .78rem; font-weight: 750; }
  .event-replay__controls button:hover { background: #ffffff15; }
  .event-replay__controls button:disabled { opacity: .45; cursor: default; }
  .event-replay__controls .event-replay__play { background: var(--replay-gold); color: #192e28; min-width: 9rem; }
  .event-replay__controls .event-replay__play:hover { background: #ffdb8c; }
  .event-replay__detail { margin: 0; min-height: 2.8em; color: #fffaf0; font-size: .75rem; line-height: 1.4; overflow-wrap: anywhere; }
  .event-replay__notice { display: block; margin-top: .2rem; }
  .event-replay__key { display: flex; gap: .35rem; align-items: center; flex-wrap: wrap; color: #c0d0c8; font-size: .65rem; margin: .5rem 0 0; }
  .event-replay__key-dot { width: 7px; height: 7px; background: var(--replay-gold); border-radius: 50%; }
  .event-replay__key-muted { font-size: 1rem; line-height: 1; margin-left: .5rem; }
  .event-replay figcaption { border-top: 1px solid #476259; padding: .7rem 1.25rem; color: #c0d0c8; font-size: .7rem; line-height: 1.5; }
  .event-replay [hidden] { display: none !important; }
  @media (max-width: 480px) {
    .event-replay__heading, .event-replay__deck { padding-left: .85rem; padding-right: .85rem; }
    .event-replay__heading { align-items: flex-start; }
    .event-replay__badge { min-height: 44px; }
    .event-replay__map { height: 350px; }
    .event-replay__controls button { min-height: 44px; }
    .event-replay__timeline input { height: 32px; }
    .event-replay__label { font-size: .7rem; letter-spacing: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-replay__dot { transition: none; }
    .event-replay__marker[data-pulse] .event-replay__dot::after { animation: none; display: none; }
  }
</style>
