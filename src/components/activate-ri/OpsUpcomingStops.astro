<section class="ops-card ops-stops-card" aria-labelledby="ops-stops-title">
  <details class="ops-stops-disclosure" data-ops-stops-disclosure open>
    <summary>
      <span>
        <span class="eyebrow">Quick field updates</span>
        <span class="ops-stops-disclosure__title" id="ops-stops-title">My stops</span>
      </span>
      <span class="ops-stops-disclosure__action">View</span>
    </summary>
    <div class="ops-stops-disclosure__body">
      <div class="ops-stops-card__toolbar">
        <p>Tap an action to prepare a message with the stop already selected.</p>
        <a href="/activate-ri-2026/activators/plan/">Edit plan</a>
      </div>
      <div class="ops-stops" data-ops-stops>
        <p class="ops-empty">Loading your upcoming stops…</p>
      </div>
    </div>
  </details>
</section>

<script>
  const disclosure = document.querySelector<HTMLDetailsElement>("[data-ops-stops-disclosure]");
  if (disclosure && window.matchMedia("(max-width: 560px)").matches) {
    disclosure.open = false;
  }
</script>
