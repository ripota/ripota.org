---
import { formatMediaBytes, mediaAccept, mediaLimits, mediaMetadataLimits, mediaUsageNoticeText } from "../../lib/activate-ri/media";
import { mediaParks } from "../../lib/activate-ri/media-parks";

interface Props { organizer?: boolean; publicGallery?: boolean }
const { organizer = false, publicGallery = false } = Astro.props;
const personal = !organizer && !publicGallery;
const prefix = organizer ? "organizer" : publicGallery ? "public" : "activator";
const Heading = organizer ? "h2" : "h1";
---

<div class="media-workspace" data-media-workspace data-media-scope={organizer ? "admin" : publicGallery ? "public" : "activator"}>
  <header class="media-workspace__header">
    <div>
      <p class="eyebrow">From the field</p>
      <Heading id={`${prefix}-media-title`}>{personal ? "My media" : "Photos & videos"}</Heading>
      <p class="lead">{personal ? "Share your activation and manage your photos and videos." : "The places, people, and moments behind our activations."}</p>
    </div>
    <div class="media-workspace__actions">
      {personal && <a href="/activate-ri-2026/media/">View public gallery</a>}
      {personal && <button class="button" data-variant="primary" type="button" data-media-open-upload>Upload photos & videos</button>}
      {publicGallery && <a class="button" data-variant="primary" href="/activate-ri-2026/activator/media/">Upload & manage my media</a>}
    </div>
  </header>

  <section class="media-library" aria-label="Media gallery">
    <div class="media-library__toolbar">
      {publicGallery && (
        <div class="media-filters">
          <div class="media-park-field media-filter-park">
            <label for="public-media-park">Park</label>
            <select id="public-media-park" class="media-park-select" data-media-filter-park>
              <option value="">All parks</option>
              <option value="general">General — no park</option>
              {mediaParks.map((park) => <option value={park.reference}>{park.reference} — {park.name}</option>)}
            </select>
          </div>
          <div class="media-scope" role="group" aria-label="Media type">
            <button type="button" data-media-kind="" aria-pressed="true">All</button>
            <button type="button" data-media-kind="photo" aria-pressed="false">Photos</button>
            <button type="button" data-media-kind="video" aria-pressed="false">Videos</button>
          </div>
          <button class="button" data-variant="light" type="button" data-media-filter-clear hidden>Clear filters</button>
        </div>
      )}
      <button class="button" data-variant="light" type="button" data-media-refresh>Refresh files</button>
    </div>
    <p class="form-status" data-media-status role="status" aria-live="polite">Loading photos and videos…</p>
    <div class="media-empty" data-media-empty hidden>
      <p data-media-empty-title>No shared uploads yet</p>
      <span data-media-empty-help>Share a photo or video from your activation.</span>
    </div>
    <div class="media-grid" data-media-gallery></div>
    <button class="button" data-variant="light" type="button" data-media-more hidden>Load more files</button>
  </section>

  {personal && (
    <dialog class="media-modal media-upload-modal" data-media-upload-dialog aria-label="Upload photos & videos">
      <div class="media-upload">
        <header class="media-modal__header">
          <div><p class="eyebrow">Share your activation</p><h2>Upload photos & videos</h2></div>
          <button class="media-close" type="button" data-media-upload-close aria-label="Close upload">✕</button>
        </header>
        <p class="form-help" id="media-upload-limits">Photos up to {formatMediaBytes(mediaLimits.photoBytes)} each · Videos up to {formatMediaBytes(mediaLimits.videoBytes)} each.</p>
        <div class="media-park-field">
          <label for="activator-media-default-park">Park (optional)</label>
          <select id="activator-media-default-park" class="media-park-select" data-media-default-park aria-describedby="media-default-park-help">
            <option value="">General — no park</option>
            {mediaParks.map((park) => <option value={park.reference}>{park.reference} — {park.name}</option>)}
          </select>
          <p class="form-help" id="media-default-park-help">Applies to files you choose next. You can change the park for each file.</p>
        </div>
        <div class="media-dropzone" data-media-dropzone>
          <label for="activator-media-files">Choose photos and videos</label>
          <input id="activator-media-files" type="file" multiple accept={mediaAccept} data-media-input aria-describedby="media-upload-limits media-upload-formats" />
          <p class="form-help">Or drag files here.</p>
        </div>
        <p class="form-help" id="media-upload-formats">JPEG, PNG, GIF, WebP, HEIC, HEIF, or AVIF photos; MP4, MOV, or WebM videos. Originals, including embedded location and camera metadata, are retained.</p>
        <div data-media-queue-section hidden>
          <h3>Selected files</h3>
          <ul class="media-queue" data-media-queue aria-label="Selected files"></ul>
          <p class="form-help media-usage-notice" data-media-usage-notice>{mediaUsageNoticeText}</p>
          <div class="button-row media-upload__actions">
            <button class="button" data-variant="primary" type="button" data-media-upload disabled>Upload selected files</button>
            <button class="button" data-variant="light" type="button" data-media-clear>Clear finished files</button>
          </div>
          <p class="form-help">Files upload one at a time. Keep this dialog open until they finish.</p>
        </div>
        <p class="form-status" data-media-upload-status role="status" aria-live="polite"></p>
      </div>
    </dialog>
  )}

  <dialog class="media-modal media-details-modal" data-media-details-dialog aria-label="Media details">
    <div class="media-detail">
      <header class="media-modal__header media-detail__header">
        <div><p class="eyebrow" data-media-details-author></p><h2 data-media-details-heading>Media details</h2></div>
        <button class="media-close" type="button" data-media-details-cancel aria-label="Close details">✕</button>
      </header>
      <div class="media-detail__layout">
        <div class="media-detail__preview" data-media-details-preview></div>
        <div class="media-detail__information">
          <p class="media-detail__park" data-media-details-park></p>
          <p class="media-detail__meta" data-media-details-meta></p>
          <div data-media-details-readonly><p class="media-detail__description" data-media-details-description></p></div>
          <form class="media-detail__form" data-media-details-form hidden>
            <div class="media-park-field">
              <label for={`${prefix}-media-edit-title`}>Title (optional)</label>
              <input id={`${prefix}-media-edit-title`} class="media-details-input" type="text" maxlength={mediaMetadataLimits.title} data-media-edit-title />
            </div>
            <div class="media-park-field">
              <label for={`${prefix}-media-edit-description`}>Description (optional)</label>
              <textarea id={`${prefix}-media-edit-description`} class="media-details-input" rows="4" maxlength={mediaMetadataLimits.description} data-media-edit-description></textarea>
            </div>
            <div class="media-park-field">
              <label for={`${prefix}-media-edit-park`}>Park for this file</label>
              <select id={`${prefix}-media-edit-park`} class="media-park-select" data-media-edit-park>
                <option value="">General — no park</option>
                {mediaParks.map((park) => <option value={park.reference}>{park.reference} — {park.name}</option>)}
              </select>
            </div>
            <p class="form-status" data-media-details-status role="status" aria-live="polite"></p>
            <button class="button" data-variant="primary" type="submit" data-media-details-save>Save details</button>
          </form>
          <div class="media-detail__actions">
            <a data-media-download>Download original</a>
            <button class="button" data-variant="light" type="button" data-media-detail-delete hidden>Delete media</button>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <dialog class="form-confirmation" data-media-delete-dialog aria-labelledby={`${prefix}-media-delete-title`}>
    <form method="dialog" class="form-confirmation__body">
      <p class="eyebrow">Remove an upload</p>
      <h2 id={`${prefix}-media-delete-title`}>Delete this media?</h2>
      <p data-media-delete-description></p>
      <p>This removes the original. It can be uploaded again if the activator still has a copy.</p>
      <p class="form-status" data-media-delete-status role="status" aria-live="polite"></p>
      <div class="form-actions">
        <button class="button" data-variant="light" value="cancel" data-media-delete-cancel>Keep file</button>
        <button class="button" data-variant="danger" type="button" data-media-delete-confirm>Delete file</button>
      </div>
    </form>
  </dialog>
  <noscript><p class="form-status">Enable JavaScript to upload and view activator photos and videos.</p></noscript>
</div>

<script>
  import { setupMediaWorkspace } from "../../lib/activate-ri/media-client";
  document.querySelectorAll<HTMLElement>("[data-media-workspace]").forEach(setupMediaWorkspace);
</script>

<style is:global>
  .media-workspace { display: grid; gap: 1.4rem; min-width: 0; }
  .media-workspace__header, .media-library__toolbar, .media-modal__header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .media-workspace__header { flex-wrap: wrap; }
  .media-workspace__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .media-workspace__actions > a:not(.button) { color: var(--link); font-size: .9rem; }
  .media-filters { display: flex; align-items: end; flex-wrap: wrap; gap: .75rem; min-width: 0; }
  .media-filter-park { width: min(24rem, 100%); }
  .media-workspace .media-workspace__header h1, .media-workspace .media-workspace__header h2 { margin: 0; max-width: none; font-size: clamp(2rem, 4vw, 2.75rem); }
  .media-workspace__header .lead { margin: .6rem 0 0; max-width: 54ch; font-size: 1rem; }
  .media-workspace .eyebrow { margin: 0 0 .3rem; }
  .media-library { display: grid; gap: 1rem; min-width: 0; }
  .media-library__toolbar { flex-wrap: wrap; }
  .media-library__toolbar > .button { margin-left: auto; }
  .media-workspace .form-status { margin: 0; }
  .media-library > .form-status:empty { display: none; }
  .media-scope { display: inline-flex; gap: .25rem; border: 1px solid var(--border-subtle); border-radius: 8px; padding: .25rem; background: var(--surface-raised); }
  .media-scope button { min-height: 44px; border: 0; border-radius: 5px; padding: .5rem .8rem; background: transparent; color: var(--text-primary); font: inherit; font-weight: 700; cursor: pointer; }
  .media-scope button[aria-pressed="true"] { background: var(--surface-ink); color: var(--surface-page); }
  .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 1rem; }
  .media-tile { min-width: 0; }
  .media-tile__button { display: block; position: relative; width: 100%; aspect-ratio: 4 / 3; overflow: hidden; padding: 0; border: 0; border-radius: 9px; background: color-mix(in srgb, var(--surface-ink) 8%, var(--surface-page)); color: var(--text-primary); cursor: pointer; }
  .media-tile__preview, .media-tile__preview > img { width: 100%; height: 100%; object-fit: cover; }
  .media-tile__fallback { display: grid; position: absolute; inset: 0; align-content: center; gap: .35rem; padding: .7rem; font: inherit; font-size: .85rem; text-align: center; }
  .media-tile__park { position: absolute; top: .55rem; right: .55rem; border: 1px solid #ffffff45; border-radius: 999px; padding: .25rem .5rem; background: #142b27e6; color: #fff; font-size: .72rem; font-weight: 800; }
  .media-tile__tooltip { position: absolute; top: 2.8rem; right: .5rem; left: .5rem; width: fit-content; margin-left: auto; max-width: calc(100% - 1rem); border-radius: 5px; padding: .4rem .6rem; background: var(--surface-raised); color: var(--text-primary); font-size: .8rem; text-align: left; opacity: 0; pointer-events: none; }
  .media-tile__button:hover .media-tile__tooltip, .media-tile__button:focus-visible .media-tile__tooltip { opacity: 1; }
  .media-tile__caption { display: grid; gap: .15rem; padding: .5rem .1rem .15rem; }
  .media-tile__caption h3 { margin: 0; font: inherit; font-size: .9rem; font-weight: 700; overflow-wrap: anywhere; }
  .media-tile__own { width: fit-content; margin-top: .15rem; padding: .12rem .4rem; border-radius: 4px; background: color-mix(in srgb, var(--accent) 12%, var(--surface-page)); color: var(--accent-strong); font-size: .7rem; font-weight: 800; }
  .media-tile__author { margin: 0; color: var(--text-muted); font-size: .8rem; overflow-wrap: anywhere; }
  .media-empty { border: 1px dashed var(--border-subtle); border-radius: 10px; text-align: center; padding: 3rem 1rem; }
  .media-empty p { margin: 0 0 .4rem; font-size: 1.15rem; font-weight: 800; }
  .media-empty span { color: var(--text-muted); }
  .media-modal { max-height: calc(100dvh - 2rem); border: 1px solid var(--border-subtle); border-radius: 12px; background: var(--surface-raised); color: var(--text-primary); padding: 0; overscroll-behavior: contain; }
  .media-modal::backdrop { background: #102322aa; }
  .media-upload-modal { width: min(94vw, 46rem); }
  .media-details-modal { width: min(96vw, 72rem); }
  .media-modal__header { align-items: start; }
  .media-workspace .media-modal__header h2 { margin: 0; max-width: none; font-size: clamp(1.4rem, 3vw, 1.8rem); overflow-wrap: anywhere; }
  .media-close { display: grid; place-items: center; flex: 0 0 auto; width: 44px; height: 44px; padding: 0; border: 1px solid var(--border-subtle); border-radius: 50%; background: var(--surface-raised); color: var(--text-primary); font-size: 1.05rem; cursor: pointer; }
  .media-close:disabled { opacity: .4; cursor: wait; }
  .media-upload { display: grid; gap: 1rem; padding: clamp(1rem, 3vw, 1.75rem); }
  .media-upload h3 { margin: 0; font-size: 1.1rem; }
  .media-workspace .form-help { margin: .35rem 0 0; font-size: .85rem; }
  .media-workspace .media-usage-notice { margin: .8rem 0; max-width: 75ch; }
  .media-park-field { display: grid; gap: .35rem; min-width: 0; }
  .media-park-field label, .media-queue__park > span { font-weight: 700; font-size: .9rem; }
  .media-park-select, .media-details-input { display: block; width: 100%; min-width: 0; max-width: 100%; min-height: 44px; border: 1px solid var(--border-subtle); border-radius: 6px; background: var(--surface-raised); color: var(--text-primary); padding: .55rem .65rem; font: inherit; }
  textarea.media-details-input { resize: vertical; }
  .media-queue__park { display: grid; gap: .3rem; margin: .5rem 0; font-size: .85rem; }
  .media-dropzone { display: grid; gap: .8rem; border: 2px dashed var(--border-subtle); border-radius: 8px; background: var(--surface-page); padding: 1rem; }
  .media-dropzone[data-dragging="true"] { border-color: var(--accent); }
  .media-dropzone label { font-weight: 800; }
  .media-dropzone input { max-width: 100%; min-width: 0; color: var(--text-muted); }
  .media-dropzone input::file-selector-button { margin-right: .6rem; border: 1px solid var(--border-subtle); border-radius: 6px; background: var(--surface-raised); color: var(--text-primary); padding: .6rem .7rem; cursor: pointer; font: inherit; font-weight: 700; }
  .media-queue { display: grid; gap: .6rem; margin: .8rem 0; padding: 0; list-style: none; }
  .media-queue__item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .35rem .8rem; align-items: center; border: 1px solid var(--border-subtle); border-radius: 8px; padding: .75rem; }
  .media-queue__name { display: block; overflow-wrap: anywhere; }
  .media-queue__detail, .media-queue__status { margin: .15rem 0 0; color: var(--text-muted); font-size: .8rem; }
  .media-queue__status[data-error="true"] { color: light-dark(#a52218, #ffb4ab); }
  .media-queue__progress { grid-column: 1 / -1; width: 100%; height: .5rem; accent-color: var(--accent); }
  .media-queue__actions { display: flex; flex-wrap: wrap; gap: .4rem; }
  .media-queue__actions .button { min-height: 44px; padding: .5rem .6rem; font-size: .85rem; }
  .media-upload__actions { flex-wrap: wrap; }
  .media-detail__header { padding: 1.1rem 1.25rem; border-bottom: 1px solid var(--border-subtle); }
  .media-detail__layout { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(16rem, 1fr); }
  .media-detail__preview { display: grid; place-items: center; min-height: 22rem; background: #101918; color: #fff; }
  .media-detail__preview > img, .media-detail__preview > video { display: block; width: 100%; max-height: 72dvh; object-fit: contain; }
  .media-detail__fallback { padding: 1.5rem; color: #e7eee8; text-align: center; }
  .media-detail__information { display: grid; align-content: start; gap: 1rem; min-width: 0; padding: 1.25rem; }
  .media-detail__park { margin: 0; font-weight: 700; color: var(--accent-strong); font-size: .9rem; overflow-wrap: anywhere; }
  .media-detail__meta { margin: -.4rem 0 0; color: var(--text-muted); font-size: .8rem; }
  .media-detail__description { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .media-detail__form { display: grid; gap: .85rem; }
  .media-detail__actions { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: .7rem; padding-top: .8rem; border-top: 1px solid var(--border-subtle); }
  .media-detail__actions a { color: var(--link); font-size: .9rem; }
  .media-detail__actions .button { min-height: 44px; padding: .45rem .65rem; font-size: .85rem; }
  @media (max-width: 700px) {
    .media-detail__layout { grid-template-columns: minmax(0, 1fr); }
    .media-detail__preview { min-height: 12rem; }
    .media-detail__preview > img, .media-detail__preview > video { max-height: 48dvh; }
    .media-detail__information { padding: 1rem; }
  }
  @media (max-width: 520px) {
    .media-workspace[data-media-scope="public"] .media-library__toolbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: .75rem .5rem; }
    .media-filters { display: contents; }
    .media-filter-park { width: 100%; grid-column: 1 / -1; }
    .media-filters > .media-scope { width: fit-content; }
    .media-filters > [data-media-filter-clear] { grid-column: 1 / -1; grid-row: 3; justify-self: start; }
    .media-workspace[data-media-scope="public"] [data-media-refresh] { grid-column: 2; grid-row: 2; }
    .media-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem .6rem; }
    .media-queue__item { grid-template-columns: minmax(0, 1fr); }
    .media-queue__actions { justify-self: start; }
    .media-upload__actions > .button { width: 100%; }
    .media-library__toolbar > .button { width: auto; padding-inline: .65rem; font-size: .8rem; }
    .media-scope button { font-size: .85rem; padding-inline: .65rem; }
    .media-tile__park { top: .35rem; right: .35rem; font-size: .65rem; padding: .2rem .4rem; }
    .media-tile__tooltip { top: 2.3rem; font-size: .72rem; }
  }
</style>
