<section class="pota-activity" data-pota-activity aria-labelledby="pota-activity-title">
  <div class="pota-activity__intro">
    <p class="eyebrow">Unofficial spot activity</p>
    <h2 id="pota-activity-title">How are we doing?</h2>
    <p data-pota-activity-status role="status" aria-live="polite">Loading collected Rhode Island POTA spots…</p>
  </div>
  <dl class="coverage-summary" aria-label="Event progress summary">
    <div><dt>Parks spotted</dt><dd data-activity-parks>—</dd></div>
    <div><dt>Not yet spotted</dt><dd data-activity-unspotted>—</dd></div>
    <div><dt>Activators</dt><dd data-activity-activators>—</dd></div>
    <div><dt>Modes</dt><dd data-activity-modes>—</dd></div>
    <div><dt>Bands</dt><dd data-activity-bands>—</dd></div>
  </dl>
  <p class="pota-progress__notice">
    This is an unofficial RI POTA community summary built from spots observed by this site. Official Parks on the Air spots, logs, rules, references, and activation validity remain the source of truth. A spot is activity evidence, not a confirmed activation.
  </p>
  <fieldset class="pota-status-filters" data-activity-filters>
    <legend>Show parks</legend>
    <label><input type="radio" name="activity-view" value="all" /> All parks (<span data-activity-count-all>—</span>)</label>
    <label><input type="radio" name="activity-view" value="spotted" checked /> Spotted (<span data-activity-count-spotted>—</span>)</label>
    <label><input type="radio" name="activity-view" value="unspotted" /> Not yet spotted (<span data-activity-count-unspotted>—</span>)</label>
  </fieldset>
  <p class="pota-progress__notice">
    “Not yet spotted” includes scheduled parks and means this site has no spot evidence in the selected time window. Check the event plan and POTA confirmation before arranging another activation. Missing parks with no remaining plan or a passed window appear first.
  </p>
  <label class="event-filter pota-progress__search">
    Search parks
    <input class="event-filter__control" type="search" data-activity-search placeholder="Reference or park name" />
  </label>
  <p data-activity-filter-status role="status" aria-live="polite"></p>
  <div class="event-table-wrap" data-pota-activity-table hidden>
    <table class="event-table">
      <thead><tr>
        <th scope="col">Park</th>
        <th scope="col">Coverage / next step</th>
        <th scope="col">Planned activation</th>
        <th scope="col">First spotted</th>
        <th scope="col">Last spotted</th>
        <th scope="col">Activators</th>
        <th scope="col">Modes</th>
        <th scope="col">Bands</th>
        <th scope="col">Evidence</th>
        <th scope="col">Non-RBN spotters</th>
        <th scope="col">Spot reports</th>
      </tr></thead>
      <tbody data-pota-activity-rows></tbody>
    </table>
  </div>
  <p class="pota-progress__empty" data-pota-activity-empty hidden>No parks match this view.</p>
</section>

<script>
  import { setupSpotActivity } from "../../lib/activate-ri/spot-activity-client";
  document.querySelectorAll<HTMLElement>("[data-pota-activity]").forEach(setupSpotActivity);
</script>
