---
import { parks as references } from "@ripota/parks";
import OpsConnectionStatus from "./OpsConnectionStatus.astro";
import OpsFeed from "./OpsFeed.astro";
import OpsPinnedAnnouncement from "./OpsPinnedAnnouncement.astro";
import OpsUpcomingStops from "./OpsUpcomingStops.astro";
import OpsRoomSettings from "./OpsRoomSettings.astro";

const parkNames = Object.fromEntries(
  references.map((reference) => [reference.reference, reference.name]),
);
---

<div class="ops-room" data-ops-room data-park-names={JSON.stringify(parkNames)}>
  <div class="ops-room__statusbar">
    <OpsConnectionStatus />
    <p data-ops-sync-copy>Updates appear here as they happen.</p>
    <button class="button" data-variant="light" type="button" data-ops-open-settings disabled>Settings</button>
  </div>
  <div class="ops-room__layout">
    <div class="ops-room__main">
      <OpsPinnedAnnouncement />
      <OpsFeed />
    </div>
    <aside class="ops-room__sidebar">
      <OpsUpcomingStops />
    </aside>
  </div>

  <OpsRoomSettings />
  <dialog class="ops-rules ops-message-editor" data-ops-edit-dialog aria-labelledby="ops-edit-title">
    <form data-ops-edit-form>
      <h2 id="ops-edit-title">Edit message</h2>
      <p id="ops-edit-help">You can edit this message for 20 minutes after posting.</p>
      <label for="ops-edit-body">Message</label>
      <textarea id="ops-edit-body" data-ops-edit-body rows="5" required aria-describedby="ops-edit-help ops-edit-status"></textarea>
      <p id="ops-edit-status" class="form-status" data-ops-edit-status role="status"></p>
      <div class="form-actions">
        <button class="button" data-variant="primary" type="submit" data-ops-edit-save>Save changes</button>
        <button class="button" data-variant="light" type="button" data-ops-edit-cancel>Cancel</button>
      </div>
    </form>
  </dialog>
  <p class="sr-only" data-ops-edit-saved role="status"></p>
</div>

<script>
  import { continuesOpsMessageGroup, opsMessageTimeLabel } from "../../lib/activate-ri/ops-presentation";
  import { isOpsMessageWithinEditWindow, OPS_MESSAGE_EDIT_WINDOW_MS } from "../../lib/activate-ri/ops-editing";
  import { startOpsEngagement } from "../../lib/activate-ri/ops-engagement";

  type RoomMode = "full" | "announcements" | "off";
  type MembershipStatus = "active" | "muted" | "banned";
  type MessageKind = "chat" | "access-note" | "running-late" | "need-backup" | "announcement" | "system";
  type Message = {
    id: string;
    kind: MessageKind;
    authorType: "activator" | "admin" | "system";
    authorLabel: string;
    authorActivatorId?: string;
    body: string;
    parkReference?: string;
    stopId?: string;
    createdAt: string;
    editedAt?: string;
    resolved: boolean;
    resolvedAt?: string;
    removed: boolean;
    removedAt?: string;
    removedBy?: "author" | "organizer";
  };
  type Stop = { id: string; parkReference: string; startAt: string; endAt: string };
  type RoomEvent =
    | { sequence: number; type: "message-created"; message: Message }
    | { sequence: number; type: "message-edited"; messageId: string; body: string; editedAt: string }
    | { sequence: number; type: "message-removed"; messageId: string; removedAt: string; removedBy: "author" | "organizer" }
    | { sequence: number; type: "message-resolved" | "message-reopened"; messageId: string; resolvedAt?: string }
    | { sequence: number; type: "pin-changed"; pinnedMessage: Message | null }
    | { sequence: number; type: "room-mode-changed"; mode: RoomMode };
  type Bootstrap = {
    ok: true;
    membership: { status: MembershipStatus; acceptedRulesVersion?: string; acceptedRulesAt?: string };
    rulesVersion: string;
    roomMode: RoomMode;
    pinnedMessage: Message | null;
    messages: Message[];
    upcomingStops: Stop[];
    cursor: number;
  };
  type Draft = { clientNonce: string; kind: string; context: string; body: string };

  const room = document.querySelector<HTMLElement>("[data-ops-room]");
  const connection = room?.querySelector<HTMLElement>("[data-ops-connection]");
  const connectionLabel = room?.querySelector<HTMLElement>("[data-ops-connection-label]");
  const feed = room?.querySelector<HTMLOListElement>("[data-ops-feed]");
  const filters = room?.querySelector<HTMLElement>("[data-ops-filters]");
  const stopsElement = room?.querySelector<HTMLElement>("[data-ops-stops]");
  const composer = room?.querySelector<HTMLFormElement>("[data-ops-composer]");
  const kindSelect = room?.querySelector("[data-ops-kind]") as HTMLSelectElement | null | undefined;
  const contextSelect = room?.querySelector("[data-ops-context]") as HTMLSelectElement | null | undefined;
  const bodyInput = room?.querySelector<HTMLTextAreaElement>("[data-ops-body]");
  const sendButton = room?.querySelector<HTMLButtonElement>("[data-ops-send]");
  const sendState = room?.querySelector<HTMLElement>("[data-ops-send-state]");
  const composeOptions = room?.querySelector<HTMLDetailsElement>("[data-ops-options]");
  const composeOptionsSummary = room?.querySelector<HTMLElement>("[data-ops-options-summary]");
  const unsent = room?.querySelector<HTMLElement>("[data-ops-unsent]");
  const pin = room?.querySelector<HTMLElement>("[data-ops-pin]");
  const pinBody = room?.querySelector<HTMLElement>("[data-ops-pin-body]");
  const pinMeta = room?.querySelector<HTMLElement>("[data-ops-pin-meta]");
  const rulesDialog = room?.querySelector<HTMLDialogElement>("[data-ops-settings]");
  const editDialog = room?.querySelector<HTMLDialogElement>("[data-ops-edit-dialog]");
  const editForm = editDialog?.querySelector<HTMLFormElement>("[data-ops-edit-form]");
  const editBody = editDialog?.querySelector<HTMLTextAreaElement>("[data-ops-edit-body]");
  const editStatus = editDialog?.querySelector<HTMLElement>("[data-ops-edit-status]");
  const editSave = editDialog?.querySelector<HTMLButtonElement>("[data-ops-edit-save]");
  const editCancel = editDialog?.querySelector<HTMLButtonElement>("[data-ops-edit-cancel]");
  const parkNames = JSON.parse(room?.dataset.parkNames ?? "{}") as Record<string, string>;
  const messages = new Map<string, Message>();
  const socketEvents: RoomEvent[] = [];
  const retryDelays = [1_000, 2_000, 5_000, 10_000, 30_000, 60_000];
  const cursorKey = "activate-ri-ops-cursor";
  let seenMessages = new Set<string>();
  const visibleMessages = new Set<string>();
  let seenTimer: number | undefined;
  const readObserver = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      const id = (entry.target as HTMLElement).dataset.messageId;
      if (!id) continue;
      const readableHeight = Math.min(entry.boundingClientRect.height, feed?.clientHeight ?? innerHeight);
      if (entry.isIntersecting && entry.intersectionRect.height >= readableHeight * 0.6) visibleMessages.add(id);
      else visibleMessages.delete(id);
    }
    scheduleSeenMessages();
  }, { threshold: Array.from({ length: 21 }, (_, index) => index / 20) });
  let activatorId = "";
  let upcomingStops: Stop[] = [];
  let pinnedMessage: Message | null = null;
  let membershipStatus: MembershipStatus = "active";
  let roomMode: RoomMode = "off";
  let cursor = 0;
  let socket: WebSocket | null = null;
  let syncing = false;
  let retryAttempt = 0;
  let retryTimer: number | undefined;
  let hiddenCloseTimer: number | undefined;
  let intentionalClose = false;
  let lastSynchronizedAt: Date | null = null;
  let roomLoaded = false;
  let loadingRoom = false;
  let sending = false;
  let editingMessageId: string | null = null;
  let savingEdit = false;
  let editExpiryTimer: number | undefined;
  let linkedMessage = location.hash.startsWith("#ops-message-") ? location.hash.slice(1) : null;
  const stopEngagement = room ? startOpsEngagement(
    room, () => roomLoaded && roomMode !== "off" && membershipStatus !== "banned",
    linkedMessage ? "message_link" : "direct",
  ) : undefined;

  if (room) {
    void initialize();
  }

  async function initialize(): Promise<void> {
    restoreFilter();
    await loadRoom();
    await restoreDraft();
  }

  async function loadRoom(): Promise<void> {
    if (loadingRoom) return;
    loadingRoom = true;
    window.clearTimeout(retryTimer);
    closeSocket(true);
    setConnection("loading", "Connecting…");
    try {
      const [sessionResponse, bootstrapResponse] = await Promise.all([
        fetch("/api/activate-ri-2026/activator/session", { headers: { accept: "application/json" } }),
        fetch("/api/activate-ri-2026/ops/bootstrap", { headers: { accept: "application/json" } }),
      ]);
      if (sessionResponse.status === 401) {
        window.location.replace("/activate-ri-2026/access/");
        return;
      }
      if (!sessionResponse.ok || bootstrapResponse.status >= 500) throw new Error("Room temporarily unavailable");
      if (!bootstrapResponse.ok) {
        roomLoaded = true;
        setConnection("unavailable", bootstrapResponse.status === 503
          ? "Room unavailable"
          : "You do not currently have Ops Room access");
        disableComposer(true);
        feed?.replaceChildren(emptyItem(
          "The room is closed right now.",
          "Your private plan editor is still available.",
        ));
        return;
      }
      const sessionBody = await sessionResponse.json() as { activator?: { id?: string } };
      const data = await bootstrapResponse.json() as Bootstrap;
      roomLoaded = true;
      activatorId = sessionBody.activator?.id ?? "";
      restoreSeenMessages();
      membershipStatus = data.membership.status;
      roomMode = data.roomMode;
      upcomingStops = data.upcomingStops;
      pinnedMessage = data.pinnedMessage;
      messages.clear();
      data.messages.forEach((message) => messages.set(message.id, message));
      if (linkedMessage) {
        const messageId = linkedMessage.slice("ops-message-".length);
        if (/^[a-f0-9-]{36}$/i.test(messageId) && !messages.has(messageId)) {
          try {
            const linked = await fetch(`/api/activate-ri-2026/ops/messages/${encodeURIComponent(messageId)}`);
            if (linked.ok) {
              const result = await linked.json() as { message: Message };
              messages.set(result.message.id, result.message);
            }
          } catch { /* The recent feed remains available if an older link cannot load. */ }
        }
      }
      cursor = data.cursor;
      localStorage.setItem(cursorKey, String(cursor));
      renderAll();
      if (linkedMessage) {
        const target = document.getElementById(linkedMessage);
        target?.scrollIntoView({ block: "nearest" });
        target?.focus({ preventScroll: true });
        linkedMessage = null;
      }
      if (data.membership.acceptedRulesVersion !== data.rulesVersion) {
        window.dispatchEvent(new Event("activate-ri:ops-setup"));
      }
      room?.querySelector<HTMLButtonElement>("[data-ops-open-settings]")?.removeAttribute("disabled");
      connectSocket();
    } catch {
      setConnection("offline", offlineLabel());
      disableComposer(!roomLoaded || roomMode !== "full" || membershipStatus !== "active");
      if (!roomLoaded) feed?.replaceChildren(emptyItem("Unable to open the room.", "Reconnecting automatically. You can also refresh room updates or open My Plan."));
      scheduleReconnect();
    } finally {
      loadingRoom = false;
    }
  }

  function connectSocket(): void {
    if (socket && (socket.readyState === WebSocket.CLOSED || socket.readyState === WebSocket.CLOSING)) {
      socket = null;
    }
    if (document.hidden || !navigator.onLine || socket || roomMode === "off") {
      return;
    }
    intentionalClose = false;
    setConnection("reconnecting", retryAttempt === 0 ? "Connecting…" : "Reconnecting");
    const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
    const activeSocket = new WebSocket(`${protocol}//${window.location.host}/api/activate-ri-2026/ops/socket`);
    socket = activeSocket;
    activeSocket.addEventListener("message", (event) => {
      void handleSocketMessage(event).catch(() => {
        syncing = false;
        socketEvents.length = 0;
        activeSocket.close();
      });
    });
    activeSocket.addEventListener("close", () => {
      if (socket !== activeSocket) return;
      socket = null;
      if (intentionalClose || document.hidden || roomMode === "off") {
        return;
      }
      setConnection(navigator.onLine ? "reconnecting" : "offline", offlineLabel());
      scheduleReconnect();
    });
    activeSocket.addEventListener("error", () => activeSocket.close());
  }

  async function handleSocketMessage(raw: MessageEvent): Promise<void> {
    let payload: unknown;
    try {
      payload = JSON.parse(String(raw.data));
    } catch {
      socket?.close(1002, "Invalid event");
      return;
    }
    if (isHello(payload)) {
      syncing = true;
      await catchUp(cursor, payload.highWatermark);
      for (const event of socketEvents.sort((a, b) => a.sequence - b.sequence)) {
        applyEvent(event);
      }
      socketEvents.length = 0;
      syncing = false;
      retryAttempt = 0;
      markSynchronized();
      updateRoomMode(payload.roomMode);
      return;
    }
    if (isMembershipControl(payload)) {
      membershipStatus = payload.status;
      disableComposer(roomMode !== "full" || membershipStatus !== "active");
      renderFeed();
      if (payload.status === "banned") {
        setConnection("unavailable", "Room access unavailable");
        closeSocket(true);
      }
      return;
    }
    if (!isRoomEvent(payload)) {
      socket?.close(1002, "Invalid event");
      return;
    }
    if (syncing) {
      socketEvents.push(payload);
      return;
    }
    if (payload.sequence > cursor + 1) {
      syncing = true;
      socketEvents.push(payload);
      await catchUp(cursor, payload.sequence - 1);
      for (const event of socketEvents.sort((a, b) => a.sequence - b.sequence)) {
        applyEvent(event);
      }
      socketEvents.length = 0;
      syncing = false;
      markSynchronized();
      return;
    }
    applyEvent(payload);
    markSynchronized();
  }

  async function catchUp(after: number, through: number): Promise<void> {
    let next = after;
    while (next < through) {
      const response = await fetch(
        `/api/activate-ri-2026/ops/events?after=${next}&through=${through}&limit=250`,
        { headers: { accept: "application/json" } },
      );
      if (!response.ok) {
        throw new Error("Catch-up failed");
      }
      const page = await response.json() as {
        events: RoomEvent[];
        nextCursor: number;
        hasMore: boolean;
        resetRequired?: boolean;
      };
      if (page.resetRequired) {
        await loadRoom();
        return;
      }
      page.events.forEach(applyEvent);
      next = page.nextCursor;
      if (!page.hasMore) {
        break;
      }
    }
  }

  function applyEvent(event: RoomEvent): void {
    if (event.sequence <= cursor) {
      return;
    }
    if (event.type === "message-created") {
      messages.set(event.message.id, event.message);
    } else if (event.type === "message-edited") {
      const message = messages.get(event.messageId);
      if (message && !message.removed) {
        messages.set(event.messageId, { ...message, body: event.body, editedAt: event.editedAt });
      }
    } else if (event.type === "message-removed") {
      if (pinnedMessage?.id === event.messageId) pinnedMessage = null;
      const message = messages.get(event.messageId);
      if (message) {
        messages.set(event.messageId, {
          ...message,
          body: "",
          removed: true,
          removedAt: event.removedAt,
          removedBy: event.removedBy,
        });
      }
    } else if (event.type === "message-resolved" || event.type === "message-reopened") {
      const message = messages.get(event.messageId);
      if (message) {
        messages.set(event.messageId, {
          ...message,
          resolved: event.type === "message-resolved",
          resolvedAt: event.resolvedAt,
        });
      }
    } else if (event.type === "pin-changed") {
      pinnedMessage = event.pinnedMessage;
    } else if (event.type === "room-mode-changed") {
      updateRoomMode(event.mode);
    }
    cursor = event.sequence;
    localStorage.setItem(cursorKey, String(cursor));
    renderFeed();
    renderPin();
  }

  function renderAll(): void {
    renderStops();
    renderContexts();
    renderFeed();
    renderPin();
    updateRoomMode(roomMode);
  }

  function renderStops(): void {
    if (!stopsElement) return;
    stopsElement.replaceChildren();
    if (upcomingStops.length === 0) {
      stopsElement.appendChild(emptyParagraph("No upcoming scheduled stops. Open your plan editor to review your itinerary."));
      return;
    }
    upcomingStops.forEach((stop, index) => {
      const card = document.createElement("article");
      card.className = "ops-stop";
      if (index === 0) card.dataset.next = "true";
      const heading = document.createElement("h3");
      heading.textContent = `${stop.parkReference} — ${parkNames[stop.parkReference] ?? "RI park"}`;
      const timing = document.createElement("p");
      timing.className = "ops-stop__time";
      timing.textContent = stopTimeLabel(stop);
      const actions = document.createElement("div");
      actions.className = "ops-quick-actions";
      actions.appendChild(quickAction("Running late", "running-late", stop.id));
      actions.appendChild(quickAction("Need backup", "need-backup", stop.id));
      actions.appendChild(quickAction("Access problem", "access-note", stop.id));
      card.appendChild(heading);
      card.appendChild(timing);
      card.appendChild(actions);
      stopsElement.appendChild(card);
    });
  }

  function renderContexts(): void {
    if (!contextSelect) return;
    const selected = contextSelect.value;
    contextSelect.replaceChildren();
    contextSelect.appendChild(new Option("No park context", ""));
    const stopGroup = document.createElement("optgroup");
    stopGroup.label = "My upcoming stops";
    upcomingStops.forEach((stop) => stopGroup.appendChild(new Option(stopLabel(stop), `stop:${stop.id}`)));
    contextSelect.appendChild(stopGroup);
    const parkGroup = document.createElement("optgroup");
    parkGroup.label = "Rhode Island parks";
    Object.entries(parkNames).forEach(([reference, name]) => {
      parkGroup.appendChild(new Option(`${reference} — ${name}`, `park:${reference}`));
    });
    contextSelect.appendChild(parkGroup);
    if ([...contextSelect.options].some((option) => option.value === selected)) {
      contextSelect.value = selected;
    }
    updateComposeSummary();
  }

  function renderFeed(): void {
    if (!feed) return;
    updateEditAvailability();
    const openMenus = new Set([...feed.querySelectorAll<HTMLDetailsElement>("details.ops-message__actions[open]")]
      .map((menu) => menu.closest<HTMLElement>("[data-message-id]")?.dataset.messageId));
    const focusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const focusedMessageId = focusedElement?.closest<HTMLElement>("[data-message-id]")?.dataset.messageId;
    const focusedActionName = focusedElement?.dataset.action;
    const focusedSummary = focusedElement?.tagName === "SUMMARY";
    const nearTop = feed.scrollTop < 40;
    const feedTop = feed.getBoundingClientRect().top;
    const anchor = [...feed.querySelectorAll<HTMLElement>("[data-message-id]")]
      .find((item) => item.getBoundingClientRect().bottom > feedTop
        && !messages.get(item.dataset.messageId ?? "")?.removed);
    const anchorOffset = anchor ? anchor.getBoundingClientRect().top - feedTop : 0;
    const filter = selectedFilter();
    const myParks = new Set(upcomingStops.map((stop) => stop.parkReference));
    const visible = [...messages.values()].sort((a, b) =>
      b.createdAt.localeCompare(a.createdAt) || b.id.localeCompare(a.id),
    ).filter((message) => {
      if (message.removed) return false;
      if (filter === "all") return true;
      if (filter === "my-parks") return Boolean(message.parkReference && myParks.has(message.parkReference));
      return message.kind === filter;
    });
    readObserver.disconnect();
    visibleMessages.clear();
    window.clearTimeout(seenTimer);
    feed.replaceChildren();
    if (visible.length === 0) {
      const hasMessages = [...messages.values()].some((message) => !message.removed);
      feed.appendChild(emptyItem(
        hasMessages ? "Nothing in this view." : "You're all caught up.",
        hasMessages
          ? "Choose another filter to see the rest of the room."
          : "Announcements and field updates will appear here as they happen.",
      ));
      if (focusedMessageId) feed.focus({ preventScroll: true });
      updateUnreadControls();
      return;
    }
    visible.forEach((message, index) => {
      const previous = visible[index - 1];
      const continuation = continuesOpsMessageGroup(message, previous)
        && isUnread(message) === isUnread(previous);
      const item = messageItem(message, continuation);
      const menu = item.querySelector<HTMLDetailsElement>("details.ops-message__actions");
      if (menu && openMenus.has(message.id)) menu.open = true;
      feed.appendChild(item);
    });
    if (focusedMessageId) {
      const item = feed.querySelector<HTMLElement>(`[data-message-id="${CSS.escape(focusedMessageId)}"]`);
      const action = focusedSummary ? item?.querySelector<HTMLElement>("summary")
        : focusedActionName ? item?.querySelector<HTMLElement>(`[data-action="${CSS.escape(focusedActionName)}"]`) : null;
      (action ?? item ?? feed).focus({ preventScroll: true });
    }
    if (nearTop) {
      feed.scrollTop = 0;
    } else if (anchor?.dataset.messageId) {
      const replacement = feed.querySelector<HTMLElement>(`[data-message-id="${CSS.escape(anchor.dataset.messageId)}"]`);
      if (replacement) feed.scrollTop += replacement.getBoundingClientRect().top - feedTop - anchorOffset;
    }
    feed.querySelectorAll("[data-message-id]").forEach((item) => readObserver.observe(item));
    updateUnreadControls();
  }

  function isUnread(message: Message): boolean {
    return !message.removed && message.authorActivatorId !== activatorId && !seenMessages.has(message.id);
  }

  function restoreSeenMessages(): void {
    try {
      const stored: unknown = JSON.parse(localStorage.getItem(`activate-ri-2026:ops-seen:${activatorId}`) ?? "[]");
      seenMessages = new Set(Array.isArray(stored) ? stored.filter((id): id is string => typeof id === "string") : []);
    } catch {
      seenMessages = new Set();
    }
  }

  function scheduleSeenMessages(): void {
    window.clearTimeout(seenTimer);
    if (document.hidden || rulesDialog?.open || editDialog?.open) return;
    seenTimer = window.setTimeout(() => {
      if (document.hidden || rulesDialog?.open || editDialog?.open) return;
      const remembered = seenMessages;
      restoreSeenMessages();
      remembered.forEach((id) => seenMessages.add(id));
      visibleMessages.forEach((id) => {
        seenMessages.add(id);
        const item = feed?.querySelector<HTMLElement>(`[data-message-id="${CSS.escape(id)}"]`);
        if (item) item.dataset.unread = "false";
        item?.querySelector("[data-unread-label]")?.remove();
      });
      // Bound browser storage while retaining more than the recent feed window.
      seenMessages = new Set([...seenMessages].slice(-1000));
      try {
        localStorage.setItem(`activate-ri-2026:ops-seen:${activatorId}`, JSON.stringify([...seenMessages]));
      } catch { /* Reading the room still works when browser storage is unavailable. */ }
      updateUnreadControls();
    }, 1000);
  }

  function updateUnreadControls(): void {
    const count = [...messages.values()].filter(isUnread).length;
    const button = room?.querySelector<HTMLButtonElement>("[data-ops-unread]");
    if (button) {
      button.hidden = count === 0;
      button.textContent = `${count} unread`;
      button.setAttribute("aria-label", `Jump to unread (${count})`);
      button.title = "Unread messages are remembered on this browser";
    }
    room?.querySelector("[data-ops-unread-status]")?.replaceChildren(`${count} unread messages in recent room updates. Newest messages appear first.`);
  }

  room?.querySelector("[data-ops-unread]")?.addEventListener("click", () => {
    setFilter("all");
    updateFilterUrl();
    renderFeed();
    const target = feed?.querySelector<HTMLElement>('[data-unread="true"]');
    target?.scrollIntoView({ block: "nearest" });
    target?.focus({ preventScroll: true });
  });
  room?.querySelector("[data-ops-latest]")?.addEventListener("click", () => {
    if (feed) feed.scrollTop = 0;
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    for (const menu of feed?.querySelectorAll<HTMLDetailsElement>("details.ops-message__actions[open]") ?? []) {
      if (!menu.contains(event.target)) menu.open = false;
    }
  });
  feed?.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !(event.target instanceof Element)) return;
    const menu = event.target.closest<HTMLDetailsElement>("details.ops-message__actions[open]");
    if (!menu) return;
    menu.open = false;
    menu.querySelector("summary")?.focus();
    event.preventDefault();
  });

  function messageItem(message: Message, continuation = false): HTMLLIElement {
    const item = document.createElement("li");
    item.className = `ops-message ops-message--${message.kind}`;
    item.id = `ops-message-${message.id}`;
    item.dataset.messageId = message.id;
    item.dataset.unread = String(isUnread(message));
    item.dataset.continuation = String(continuation);
    item.tabIndex = -1;
    const own = message.authorActivatorId === activatorId;
    if (own) item.dataset.own = "true";
    const header = document.createElement("div");
    header.className = `ops-message__header${continuation ? " sr-only" : ""}`;
    const sender = document.createElement("span");
    sender.className = "ops-message__sender";
    const author = document.createElement("strong");
    author.textContent = message.authorType === "admin" ? "Organizer" : message.authorLabel;
    author.title = author.textContent;
    sender.appendChild(author);
    if (own) {
      const you = document.createElement("span");
      you.className = "ops-message__you";
      you.textContent = "You";
      sender.insertBefore(you, author);
    }
    const time = document.createElement("time");
    time.dateTime = message.createdAt;
    time.textContent = opsMessageTimeLabel(message.createdAt);
    time.title = `${formatTimestamp(message.createdAt)} Eastern time`;
    time.setAttribute("aria-label", time.title);
    header.appendChild(sender);
    header.appendChild(time);
    if (isUnread(message)) {
      const unread = document.createElement("span");
      unread.className = "ops-unread-label";
      unread.dataset.unreadLabel = "";
      unread.textContent = "New";
      header.appendChild(unread);
    }
    const body = document.createElement("p");
    body.className = "ops-message__body";
    body.textContent = message.body;
    const content = document.createElement("div");
    content.className = "ops-message__content";
    item.appendChild(header);
    content.appendChild(body);
    if (message.editedAt) {
      const edited = document.createElement("span");
      edited.className = "ops-message__edited";
      edited.textContent = "edited";
      edited.title = `Edited ${formatTimestamp(message.editedAt)} Eastern time`;
      content.appendChild(edited);
    }
    if (message.kind !== "chat" || message.parkReference || message.resolved) {
      const context = document.createElement("p");
      context.className = "ops-meta";
      const labels: string[] = [];
      if (message.kind !== "chat") labels.push(kindLabel(message.kind));
      if (message.parkReference) labels.push(`${message.parkReference} — ${parkNames[message.parkReference] ?? "RI park"}`);
      if (message.resolved) labels.push("Resolved");
      context.textContent = labels.join(" · ");
      context.title = context.textContent;
      if (continuation) context.classList.add("sr-only");
      content.appendChild(context);
    }
    item.appendChild(content);
    if (own) {
      const actions = document.createElement("details");
      actions.className = "ops-message__actions";
      const toggle = document.createElement("summary");
      toggle.textContent = "⋯";
      toggle.setAttribute("aria-label", "Message actions");
      toggle.title = "Message actions";
      actions.appendChild(toggle);
      const buttons = document.createElement("div");
      buttons.className = "ops-message__action-menu";
      if (canEditMessage(message)) {
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "button";
        edit.dataset.variant = "light";
        edit.dataset.action = "edit";
        edit.textContent = "Edit";
        edit.addEventListener("click", () => {
          actions.open = false;
          openMessageEditor(message.id);
        });
        buttons.appendChild(edit);
      }
      if (message.kind === "need-backup" || message.kind === "access-note") {
        buttons.appendChild(messageAction(message, message.resolved ? "Reopen" : "Resolve", message.resolved ? "reopen" : "resolve"));
      }
      buttons.appendChild(messageAction(message, "Remove", "remove"));
      actions.appendChild(buttons);
      item.appendChild(actions);
    }
    return item;
  }

  function renderPin(): void {
    if (!pin || !pinBody || !pinMeta) return;
    if (!pinnedMessage || pinnedMessage.removed) {
      pin.hidden = true;
      delete pin.dataset.opsExposureMessageId;
      return;
    }
    pin.hidden = false;
    pin.dataset.opsExposureMessageId = pinnedMessage.id;
    pinBody.textContent = pinnedMessage.body;
    pinMeta.textContent = `Organizer · ${formatTimestamp(pinnedMessage.createdAt)}${
      pinnedMessage.parkReference ? ` · ${pinnedMessage.parkReference} — ${parkNames[pinnedMessage.parkReference] ?? "RI park"}` : ""
    }`;
  }

  function updateRoomMode(mode: RoomMode): void {
    roomMode = mode;
    disableComposer(mode !== "full" || membershipStatus !== "active");
    updateEditAvailability();
    if (mode === "announcements") {
      setConnection("announcements", "Announcements only");
    } else if (mode === "off") {
      setConnection("unavailable", "Room unavailable");
      closeSocket(true);
    }
  }

  let draftRevision = 0;
  let draftWrites = Promise.resolve(true);
  let draftStorageAvailable = true;

  composer?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (sending || !kindSelect || !contextSelect || !bodyInput || !bodyInput.value.trim()) return;
    const draft: Draft = {
      clientNonce: composer.dataset.clientNonce || crypto.randomUUID(),
      kind: kindSelect.value,
      context: contextSelect.value,
      body: bodyInput.value,
    };
    composer.dataset.clientNonce = draft.clientNonce;
    const submittedRevision = draftRevision;
    const saved = saveDraft(draft);
    if (!navigator.onLine || socket?.readyState !== WebSocket.OPEN) {
      const persisted = await saved;
      if (draftRevision === submittedRevision) showUnsent("Not sent — review this draft after reconnecting.", persisted);
      return;
    }
    setSendState("Sending…");
    sending = true;
    sendButton && (sendButton.disabled = true);
    try {
      const response = await fetch("/api/activate-ri-2026/ops/messages", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          clientNonce: draft.clientNonce,
          kind: draft.kind,
          body: draft.body,
          context: contextPayload(draft.context),
        }),
      });
      const result = await response.json() as { event?: RoomEvent; error?: string; errors?: string[] };
      if (!response.ok || !result.event) {
        const persisted = await saved;
        if (draftRevision === submittedRevision) {
          showUnsent(result.errors?.join(" ") ?? result.error ?? "Not sent.", persisted);
        } else {
          setSendState("The previous message was not sent. Your new draft is still here.");
        }
        return;
      }
      applyEvent(result.event);
      if (result.event.type === "message-created" && !feed?.querySelector(`[data-message-id="${CSS.escape(result.event.message.id)}"]`)) {
        setFilter("all");
        updateFilterUrl();
        renderFeed();
      }
      if (feed) feed.scrollTop = 0;
      const unchanged = draftRevision === submittedRevision;
      if (unchanged) {
        bodyInput.value = "";
        if (composeOptions) composeOptions.open = false;
        delete composer.dataset.clientNonce;
        draftRevision += 1;
        void clearDraft(draft.clientNonce);
      }
      unsent && (unsent.hidden = true);
      setSendState(unchanged ? "Sent" : "Sent. Your new draft is still here.");
    } catch {
      const persisted = await saved;
      if (draftRevision === submittedRevision) {
        showUnsent("Not sent — check your connection and review before retrying.", persisted);
      } else {
        setSendState("The previous message was not confirmed. Your new draft is still here.");
      }
    } finally {
      sending = false;
      sendButton && (sendButton.disabled = roomMode !== "full" || membershipStatus !== "active");
    }
  });

  rulesDialog?.addEventListener("close", scheduleSeenMessages);
  editDialog?.addEventListener("close", () => {
    const id = editingMessageId;
    editingMessageId = null;
    if (editBody) editBody.value = "";
    editStatus?.replaceChildren();
    const item = id ? feed?.querySelector<HTMLElement>(`[data-message-id="${CSS.escape(id)}"]`) : null;
    (item?.querySelector<HTMLElement>("summary") ?? item ?? feed)?.focus({ preventScroll: true });
    scheduleSeenMessages();
  });
  editDialog?.addEventListener("cancel", (event) => {
    if (savingEdit) event.preventDefault();
  });
  editCancel?.addEventListener("click", () => {
    if (!savingEdit) editDialog?.close();
  });
  editForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (savingEdit || !editingMessageId || !editBody) return;
    const message = messages.get(editingMessageId);
    if (!message || !canEditMessage(message)) {
      updateEditAvailability();
      return;
    }
    const body = editBody.value.replace(/\r\n?/g, "\n").trim();
    if (!body) {
      editStatus?.replaceChildren("Enter a message.");
      return;
    }
    if (body === message.body) {
      editDialog?.close();
      return;
    }
    savingEdit = true;
    editStatus?.replaceChildren("Saving changes…");
    updateEditAvailability();
    try {
      const response = await fetch(`/api/activate-ri-2026/ops/messages/${encodeURIComponent(message.id)}/edit`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ body }),
      });
      const result = await response.json() as { event?: RoomEvent; error?: string; errors?: string[] };
      if (!response.ok || result.event?.type !== "message-edited") {
        editStatus?.replaceChildren(result.errors?.join(" ") ?? result.error ?? "Unable to save changes. Please try again.");
        return;
      }
      try {
        if (result.event.sequence > cursor + 1) {
          await catchUp(cursor, result.event.sequence - 1);
        }
        applyEvent(result.event);
      } catch {
        // The edit was saved. Reload the room without skipping missing events.
        void loadRoom();
      }
      editDialog?.close();
      room?.querySelector("[data-ops-edit-saved]")?.replaceChildren("Message updated.");
    } catch {
      editStatus?.replaceChildren("Unable to save changes. Check your connection and try again. Your edit is still here.");
    } finally {
      savingEdit = false;
      updateEditAvailability();
    }
  });

  filters?.addEventListener("change", () => {
    updateFilterUrl();
    renderFeed();
  });
  window.addEventListener("popstate", () => {
    restoreFilter();
    renderFeed();
  });

  bodyInput?.addEventListener("input", () => void saveComposerDraft());
  kindSelect?.addEventListener("change", () => {
    updateComposeSummary();
    void saveComposerDraft();
  });
  contextSelect?.addEventListener("change", () => {
    updateComposeSummary();
    void saveComposerDraft();
  });

  room?.querySelector("[data-ops-refresh]")?.addEventListener("click", () => void loadRoom());

  document.addEventListener("visibilitychange", () => {
    window.clearTimeout(hiddenCloseTimer);
    if (document.hidden) {
      setConnection("paused", "Paused while in background");
      hiddenCloseTimer = window.setTimeout(() => closeSocket(true), 30_000);
    } else {
      updateEditAvailability();
      scheduleSeenMessages();
      if (roomLoaded) connectSocket();
      else void loadRoom();
    }
  });
  window.addEventListener("offline", () => setConnection("offline", offlineLabel()));
  window.addEventListener("online", () => {
    closeSocket(true);
    if (roomLoaded) connectSocket();
    else void loadRoom();
  });
  window.addEventListener("beforeunload", () => { stopEngagement?.(); closeSocket(true); });
  window.addEventListener("activate-ri:logout", () => {
    stopEngagement?.();
    localStorage.removeItem(cursorKey);
    localStorage.removeItem("activate-ri-ops-filter");
    void clearDraft();
    closeSocket(true);
  });

  function quickAction(label: string, kind: string, stopId: string): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "button";
    button.dataset.variant = "light";
    button.textContent = label;
    button.addEventListener("click", () => {
      if (kindSelect) kindSelect.value = kind;
      if (contextSelect) contextSelect.value = `stop:${stopId}`;
      if (composeOptions) composeOptions.open = true;
      updateComposeSummary();
      void saveComposerDraft();
      bodyInput?.focus();
    });
    return button;
  }

  function canEditMessage(message: Message): boolean {
    return message.authorType === "activator" && message.authorActivatorId === activatorId &&
      !message.removed && membershipStatus === "active" && roomMode === "full" &&
      isOpsMessageWithinEditWindow(message.createdAt);
  }

  function openMessageEditor(id: string): void {
    const message = messages.get(id);
    if (!message || !editDialog || !editBody || !canEditMessage(message)) {
      updateEditAvailability();
      return;
    }
    editingMessageId = id;
    editBody.value = message.body;
    editStatus?.replaceChildren();
    room?.querySelector("[data-ops-edit-saved]")?.replaceChildren();
    editDialog.showModal();
    updateEditAvailability();
    editBody.focus();
    editBody.setSelectionRange(editBody.value.length, editBody.value.length);
  }

  function updateEditAvailability(): void {
    window.clearTimeout(editExpiryTimer);
    for (const button of feed?.querySelectorAll<HTMLButtonElement>('[data-action="edit"]') ?? []) {
      const message = messages.get(button.closest<HTMLElement>("[data-message-id]")?.dataset.messageId ?? "");
      if (message && canEditMessage(message)) continue;
      if (document.activeElement === button) button.closest("details")?.querySelector("summary")?.focus();
      button.remove();
    }
    const message = editingMessageId ? messages.get(editingMessageId) : undefined;
    if (editSave) editSave.disabled = savingEdit || !message || !canEditMessage(message);
    if (editBody) editBody.readOnly = savingEdit;
    if (editCancel) editCancel.disabled = savingEdit;
    if (editDialog?.open && !savingEdit) {
      if (!message || message.removed) editStatus?.replaceChildren("This message was removed and can no longer be edited.");
      else if (!isOpsMessageWithinEditWindow(message.createdAt)) editStatus?.replaceChildren("The 20-minute editing window has ended. You can copy your changes before closing.");
      else if (!canEditMessage(message)) editStatus?.replaceChildren("Editing is currently unavailable in this room.");
    }
    const deadlines = [...messages.values()].filter(canEditMessage)
      .map((message) => Date.parse(message.createdAt) + OPS_MESSAGE_EDIT_WINDOW_MS);
    if (deadlines.length) {
      editExpiryTimer = window.setTimeout(updateEditAvailability, Math.max(1, Math.min(...deadlines) - Date.now()));
    }
  }

  function messageAction(message: Message, label: string, action: string): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "button";
    button.dataset.variant = "light";
    button.textContent = label;
    button.dataset.action = action;
    button.addEventListener("click", async () => {
      button.disabled = true;
      try {
        const response = await fetch(`/api/activate-ri-2026/ops/messages/${encodeURIComponent(message.id)}/${action}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: "{}",
        });
        const result = await response.json() as { event?: RoomEvent };
        if (response.ok && result.event) applyEvent(result.event);
      } finally {
        button.disabled = false;
      }
    });
    return button;
  }

  function contextPayload(value: string): null | { type: "stop"; stopId: string } | { type: "park"; parkReference: string } {
    if (value.startsWith("stop:")) return { type: "stop", stopId: value.slice(5) };
    if (value.startsWith("park:")) return { type: "park", parkReference: value.slice(5) };
    return null;
  }

  function stopLabel(stop: Stop): string {
    return `${stop.parkReference} — ${parkNames[stop.parkReference] ?? "RI park"} — ${stopTimeLabel(stop)}`;
  }

  function stopTimeLabel(stop: Stop): string {
    const start = new Date(stop.startAt);
    const end = new Date(stop.endAt);
    const date = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/New_York",
      weekday: "short",
      hour: "numeric",
      minute: "2-digit",
    }).format(start);
    const endTime = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/New_York",
      hour: "numeric",
      minute: "2-digit",
    }).format(end);
    return `${date}–${endTime}`;
  }

  function formatTimestamp(value: string): string {
    return new Intl.DateTimeFormat("en-US", {
      timeZone: "America/New_York",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    }).format(new Date(value));
  }

  function kindLabel(kind: MessageKind): string {
    return ({
      chat: "Coordination",
      "access-note": "Access note",
      "running-late": "Running late",
      "need-backup": "Backup needed",
      announcement: "Announcement",
      system: "System",
    } as Record<MessageKind, string>)[kind];
  }

  function selectedFilter(): string {
    return room?.querySelector<HTMLInputElement>('input[name="ops-filter"]:checked')?.value ?? "all";
  }

  function restoreFilter(): void {
    setFilter(new URL(window.location.href).searchParams.get("ops-filter") ?? "all");
    updateFilterUrl("replace");
  }

  function setFilter(value: string): void {
    const inputs = [...room?.querySelectorAll<HTMLInputElement>('input[name="ops-filter"]') ?? []];
    const selected = inputs.find((input) => input.value === value)
      ?? inputs.find((input) => input.value === "all");
    if (selected) selected.checked = true;
  }

  function updateFilterUrl(mode: "push" | "replace" = "push"): void {
    const url = new URL(window.location.href);
    const filter = selectedFilter();
    if (filter === "all") url.searchParams.delete("ops-filter");
    else url.searchParams.set("ops-filter", filter);
    if (url.href === window.location.href) return;
    if (mode === "replace") history.replaceState(history.state, "", url);
    else history.pushState(history.state, "", url);
  }

  function setConnection(state: string, label: string): void {
    if (connection) connection.dataset.state = state;
    connectionLabel?.replaceChildren(label);
  }

  function markSynchronized(): void {
    lastSynchronizedAt = new Date();
    setConnection(roomMode === "announcements" ? "announcements" : "live",
      roomMode === "announcements" ? "Announcements only" : "Live");
  }

  function offlineLabel(): string {
    return lastSynchronizedAt
      ? `Offline — last synchronized at ${lastSynchronizedAt.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })}`
      : "Offline";
  }

  function disableComposer(disabled: boolean): void {
    const controls = Array.from(
      composer?.querySelectorAll("input, select, textarea, button") ?? [],
    ) as Array<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement>;
    controls.forEach((control) => control.disabled = disabled);
    if (!disabled && sendState && ["Posting unavailable.", "Participant posting is paused.", "You can read the room, but posting is muted."].includes(sendState.textContent ?? "")) {
      sendState.replaceChildren();
    }
    if (disabled && sendState) {
      sendState.textContent = membershipStatus === "muted"
        ? "You can read the room, but posting is muted."
        : roomMode === "announcements"
        ? "Participant posting is paused."
        : "Posting unavailable.";
    }
  }

  function setSendState(value: string): void {
    sendState?.replaceChildren(value);
  }

  function showUnsent(value: string, saved = true): void {
    setSendState(value);
    if (unsent) {
      unsent.hidden = false;
      unsent.querySelector("p")?.replaceChildren(saved
        ? "Your draft is saved on this device. Review it and press Send when you are ready."
        : "Your draft is only in this tab because device storage is unavailable. Keep this page open or copy your message before leaving.");
    }
  }

  function scheduleReconnect(): void {
    window.clearTimeout(retryTimer);
    if (document.hidden || !navigator.onLine || (roomLoaded && roomMode === "off")) return;
    const base = retryDelays[Math.min(retryAttempt, retryDelays.length - 1)];
    const jitter = Math.round(base * (Math.random() * 0.3 - 0.15));
    retryAttempt += 1;
    retryTimer = window.setTimeout(() => roomLoaded ? connectSocket() : void loadRoom(), base + jitter);
  }

  function closeSocket(intentional: boolean): void {
    intentionalClose = intentional;
    socket?.close(1000, "Paused");
    socket = null;
  }

  function emptyItem(title: string, detail?: string): HTMLLIElement {
    const item = document.createElement("li");
    item.className = "ops-empty ops-empty--room";
    const strong = document.createElement("strong");
    strong.textContent = title;
    item.appendChild(strong);
    if (detail) {
      const span = document.createElement("span");
      span.textContent = detail;
      item.appendChild(span);
    }
    return item;
  }

  function updateComposeSummary(): void {
    if (!composeOptionsSummary) return;
    if (kindSelect?.value === "chat" && !contextSelect?.value) {
      composeOptionsSummary.textContent = "Add park or update type";
      return;
    }
    const kind = kindSelect?.selectedOptions[0]?.textContent?.trim() || "General update";
    const context = contextSelect?.selectedOptions[0]?.textContent?.trim() || "No park context";
    composeOptionsSummary.textContent = `${kind} · ${context}`;
  }

  function emptyParagraph(text: string): HTMLParagraphElement {
    const paragraph = document.createElement("p");
    paragraph.className = "ops-empty";
    paragraph.textContent = text;
    return paragraph;
  }

  function isHello(value: unknown): value is { type: "hello"; highWatermark: number; roomMode: RoomMode } {
    return typeof value === "object" && value !== null &&
      (value as { type?: unknown }).type === "hello" &&
      Number.isSafeInteger((value as { highWatermark?: unknown }).highWatermark) &&
      ["full", "announcements", "off"].includes(String((value as { roomMode?: unknown }).roomMode));
  }

  function isRoomEvent(value: unknown): value is RoomEvent {
    return typeof value === "object" && value !== null &&
      Number.isSafeInteger((value as { sequence?: unknown }).sequence) &&
      typeof (value as { type?: unknown }).type === "string";
  }

  function isMembershipControl(value: unknown): value is {
    type: "membership-changed";
    status: MembershipStatus;
  } {
    return typeof value === "object" && value !== null &&
      (value as { type?: unknown }).type === "membership-changed" &&
      ["active", "muted", "banned"].includes(String((value as { status?: unknown }).status));
  }

  async function restoreDraft(): Promise<void> {
    const result = await draftOperation<Draft | undefined>("readonly", (store) => store.get("current"));
    const draft = result.value;
    if (!result.ok || !draft || draftRevision > 0 || !composer || !kindSelect || !contextSelect || !bodyInput || bodyInput.value) return;
    kindSelect.value = draft.kind;
    contextSelect.value = draft.context;
    bodyInput.value = draft.body;
    composer.dataset.clientNonce = draft.clientNonce;
    composeOptions && (composeOptions.open = true);
    updateComposeSummary();
    showUnsent("Not sent — review this saved draft before sending.");
  }

  async function saveComposerDraft(): Promise<void> {
    if (!composer || !kindSelect || !contextSelect || !bodyInput) return;
    const revision = ++draftRevision;
    delete composer.dataset.clientNonce;
    unsent && (unsent.hidden = true);
    const body = bodyInput.value;
    if (!sending) setSendState(body.trim() ? "Saving draft…" : "");
    let saved: boolean;
    if (body.trim()) {
      const clientNonce = crypto.randomUUID();
      composer.dataset.clientNonce = clientNonce;
      saved = await saveDraft({ clientNonce, kind: kindSelect.value, context: contextSelect.value, body });
    } else {
      saved = await clearDraft();
    }
    if (revision !== draftRevision || sending) return;
    setSendState(saved
      ? body.trim() ? "Draft saved on this device." : ""
      : "Device storage is unavailable. Keep this tab open or copy your draft before leaving.");
  }

  function saveDraft(draft: Draft): Promise<boolean> {
    draftWrites = draftWrites.then(async () => (await draftOperation("readwrite", (store) => store.put(draft, "current"))).ok);
    return draftWrites;
  }

  function clearDraft(expectedNonce?: string): Promise<boolean> {
    draftWrites = draftWrites.then(async () => (await draftOperation("readwrite", (store) => {
      if (!expectedNonce) return store.delete("current");
      const current = store.get("current");
      current.addEventListener("success", () => {
        if (current.result?.clientNonce === expectedNonce) store.delete("current");
      });
      return current;
    })).ok);
    return draftWrites;
  }

  function draftOperation<T>(
    mode: IDBTransactionMode,
    operation: (store: IDBObjectStore) => IDBRequest<T>,
  ): Promise<{ ok: boolean; value?: T }> {
    if (!draftStorageAvailable) return Promise.resolve({ ok: false });
    return new Promise((resolve) => {
      let database: IDBDatabase | undefined;
      let finished = false;
      const finish = (result: { ok: boolean; value?: T }): void => {
        if (finished) return;
        finished = true;
        if (!result.ok) draftStorageAvailable = false;
        window.clearTimeout(timeout);
        database?.close();
        resolve(result);
      };
      const timeout = window.setTimeout(() => finish({ ok: false }), 2000);
      try {
        const open = indexedDB.open("activate-ri-ops", 1);
        open.addEventListener("upgradeneeded", () => {
          if (!open.result.objectStoreNames.contains("drafts")) {
            open.result.createObjectStore("drafts");
          }
        });
        open.addEventListener("error", () => finish({ ok: false }));
        open.addEventListener("blocked", () => finish({ ok: false }));
        open.addEventListener("success", () => {
          database = open.result;
          if (finished) { database.close(); return; }
          try {
            const transaction = database.transaction("drafts", mode);
            const request = operation(transaction.objectStore("drafts"));
            transaction.addEventListener("complete", () => finish({ ok: true, value: request.result }));
            transaction.addEventListener("abort", () => finish({ ok: false }));
            transaction.addEventListener("error", () => finish({ ok: false }));
          } catch { finish({ ok: false }); }
        });
      } catch { finish({ ok: false }); }
    });
  }
</script>
