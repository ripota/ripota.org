---
import AccountIdentity from "./AccountIdentity.astro";
import CommunityByline from "./CommunityByline.astro";
import PasskeyManager from "./PasskeyManager.astro";
import SessionManager from "./SessionManager.astro";

interface Props {
  eyebrow?: string;
}

const { eyebrow = "RI POTA account" } = Astro.props;
---

<div class="section-header">
  <p class="eyebrow">{eyebrow}</p>
  <h1 id="security-title">Account security</h1>
  <p>Manage your passkeys and signed-in browsers.</p>
  <p data-account-admin-guidance hidden>Administrator actions require signing in with a passkey.</p>
</div>
<div class="account-settings">
  <AccountIdentity />
  <CommunityByline />
  <slot name="before-passkeys" />
  <PasskeyManager />
  <SessionManager />
</div>

<style>
  .account-settings {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
</style>
