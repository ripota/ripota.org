---
import type { CatalogRecord } from "@ripota/parks/types";

interface Props {
  park: Pick<CatalogRecord, "reference" | "name" | "latitude" | "longitude">;
  variant?: "hero" | "visit";
}

const { park, variant = "visit" } = Astro.props;
const hasCoordinates = Number.isFinite(park.latitude) && Number.isFinite(park.longitude);
const coordinates = `${park.latitude}, ${park.longitude}`;
const mapQuery = encodeURIComponent(`${park.latitude},${park.longitude}`);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
// This Apple Maps URL also works on versions before the newer /place URLs.
const appleMapsUrl = `https://maps.apple.com/?ll=${mapQuery}&q=${encodeURIComponent(`${park.reference} · ${park.name}`)}`;
---

{hasCoordinates && (
  <div class="park-coordinates" data-park-coordinates data-variant={variant}>
    <p class="park-coordinates__label">POTA GPS coordinates</p>
    <div class="park-coordinates__row">
      <p class="park-coordinates__value">{coordinates}</p>
      <span class="park-coordinates__maps">
        <a
          href={googleMapsUrl}
          aria-label={`Open ${park.reference} POTA coordinates in Google Maps`}
          title="Open in Google Maps"
          rel="noreferrer"
        ><img src="/assets/icons/google-maps.png" width="24" height="24" alt="" /></a>
        <a
          href={appleMapsUrl}
          aria-label={`Open ${park.reference} POTA coordinates in Apple Maps`}
          title="Open in Apple Maps"
          rel="noreferrer"
        ><img src="/assets/icons/apple-maps.png" width="24" height="24" alt="" /></a>
      </span>
    </div>
  </div>
)}

<style>
  .park-coordinates {
    width: fit-content;
    max-width: 100%;
    border-left: 3px solid var(--link-strong);
    border-radius: 0 6px 6px 0;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--surface-raised);
    color: var(--text-primary);
  }

  .park-coordinates p {
    margin: 0;
  }

  .park-coordinates__label {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .park-coordinates__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-top: 0.25rem;
  }

  .park-coordinates__value {
    font-size: 1rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .park-coordinates__maps {
    display: inline-flex;
    gap: 0.35rem;
  }

  .park-coordinates__maps a {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    background: #fff;
  }

  .park-coordinates__maps a:hover {
    border-color: var(--link-strong);
    box-shadow: 0 0 0 1px var(--link-strong);
  }

  .park-coordinates__maps a:focus-visible {
    outline: 2px solid var(--link-strong);
    outline-offset: 3px;
  }

  .park-coordinates__maps img {
    width: 24px;
    height: 24px;
    border-radius: 5px;
    object-fit: contain;
  }

  .park-coordinates[data-variant="hero"] {
    border: 0;
    margin-top: 1rem;
    padding: 0;
    background: transparent;
    color: var(--text-on-hero);
  }

  [data-variant="hero"] .park-coordinates__label {
    color: color-mix(in srgb, var(--text-on-hero) 72%, transparent);
    font-size: 0.7rem;
  }

  [data-variant="hero"] .park-coordinates__value {
    font-size: 0.83rem;
  }

  [data-variant="hero"] .park-coordinates__maps a:focus-visible {
    outline-color: var(--accent);
  }
</style>
