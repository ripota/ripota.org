---
import "leaflet/dist/leaflet.css";
import { getDisplayReference } from "@ripota/parks/display";
import type { CatalogRecord } from "@ripota/parks/types";
import {
  getCanonicalGeometryUrl,
  getWebGeometry,
} from "../../lib/pota/geometry-assets";

type ParkMapReference = Pick<
  CatalogRecord,
  "reference" | "name" | "latitude" | "longitude" | "geometryKind"
>;

type Props = {
  id: string;
  park: ParkMapReference;
  relatedParks?: readonly ParkMapReference[];
};

const { id, park, relatedParks = [] } = Astro.props;
const dataId = `${id}-data`;
const locationStatusId = `${id}-location-status`;
function mapPayload(reference: ParkMapReference) {
  const display = getDisplayReference(reference.reference);
  if (!display) throw new Error(`Missing display metadata for ${reference.reference}`);
  return {
    reference: reference.reference,
    name: reference.name,
    latitude: reference.latitude,
    longitude: reference.longitude,
    geometryKind: reference.geometryKind,
    displayPoint: display.displayPoint,
    bbox: display.bbox,
    geojson: getWebGeometry(reference.reference),
    canonicalGeometryUrl: getCanonicalGeometryUrl(reference.reference),
  };
}
const payload = JSON.stringify({
  park: mapPayload(park),
  relatedParks: relatedParks.map(mapPayload),
});
const primaryMapLabel = {
  boundary: "mapped area",
  "activation-zone": "mapped area",
  point: "reference location",
}[park.geometryKind];
---

<figure
  class="park-detail-map"
  aria-label={`Detailed ${primaryMapLabel} map for ${park.name}`}
  data-park-detail-map-shell
>
  <div
    id={id}
    class="park-detail-map__canvas"
    data-park-detail-map
    data-map-data-id={dataId}
  ></div>

  <div class="park-detail-map__key" aria-label="Map key">
    <p>Map</p>
    <span class="park-detail-map__key-row">
      <span
        class="park-detail-map__swatch park-detail-map__swatch--primary"
        data-geometry-kind={park.geometryKind}
      ></span>
      <span><strong>{park.reference}</strong> {primaryMapLabel}</span>
    </span>
    {
      relatedParks.map((relatedPark) => (
        <label class="park-detail-map__key-row">
          <input
            type="checkbox"
            checked
            data-related-boundary-toggle={relatedPark.reference}
          />
          <span class="park-detail-map__swatch park-detail-map__swatch--related"></span>
          <span><strong>{relatedPark.reference}</strong> overlap</span>
        </label>
      ))
    }
    <button type="button" data-park-map-reset>Recenter map</button>
  </div>

  <button
    class="park-detail-map__location-button"
    type="button"
    aria-label="Show my location"
    aria-controls={locationStatusId}
    aria-pressed="false"
    data-park-map-location
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="6"></circle>
      <circle cx="12" cy="12" r="2"></circle>
      <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
    </svg>
  </button>

  <div
    class="park-detail-map__mode-controls"
    aria-label="Location mode controls"
    data-park-location-mode-controls
    hidden
  >
    <span class="park-detail-map__mode-label">
      <span aria-hidden="true"></span>
      Location mode
    </span>
    <strong>{park.reference} · {park.name}</strong>
    <span class="park-detail-map__mode-actions">
      <a href="/parks/?location=1" data-park-location-return>← Back to all parks</a>
      <button type="button" data-park-location-stop>
        Exit location mode <span aria-hidden="true">×</span>
      </button>
    </span>
  </div>

  <div
    id={locationStatusId}
    class="park-detail-map__location-status"
    data-park-location-status
    data-tone="neutral"
    hidden
  >
    <div class="park-detail-map__location-message" role="status" aria-live="polite" aria-atomic="true">
      <span class="park-detail-map__location-shape" data-location-status-shape aria-hidden="true"></span>
      <span>
        <strong data-location-status-primary></strong>
        <small data-location-status-secondary></small>
      </span>
    </div>
  </div>

  <figcaption class="sr-only">
    The highlighted {primaryMapLabel} is the local map geometry for {park.name}.
    A dashed line marks another reference when it uses the same mapped source
    features. Text details and source links follow the map.
  </figcaption>
</figure>

<script is:inline type="application/json" id={dataId} set:html={payload} />

<script>
  import L from "leaflet";
  import type { CatalogRecord, DisplayReference } from "@ripota/parks/types";
  import { classifyLocation } from "../../lib/location/classify";
  import type {
    LocationClassification,
    ReportedLocation,
  } from "../../lib/location/classify";
  import {
    createLocationSession,
  } from "../../lib/location/session";
  import type {
    LocationSessionError,
    LocationSessionState,
  } from "../../lib/location/session";
  import {
    createCanonicalGeometryLoader,
    createGeometryClassificationRequest,
    requireCanonicalGeometry,
    type CanonicalGeometry,
  } from "../../lib/location/canonical-geometry";

  type ParkMapReference = Pick<
    CatalogRecord,
    "reference" | "name" | "latitude" | "longitude" | "geometryKind"
  > & {
    displayPoint: DisplayReference["displayPoint"];
    bbox?: DisplayReference["bbox"];
    geojson: GeoJSON.FeatureCollection;
    canonicalGeometryUrl: string;
  };

  type ParkMapPayload = {
    park: ParkMapReference;
    relatedParks: ParkMapReference[];
  };

  type StatusTone = "inside" | "outside" | "uncertain" | "neutral";

  type ClassifiedReference = {
    park: ParkMapReference;
    result: LocationClassification;
  };

  function geometrySubject(geometryKind: ParkMapReference["geometryKind"]): string {
    return geometryKind === "activation-zone"
      ? "mapped activation zone"
      : "mapped boundary";
  }

  function accuracyCopy(accuracy: number): string {
    return `Accuracy ±${Math.round(accuracy)} m`;
  }

  function errorCopy(error: LocationSessionError): [string, string] {
    switch (error) {
      case "permission-denied":
        return [
          "Location access is off",
          "Enable it in browser settings, then try again.",
        ];
      case "timeout":
        return [
          "Location took too long",
          "Move to an open area or try again.",
        ];
      case "unsupported":
        return [
          "Location is not available in this browser",
          "The park map and its normal controls still work.",
        ];
      default:
        return [
          "Your device could not get a location",
          "Check your signal and try again.",
        ];
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-park-detail-map]")
    .forEach(setupParkDetailMap);

  function setupParkDetailMap(mapElement: HTMLElement): void {
    if (mapElement.dataset.mapReady === "true") {
      return;
    }

    const dataElement = document.getElementById(mapElement.dataset.mapDataId ?? "");
    const shell = mapElement.closest<HTMLElement>("[data-park-detail-map-shell]");
    if (!dataElement || !shell) {
      return;
    }

    mapElement.dataset.mapReady = "true";
    const payload = JSON.parse(dataElement.textContent ?? "{}") as ParkMapPayload;
    const parkMapPoint = payload.park.displayPoint;
    const references = [payload.park, ...payload.relatedParks];
    const canonicalLoaders = references.map((park) => ({
      reference: park.reference,
      load: createCanonicalGeometryLoader(park.canonicalGeometryUrl, {
        expectedReferences: [park.reference],
      }),
    }));
    const map = L.map(mapElement, {
      attributionControl: true,
      scrollWheelZoom: false,
      wheelPxPerZoomLevel: 120,
      zoomControl: false,
      zoomSnap: 0.25,
    });

    L.control
      .zoom({
        position: "bottomright",
        zoomInTitle: "Zoom in on the mapped area",
        zoomOutTitle: "Zoom out from the mapped area",
      })
      .addTo(map);

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    map.setView([parkMapPoint.latitude, parkMapPoint.longitude], 13);

    const pointStyle = {
      color: "#fffaf0",
      fillColor: "#18312f",
      fillOpacity: 1,
      opacity: 1,
      radius: 6,
      weight: 2,
    };

    const primaryLayer = L.geoJSON(payload.park.geojson, {
      style: {
        color: "#6f4618",
        fillColor: "#d39a50",
        fillOpacity: 0.3,
        opacity: 1,
        weight: 3,
      },
      pointToLayer: (_feature, latlng) => L.circleMarker(latlng, pointStyle),
    })
      .bindTooltip(`${payload.park.reference} · ${payload.park.name}`, {
        direction: "top",
        sticky: true,
      })
      .addTo(map);

    const relatedLayers = new Map<string, L.GeoJSON>();
    for (const relatedPark of payload.relatedParks) {
      const layer = L.geoJSON(relatedPark.geojson, {
        style: {
          color: "#0b6670",
          dashArray: "8 7",
          fill: false,
          opacity: 0.95,
          weight: 5,
        },
      })
        .bindTooltip(`${relatedPark.reference} · ${relatedPark.name}`, {
          direction: "top",
          sticky: true,
        })
        .addTo(map);
      relatedLayers.set(relatedPark.reference, layer);
    }

    if (payload.park.geometryKind !== "point") {
      L.circleMarker(
        [parkMapPoint.latitude, parkMapPoint.longitude],
        pointStyle,
      )
        .bindTooltip(parkMapPoint.source === "official" ? "POTA reference coordinate" : "Park map point", {
          direction: "top",
        })
        .addTo(map);
    }

    const maxFitZoom = payload.park.geometryKind === "point" ? 14 : 18;
    const parkBounds = payload.park.bbox
      ? L.latLngBounds(
          [payload.park.bbox[1], payload.park.bbox[0]],
          [payload.park.bbox[3], payload.park.bbox[2]],
        )
      : primaryLayer.getBounds();

    const locationLayers = L.layerGroup().addTo(map);
    let accuracyLayer: L.Circle | undefined;
    let locationDot: L.CircleMarker | undefined;
    let latestLocation: ReportedLocation | undefined;
    let centeredOnFirstFix = false;
    const parkHero = shell.closest<HTMLElement>(".park-hero");

    const locationButton = shell.querySelector<HTMLButtonElement>(
      "[data-park-map-location]",
    );
    const locationStatus = shell.querySelector<HTMLElement>(
      "[data-park-location-status]",
    );
    const locationPrimary = shell.querySelector<HTMLElement>(
      "[data-location-status-primary]",
    );
    const locationSecondary = shell.querySelector<HTMLElement>(
      "[data-location-status-secondary]",
    );
    const locationModeControls = shell.querySelector<HTMLElement>(
      "[data-park-location-mode-controls]",
    );
    const stopLocationButton = shell.querySelector<HTMLButtonElement>(
      "[data-park-location-stop]",
    );
    const returnToParksLink = shell.querySelector<HTMLAnchorElement>(
      "[data-park-location-return]",
    );
    const navigationParams = new URLSearchParams(window.location.search);
    if (navigationParams.get("from") === "parks-map") {
      window.history.scrollRestoration = "manual";
    }

    const showStatus = (
      primary: string,
      secondary: string,
      tone: StatusTone,
    ): void => {
      if (!locationStatus || !locationPrimary || !locationSecondary) return;

      locationStatus.hidden = false;
      locationStatus.dataset.tone = tone;
      locationPrimary.textContent = primary;
      locationSecondary.textContent = secondary;
    };

    const clearLocationLayers = (): void => {
      locationLayers.clearLayers();
      accuracyLayer = undefined;
      locationDot = undefined;
    };

    const afterLayout = (callback: () => void): void => {
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(callback);
      });
    };

    const setLocationMode = (active: boolean): void => {
      if (active) {
        map.scrollWheelZoom.enable();
        shell.dataset.locationMode = "active";
        parkHero?.setAttribute("data-location-mode", "active");
      } else {
        map.scrollWheelZoom.disable();
        delete shell.dataset.locationMode;
        parkHero?.removeAttribute("data-location-mode");
      }
      if (locationModeControls) locationModeControls.hidden = !active;
      afterLayout(() => map.invalidateSize({ animate: false }));
    };

    const fitLocationContext = (): void => {
      if (!latestLocation) return;

      afterLayout(() => {
        if (!latestLocation) return;

        map.invalidateSize({ animate: false });
        const location = L.latLng(
          latestLocation.latitude,
          latestLocation.longitude,
        );
        const bounds = accuracyLayer?.getBounds() ?? L.latLngBounds(location, location);
        if (parkBounds.isValid()) bounds.extend(parkBounds);

        const wideLayout = window.matchMedia("(min-width: 861px)").matches;
        const mapSize = map.getSize();
        map.fitBounds(bounds, {
          animate: true,
          maxZoom: 16,
          paddingTopLeft: wideLayout
            ? [Math.min(380, mapSize.x * 0.34), 120]
            : [24, 104],
          paddingBottomRight: wideLayout
            ? [Math.min(420, mapSize.x * 0.38), 130]
            : [24, Math.min(180, mapSize.y * 0.42)],
        });
      });
    };

    const showClassification = (location: ReportedLocation, geometry: CanonicalGeometry): void => {
      const classified: ClassifiedReference[] = references.map((park) => ({
        park,
        result: classifyLocation(location, requireCanonicalGeometry(geometry, park.reference), park.geometryKind),
      }));
      const primary = classified[0];
      if (!primary) return;

      const definiteInside = classified.filter(
        ({ result }) => result.status === "inside",
      );

      if (definiteInside.length > 1) {
        showStatus(
          `Inside ${definiteInside.length} mapped areas`,
          `${definiteInside.map(({ park }) => park.reference).join(", ")} · ${accuracyCopy(location.accuracy)}`,
          "inside",
        );
        return;
      }

      if (
        definiteInside.length === 1 &&
        definiteInside[0]?.park.reference !== payload.park.reference
      ) {
        showStatus(
          `Inside ${definiteInside[0]?.park.reference} mapped area`,
          `${payload.park.reference}: ${primary.result.status.replace("near-boundary", "near boundary")} · ${accuracyCopy(location.accuracy)}`,
          "inside",
        );
        return;
      }

      const subject = geometrySubject(payload.park.geometryKind);
      switch (primary.result.status) {
        case "inside":
          showStatus(
            `Inside ${subject}`,
            accuracyCopy(location.accuracy),
            "inside",
          );
          break;
        case "outside":
          showStatus(
            `Outside ${subject}`,
            accuracyCopy(location.accuracy),
            "outside",
          );
          break;
        case "near-boundary":
          showStatus(
            `Near ${subject}`,
            `Your ${accuracyCopy(location.accuracy).toLowerCase()} crosses the mapped edge.`,
            "uncertain",
          );
          break;
        case "unavailable":
          showStatus(
            "No mapped boundary available",
            `This park has only a reference coordinate · ${accuracyCopy(location.accuracy)}`,
            "neutral",
          );
          break;
      }
    };

    const updateLocationLayers = (location: ReportedLocation): void => {
      const latlng = L.latLng(location.latitude, location.longitude);

      if (!accuracyLayer) {
        accuracyLayer = L.circle(latlng, {
          radius: location.accuracy,
          color: "#1267a5",
          fillColor: "#4ca7e8",
          fillOpacity: 0.16,
          opacity: 0.65,
          weight: 1.5,
          interactive: false,
        }).addTo(locationLayers);
      } else {
        accuracyLayer.setLatLng(latlng).setRadius(location.accuracy);
      }

      if (!locationDot) {
        locationDot = L.circleMarker(latlng, {
          radius: 8,
          color: "#ffffff",
          fillColor: "#1577c8",
          fillOpacity: 1,
          opacity: 1,
          weight: 3,
          interactive: false,
        }).addTo(locationLayers);
      } else {
        locationDot.setLatLng(latlng);
      }
    };

    const handleSessionState = (state: LocationSessionState): void => {
      if (locationButton) {
        const active = state.status === "requesting" || state.status === "active";
        locationButton.ariaPressed = String(active);
        locationButton.dataset.state = state.status;
        locationButton.ariaLabel =
          state.status === "active"
            ? "Recenter on my location"
            : state.status === "requesting"
              ? "Finding your location"
              : "Show my location";
      }

      switch (state.status) {
        case "requesting":
          classificationRequest.invalidate();
          setLocationMode(true);
          showStatus(
            "Finding your location…",
            "Used on this device; not saved or sent to RI POTA. Map tiles load from OpenStreetMap.",
            "neutral",
          );
          break;
        case "stopped":
          classificationRequest.invalidate();
          latestLocation = undefined;
          centeredOnFirstFix = false;
          clearLocationLayers();
          if (locationStatus) locationStatus.hidden = true;
          setLocationMode(false);
          afterLayout(resetView);
          break;
        case "error": {
          classificationRequest.invalidate();
          latestLocation = undefined;
          const [primary, secondary] = errorCopy(state.error);
          showStatus(primary, secondary, "outside");
          break;
        }
      }
    };

    const classificationRequest = createGeometryClassificationRequest({
      load: async () => {
        const geometry = new Map<string, GeoJSON.FeatureCollection>();
        await Promise.all(canonicalLoaders.map(async ({ reference, load }) => {
          geometry.set(reference, requireCanonicalGeometry(await load(), reference));
        }));
        return geometry;
      },
      onLoading: () => showStatus(
        "Loading mapped boundaries…",
        "Your location is shown; boundary checks are not ready yet.",
        "neutral",
      ),
      onError: () => showStatus(
        "Mapped boundaries could not load",
        "Your location is shown. Use the location button to try again.",
        "neutral",
      ),
      onReady: (geometry, location) => showClassification(location, geometry),
    });

    const locationSession = createLocationSession({
      onStateChange: handleSessionState,
      onPosition: (location) => {
        latestLocation = location;
        updateLocationLayers(location);
        classificationRequest.request(location);
        if (!centeredOnFirstFix) {
          centeredOnFirstFix = true;
          fitLocationContext();
        }
      },
    });

    const resetView = (): void => {
      const wideLayout = window.matchMedia("(min-width: 861px)").matches;
      map.invalidateSize({ animate: false });
      map.fitBounds(parkBounds, {
        animate: false,
        maxZoom: maxFitZoom,
        paddingBottomRight: [48, 48],
        paddingTopLeft: wideLayout ? [Math.min(560, window.innerWidth * 0.43), 128] : [32, 176],
      });
    };

    resetView();
    window.requestAnimationFrame(resetView);

    shell.querySelector<HTMLButtonElement>("[data-park-map-reset]")?.addEventListener(
      "click",
      resetView,
    );

    locationButton?.addEventListener("click", () => {
      if (locationSession.getState().status === "active" && latestLocation) {
        classificationRequest.request(latestLocation);
        fitLocationContext();
      } else {
        locationSession.start();
      }
    });

    stopLocationButton?.addEventListener("click", () => {
      locationSession.stop();
      const destination = new URL(window.location.href);
      destination.searchParams.delete("location");
      destination.searchParams.delete("from");
      window.history.scrollRestoration = "auto";
      window.history.replaceState(
        window.history.state,
        "",
        `${destination.pathname}${destination.search}${destination.hash}`,
      );
    });

    returnToParksLink?.addEventListener("click", (event) => {
      const fromParksMap = navigationParams.get("from") === "parks-map";
      if (!fromParksMap || !document.referrer) return;

      const referrer = new URL(document.referrer);
      if (
        referrer.origin === window.location.origin &&
        referrer.pathname === "/parks/"
      ) {
        event.preventDefault();
        window.history.back();
      }
    });

    if (new URLSearchParams(window.location.search).get("location") === "1") {
      locationSession.start();
    }

    window.addEventListener(
      "pagehide",
      () => {
        classificationRequest.invalidate();
        locationSession.destroy();
        clearLocationLayers();
      },
      { once: true },
    );

    shell
      .querySelectorAll<HTMLInputElement>("[data-related-boundary-toggle]")
      .forEach((toggle) => {
        toggle.addEventListener("change", () => {
          const reference = toggle.dataset.relatedBoundaryToggle ?? "";
          const layer = relatedLayers.get(reference);
          if (!layer) {
            return;
          }

          if (toggle.checked) {
            layer.addTo(map);
          } else {
            layer.removeFrom(map);
          }
        });
      });
  }
</script>

<style is:global>
  .park-detail-map {
    position: absolute;
    inset: 0;
    margin: 0;
    background: var(--map-water);
  }

  .park-detail-map__canvas {
    width: 100%;
    height: 100%;
  }

  .park-detail-map::after {
    position: absolute;
    z-index: 650;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 22, 22, 0.5), transparent 28%),
      linear-gradient(90deg, rgba(8, 22, 22, 0.32), transparent 54%);
    content: "";
    pointer-events: none;
  }

  .park-detail-map__key {
    position: absolute;
    z-index: 750;
    top: calc(var(--header-height) + 1.25rem);
    right: max(1rem, calc((100% - var(--max-width)) / 2));
    display: grid;
    width: min(245px, calc(100% - 2rem));
    gap: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.36);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface-raised) 91%, transparent);
    box-shadow: 0 14px 45px rgba(15, 34, 31, 0.2);
    padding: 0.8rem;
    color: var(--text-primary);
    font-size: 0.78rem;
    backdrop-filter: blur(12px);
  }

  .park-detail-map__key > p {
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .park-detail-map__key-row {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem;
    line-height: 1.25;
  }

  span.park-detail-map__key-row {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .park-detail-map__key-row input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: #0b6670;
  }

  .park-detail-map__swatch {
    width: 1.3rem;
    height: 0.7rem;
    border-radius: 2px;
  }

  .park-detail-map__swatch--primary {
    border: 2px solid #6f4618;
    background: rgba(211, 154, 80, 0.42);
  }

  .park-detail-map__swatch--primary[data-geometry-kind="point"] {
    width: 0.8rem;
    height: 0.8rem;
    border-color: #fffaf0;
    border-radius: 50%;
    background: #18312f;
  }

  .park-detail-map__swatch--related {
    height: 0;
    border-top: 3px dashed #0b6670;
  }

  .park-detail-map__key button {
    width: fit-content;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: var(--link-strong);
    cursor: pointer;
    font-weight: 850;
    padding: 0.15rem 0;
  }

  .park-detail-map__mode-controls {
    position: absolute;
    z-index: 850;
    top: calc(var(--header-height) + 1rem);
    left: max(1rem, calc((100vw - var(--max-width)) / 2));
    display: flex;
    max-width: calc(100% - 2rem);
    min-height: 3.2rem;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid rgba(255, 250, 240, 0.24);
    border-radius: 9px;
    background: rgba(18, 39, 37, 0.96);
    box-shadow: 0 18px 52px rgba(5, 17, 16, 0.34);
    padding: 0.55rem 0.65rem 0.55rem 0.8rem;
    color: var(--text-on-hero);
    backdrop-filter: blur(14px);
  }

  .park-detail-map__mode-controls[hidden] {
    display: none;
  }

  .park-detail-map__mode-label {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.45rem;
    color: #a8d8fa;
    font-size: 0.67rem;
    font-weight: 950;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    white-space: nowrap;
