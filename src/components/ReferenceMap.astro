---
import "leaflet/dist/leaflet.css";
import parks from "../../public/data/activate-ri-2026/parks.json";
import { parks as references } from "@ripota/parks";
import { dataset, displayReferences } from "@ripota/parks/display";
import { getCanonicalGeometryUrl, getWebGeometry, parksGeometryVersion } from "../lib/pota/geometry-assets";
import {
  buildReferenceMapItems,
  coverageStatusLabels,
  referenceMapLegendItems,
  referenceMapStatusColors,
  type ReferenceMapVariant,
} from "../lib/reference-map";
import type { PublicParkSummary } from "../lib/activate-ri/types";

type Props = {
  id: string;
  variant: ReferenceMapVariant;
  title: string;
  caption: string;
  phaseFocus?: "volunteer" | "hunter";
  legendPlacement?: "overlay" | "below" | "none";
  legendTitle?: string;
  showBoundaries?: boolean;
  resultsMode?: boolean;
};

const {
  id,
  variant,
  title,
  caption,
  phaseFocus = "volunteer",
  legendPlacement = variant === "home" || variant === "directory" ? "none" : "overlay",
  legendTitle,
  showBoundaries = true,
  resultsMode = false,
} = Astro.props;
const eventParks = parks as PublicParkSummary[];
const isEventMap = variant === "coverage" || variant === "volunteer" || variant === "on-air";
const mapItems = buildReferenceMapItems({
  references,
  displayReferences,
  geojsonByReference: showBoundaries
    ? Object.fromEntries(displayReferences
      .filter((display) => display.status === "available")
      .map(({ reference }) => [reference, getWebGeometry(reference)]))
    : undefined,
  markerPlacement: variant === "directory" ? "reference-coordinate" : "geometry-center",
  parks: isEventMap ? eventParks : undefined,
});
const potaLegendItems = [
  { label: "On air now", color: "#f6bd46", statuses: ["live"] },
  { label: "Activated", color: "#2d7a4b", statuses: ["confirmed", "observed"], symbol: "✓" },
  { label: "Scheduled", color: "#3758c8", statuses: ["scheduled"] },
  { label: "Still needed", color: "#707b78", statuses: ["needed"] },
];
const legendItems: readonly { label: string; color: string; statuses: readonly string[]; symbol?: string }[] =
  isEventMap ? (resultsMode || variant === "on-air" ? potaLegendItems : referenceMapLegendItems) : [];
const showLegend = legendPlacement !== "none" && legendItems.length > 0;
const showCaption = caption.trim().length > 0;
const dataId = `${id}-data`;
const locationResultsId = `${id}-location-results`;
const payload = JSON.stringify({
  variant,
  phaseFocus,
  items: mapItems.map((item) => ({
    ...item,
    bbox: showBoundaries || variant === "directory" ? item.bbox : undefined,
  })),
  attribution: dataset.attribution,
  sourceBaseUrl: `${dataset.projectUrl}/blob/v${parksGeometryVersion}`,
  canonicalGeometryUrl: variant === "directory" ? getCanonicalGeometryUrl() : undefined,
  parks: isEventMap ? eventParks : [],
  coverageStatusLabels,
  referenceMapStatusColors,
  resultsMode: variant === "on-air" ? false : resultsMode,
  coverageState: isEventMap && variant !== "on-air" && !resultsMode ? "loading" : undefined,
  potaStatusColors: {
    confirmed: "#2d7a4b",
    observed: "#2d7a4b",
    scheduled: "#3758c8",
    needed: "#707b78",
  },
});
---

<figure
  class:list={[
    "map-preview",
    "reference-map-preview",
    `reference-map-preview--legend-${legendPlacement}`,
    {
      "reference-map-preview--has-location": variant === "directory",
    },
  ]}
  aria-label={title}
>
  {
    showLegend && legendPlacement === "overlay" && (
      <div class="map-legend" aria-label={legendTitle ?? "Coverage status legend"} hidden>
        {legendTitle && <span class="map-legend__title">{legendTitle}</span>}
        {legendItems.map((item) => (
          <span
            class="map-legend__item"
            data-map-legend-item
            data-map-legend-statuses={item.statuses.join(" ")}
            hidden
          >
            <span style={`--map-status-color: ${item.color}`} aria-hidden="true">{item.symbol}</span>
            {item.label}
          </span>
        ))}
      </div>
    )
  }
  <div id={id} class="ri-reference-map" data-reference-map data-map-data-id={dataId} data-map-mode={variant === "on-air" ? "live" : undefined}></div>
  {
    variant === "directory" && (
      <>
        <button
          class="reference-map-location-button"
          type="button"
          aria-label="Show my location"
          aria-controls={locationResultsId}
          aria-pressed="false"
          data-reference-map-location
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
          </svg>
        </button>

        <aside
          id={locationResultsId}
          class="reference-map-location-results"
          aria-label="Parks at and near my location"
          data-reference-location-results
          data-tone="neutral"
          hidden
        >
          <header>
            <div class="reference-map-location-results__modebar">
              <span>
                <span aria-hidden="true"></span>
                Location mode
              </span>
              <button type="button" data-reference-location-stop>
                Exit location mode <span aria-hidden="true">×</span>
              </button>
            </div>
            <div
              class="reference-map-location-results__status"
              role="status"
              aria-live="polite"
              aria-atomic="true"
            >
              <span class="reference-map-location-results__shape" aria-hidden="true"></span>
              <span>
                <strong data-reference-location-primary></strong>
                <small data-reference-location-secondary></small>
              </span>
            </div>
            <div class="reference-map-location-results__key" aria-label="Map key">
              <span><span data-kind="park" aria-hidden="true"></span>Park map point</span>
              <span><span data-kind="location" aria-hidden="true"></span>Your location</span>
            </div>
          </header>

          <section data-reference-location-section="inside" hidden>
            <h3>Mapped matches</h3>
            <ul data-reference-location-list></ul>
          </section>
          <section data-reference-location-section="uncertain" hidden>
            <h3>Boundary uncertainty</h3>
            <ul data-reference-location-list></ul>
          </section>
          <section data-reference-location-section="nearby" hidden>
            <h3>Closest parks</h3>
            <ul data-reference-location-list></ul>
            <button
              class="reference-map-location-results__more"
              type="button"
              aria-expanded="false"
              data-reference-location-more
              hidden
            >Show more parks</button>
          </section>
        </aside>
      </>
    )
  }
  {
    showLegend && legendPlacement === "below" && (
      <div class="map-legend map-legend--below" aria-label={legendTitle ?? "Coverage status legend"} hidden>
        {legendTitle && <span class="map-legend__title">{legendTitle}</span>}
        {legendItems.map((item) => (
          <span
            class="map-legend__item"
            data-map-legend-item
            data-map-legend-statuses={item.statuses.join(" ")}
            hidden
          >
            <span style={`--map-status-color: ${item.color}`} aria-hidden="true">{item.symbol}</span>
            {item.label}
          </span>
        ))}
      </div>
    )
  }
  {isEventMap && variant !== "on-air" && !resultsMode && (
    <p class="map-preview__caption" data-map-coverage-status role="status">Loading the event schedule…</p>
  )}
  {variant === "on-air" && (
    <p class="map-preview__caption" data-map-live-status role="status">Loading parks on air…</p>
  )}
  {showCaption && <figcaption class="map-preview__caption">{caption}</figcaption>}
</figure>

<script is:inline type="application/json" id={dataId} set:html={payload} />
<script>
  import L from "leaflet";
  import { parkGuidePath } from "../lib/parks/directory";
  import { fetchPublicActivationStops } from "../lib/activate-ri/public-stops-client";
  import { upcomingMapStops } from "../lib/activate-ri/map-schedule";
  import { livePotaSpotsStore, type LivePotaSpotsState } from "../lib/pota/live-spots-store";
  import { shouldWarnAboutStaleSnapshot } from "../lib/pota/live-spots-client";
  import { potaParkStatusStore } from "../lib/activate-ri/pota-status-store";
  import { subscribeEventPhase } from "../lib/activate-ri/event-phase";
  import { onAirViewForPhase } from "../lib/pota/on-air-view";
  import type { PublicParkPotaStatus } from "../lib/activate-ri/pota-status-client";
  import { potaSpotReferenceEvidence, type LivePotaSpot } from "../lib/pota/spots";
  import { formatRadioDetails } from "../lib/pota/radio-details";
  import {
    formatActivationDate,
    formatActivationTimeRange,
  } from "../lib/activate-ri/time";
  import {
    scheduleStopStatusLabel,
    stopActivityLabel,
  } from "../lib/activate-ri/stop-status";
  import type { PublicActivationStop } from "../lib/activate-ri/types";
  import {
    referenceMapFitBoundsOptions,
    referenceMapLeafletOptions,
  } from "../lib/reference-map";
  import type { LocationGeometryKind } from "../lib/location/classify";
  import { trackAnalyticsEvent } from "../lib/analytics/client";

  type PublicStop = PublicActivationStop;

  type PublicPark = {
    reference: string;
    name: string;
    counties?: string[];
  };

  type MapCoverage = {
    status: string;
    label: string;
    color: string;
    stops: PublicStop[];
  };

  type MapItem = {
    reference: string;
    name: string;
    counties: string[];
    grid: string;
    locationDesc: string;
    potaUrl: string;
    marker: {
      latitude: number;
      longitude: number;
    } | null;
    geometryKind: LocationGeometryKind;
    bbox?: readonly [number, number, number, number];
    boundaryStatus: string;
    geojson: GeoJSON.FeatureCollection | null;
    coverage: MapCoverage | null;
    liveSpots?: LivePotaSpot[];
    potaStatus?: PublicParkPotaStatus;
  };

  type MapPayload = {
    variant: "home" | "directory" | "coverage" | "volunteer" | "on-air";
    attribution: string;
    sourceBaseUrl: string;
    canonicalGeometryUrl?: string;
    phaseFocus: "volunteer" | "hunter";
    items: MapItem[];
    parks: PublicPark[];
    coverageStatusLabels: Record<string, string>;
    referenceMapStatusColors: Record<string, string>;
    resultsMode: boolean;
    coverageState?: "loading" | "ready" | "unavailable";
    eventStatusState?: "loading" | "ready" | "unavailable";
    potaStatusColors: Record<string, string>;
  };

  type MapItemLayers = {
    boundaries: L.Path[];
    markers: L.CircleMarker[];
    symbols: L.Marker[];
    liveIndicators: L.Marker[];
  };

  document.querySelectorAll<HTMLElement>("[data-reference-map]").forEach(setupReferenceMap);

  function setupReferenceMap(mapElement: HTMLElement): void {
    const dataElement = document.getElementById(mapElement.dataset.mapDataId ?? "");
    if (!dataElement) {
      return;
    }

    const payload = JSON.parse(dataElement.textContent ?? "{}") as MapPayload;
    const map = L.map(mapElement, referenceMapLeafletOptions);
    const bounds = L.latLngBounds([]);
    const layersByReference = new Map<string, MapItemLayers>();

    map.on("popupopen", ({ popup }) => {
      // Phase maps can initialize while hidden; size the popup when it opens.
      popup.options.maxWidth = Math.max(190, Math.min(300, mapElement.clientWidth - 40));
      popup.update();
    });

    if (payload.variant === "coverage" || payload.variant === "volunteer") {
      map.on("popupopen", () => {
        void trackAnalyticsEvent("activate-ri-2026", "map_action", {
          action: "open_popup",
        });
      });
    }

    L.control.zoom({
      position: "topleft",
      zoomInTitle: "Zoom in to separate nearby parks",
      zoomOutTitle: "Zoom out to see more of Rhode Island",
    }).addTo(map);

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);
    map.attributionControl.addAttribution(escapeHtml(payload.attribution)
      .replace("DATA_SOURCES.md", `<a href="${escapeHtml(payload.sourceBaseUrl)}/DATA_SOURCES.md" target="_blank" rel="noreferrer">map sources</a>`)
      .replace("DATA_LICENSE.md", `<a href="${escapeHtml(payload.sourceBaseUrl)}/DATA_LICENSE.md" target="_blank" rel="noreferrer">data license</a>`));
    map.setView([41.58, -71.48], 9);

    for (const item of payload.items) {
      if (payload.variant === "on-air") {
        // Keep the Rhode Island view useful even when there are zero or one spots.
        if (item.marker) bounds.extend([item.marker.latitude, item.marker.longitude]);
      } else {
        const layers = renderMapItem(map, bounds, payload, item);
        layersByReference.set(item.reference, layers);
      }
    }

    fitReferenceBounds(map, bounds, payload);
    // Phase views and map disclosures may become visible after initialization.
    if (payload.variant === "on-air" || mapElement.closest("[data-event-view], details")) {
      let hasMapInteraction = false;
      let previousWidth = 0;
      let previousHeight = 0;
      let previousAttributionHeight = 0;
      const attributionElement = payload.variant === "on-air" ? map.attributionControl.getContainer() : undefined;
      if (payload.variant === "on-air") {
        const rememberInteraction = () => { hasMapInteraction = true; };
        mapElement.addEventListener("pointerdown", rememberInteraction, { once: true });
        mapElement.addEventListener("keydown", rememberInteraction, { once: true });
      }
      const resizeObserver = new ResizeObserver(() => {
        const width = mapElement.clientWidth;
        const height = mapElement.clientHeight;
        const attributionHeight = attributionElement?.clientHeight ?? 0;
        if (width > 0 && height > 0 &&
          (width !== previousWidth || height !== previousHeight || attributionHeight !== previousAttributionHeight)) {
          previousWidth = width;
          previousHeight = height;
          previousAttributionHeight = attributionHeight;
          map.invalidateSize();
          // Let async progress and responsive layout settle around the full RI
          // extent, then retain the visitor's chosen view after interaction.
          if (payload.variant !== "on-air" || !hasMapInteraction) fitReferenceBounds(map, bounds, payload);
        }
      });
      resizeObserver.observe(mapElement);
      if (attributionElement) resizeObserver.observe(attributionElement);
    }
    setupPopupActions(mapElement);
    updateMapLegend(mapElement, payload);

    if (payload.variant === "directory") {
      void import("../lib/location/reference-map-location").then((locationMap) => {
        locationMap.setupReferenceMapLocation({
          mapElement,
          map,
          items: payload.items,
          layersByReference,
          getBaseStyle: (item) => itemStyle(payload, item),
          loadGeometry: locationMap.createCanonicalGeometryLoader(payload.canonicalGeometryUrl!, {
            expectedReferences: payload.items.map(({ reference }) => reference),
          }),
        });
      });
    }

    if (payload.variant === "on-air") {
      setupOnAirMap(mapElement, map, bounds, payload, layersByReference);
    } else if (payload.variant === "home" || payload.resultsMode) {
      livePotaSpotsStore.subscribe((state) => {
        if (state.status !== "loading") {
          updateLiveSpots(
            payload,
            layersByReference,
            state.status === "ready" && !shouldWarnAboutStaleSnapshot(state.snapshot)
              ? state.snapshot.spots : [],
          );
        }
      });
      livePotaSpotsStore.start();
    }
    if (payload.resultsMode && payload.variant !== "on-air") {
      potaParkStatusStore.subscribe((state) => {
        if (state.status === "ready") {
          updatePotaStatuses(mapElement, payload, layersByReference, state.snapshot.parks);
        }
      });
      potaParkStatusStore.start();
    }
    if (payload.variant === "coverage" || payload.variant === "volunteer") {
      void refreshLiveCoverage(mapElement, payload, layersByReference);
    }
  }

  function setupOnAirMap(
    mapElement: HTMLElement,
    map: L.Map,
    bounds: L.LatLngBounds,
    payload: MapPayload,
    layersByReference: Map<string, MapItemLayers>,
  ): void {
    let liveState: LivePotaSpotsState = { status: "loading" };
    let mode: "event" | "live" | undefined;
    let unsubscribeEventStatus: (() => void) | undefined;
    const statusElement = mapElement.closest(".map-preview")?.querySelector<HTMLElement>("[data-map-live-status]");

    const updateStatus = () => {
      if (!statusElement) return;
      const unavailable = liveState.status === "unavailable" ||
        (liveState.status === "ready" && shouldWarnAboutStaleSnapshot(liveState.snapshot));
      const hasLiveParks = payload.items.some((item) => (item.liveSpots?.length ?? 0) > 0);
      const eventMessage = payload.eventStatusState === "loading"
        ? "Loading event progress…"
        : payload.eventStatusState === "unavailable"
          ? "Event progress is unavailable. Park locations are still shown."
          : "";
      const liveMessage = liveState.status === "loading"
        ? "Loading parks on air…"
        : unavailable
          ? "Live spots are unavailable. Try refreshing this page."
          : hasLiveParks ? "" : "No Rhode Island parks are on air right now.";
      statusElement.textContent = [eventMessage, liveMessage].filter(Boolean).join(" ");
      statusElement.hidden = !statusElement.textContent;
    };
    const reconcileLayers = () => {
      for (const item of payload.items) {
        const layers = layersByReference.get(item.reference);
        const visible = mode === "event" || (item.liveSpots?.length ?? 0) > 0;
        if (!visible && layers) {
          removeMapItemLayers(map, layers);
          layersByReference.delete(item.reference);
        } else if (visible && !layers) {
          layersByReference.set(item.reference, renderMapItem(map, bounds, payload, item));
        }
        if (visible) updateMapItemLayers(payload, item, layersByReference.get(item.reference));
      }
      updateMapLegend(mapElement, payload);
      updateStatus();
    };

    subscribeEventPhase((phase) => {
      const nextMode = onAirViewForPhase(phase).mapMode;
      if (mode === nextMode) return;
      mode = nextMode;
      payload.resultsMode = mode === "event";
      mapElement.dataset.mapMode = mode;
      map.closePopup();
      layersByReference.forEach((layers) => removeMapItemLayers(map, layers));
      layersByReference.clear();
      unsubscribeEventStatus?.();
      unsubscribeEventStatus = undefined;
      if (mode === "event") {
        void refreshLiveCoverage(mapElement, payload, layersByReference);
        unsubscribeEventStatus = potaParkStatusStore.subscribe((state) => {
          payload.eventStatusState = state.status;
          updatePotaStatuses(mapElement, payload, layersByReference,
            state.status === "ready" ? state.snapshot.parks : []);
          updateStatus();
        });
        potaParkStatusStore.start();
      } else {
        payload.eventStatusState = undefined;
        for (const item of payload.items) item.potaStatus = undefined;
      }
      reconcileLayers();
      map.invalidateSize();
    });

    livePotaSpotsStore.subscribe((state) => {
      liveState = state;
      updateLiveSpots(
        payload,
        layersByReference,
        state.status === "ready" && !shouldWarnAboutStaleSnapshot(state.snapshot)
          ? state.snapshot.spots : [],
      );
      reconcileLayers();
    });
    livePotaSpotsStore.start();
  }

  function removeMapItemLayers(map: L.Map, layers: MapItemLayers): void {
    for (const layer of [...layers.boundaries, ...layers.markers, ...layers.symbols, ...layers.liveIndicators]) {
      map.removeLayer(layer);
    }
  }

  function renderMapItem(
    map: L.Map,
    bounds: L.LatLngBounds,
    payload: MapPayload,
    item: MapItem,
  ): MapItemLayers {
    const boundaries: L.Path[] = [];
    const markers: L.CircleMarker[] = [];
    const symbols: L.Marker[] = [];
    const liveIndicators: L.Marker[] = [];
    const style = itemStyle(payload, item);

    if (item.geojson) {
      L.geoJSON(item.geojson as GeoJSON.GeoJsonObject, {
        style: () => ({
          color: style.color,
          fillColor: style.fillColor,
          fillOpacity: style.boundaryFillOpacity,
          opacity: 0.9,
          weight: 2,
        }),
        onEachFeature: (_feature, featureLayer) => {
          featureLayer.bindPopup(() => popupHtml(payload, item));
          if (featureLayer instanceof L.Path) {
            boundaries.push(featureLayer);
          }
        },
      }).addTo(map);

      if (item.bbox) {
        const [west, south, east, north] = item.bbox;
        bounds.extend([[south, west], [north, east]]);
      }
    }

    if (item.marker) {
      const marker = L.circleMarker([item.marker.latitude, item.marker.longitude], {
        radius: style.markerRadius,
        className: "reference-map-marker",
        color: style.color,
        fillColor: style.fillColor,
        fillOpacity: style.markerFillOpacity,
        opacity: 1,
        weight: 2,
      })
        .addTo(map)
        .bindPopup(() => popupHtml(payload, item));
      markers.push(marker);
      if (payload.variant === "home" || payload.variant === "on-air" || payload.resultsMode) {
        const indicator = L.marker([item.marker.latitude, item.marker.longitude], {
          icon: L.divIcon({
            className: "reference-map-live-indicator",
            html: '<span aria-hidden="true"></span>',
            iconSize: [28, 28],
            iconAnchor: [14, 14],
          }),
          interactive: false,
          keyboard: false,
          zIndexOffset: -100,
        }).addTo(map);
        liveIndicators.push(indicator);
      }
      if (payload.resultsMode) {
        const symbol = L.marker([item.marker.latitude, item.marker.longitude], {
          icon: resultStatusIcon(item.potaStatus?.status, payload.variant === "on-air"),
          interactive: false,
          keyboard: false,
        }).addTo(map);
        symbols.push(symbol);
      }
      bounds.extend([item.marker.latitude, item.marker.longitude]);
    }

    return { boundaries, markers, symbols, liveIndicators };
  }

  function itemStyle(payload: MapPayload, item: MapItem) {
    const isDiscoveryMap = payload.variant === "home" || payload.variant === "directory";
    const isLive = payload.variant === "on-air"
      ? (item.liveSpots?.length ?? 0) > 0
      : payload.resultsMode
      ? item.potaStatus?.live === true
      : payload.variant === "home" && (item.liveSpots?.length ?? 0) > 0;
    const resultColor = item.potaStatus
      ? payload.potaStatusColors[item.potaStatus.status]
      : payload.variant === "on-air" && payload.resultsMode ? "#9aa6a1" : undefined;
    const color = isLive && !payload.resultsMode
      ? "#6f4300"
      : resultColor ?? item.coverage?.color ?? "#172026";
    const fillColor = isLive && !payload.resultsMode
      ? "#f6bd46"
      : payload.resultsMode
        ? resultColor ?? "#707b78"
        : isDiscoveryMap
        ? "#d7913a"
        : color;

    return {
      color,
      fillColor,
      boundaryFillOpacity: isDiscoveryMap ? 0.16 : 0.22,
      markerFillOpacity: 0.95,
      markerRadius: isLive ? 10 : isDiscoveryMap ? 6 : 7,
      isLive,
    };
  }

  function updateMapItemLayers(
    payload: MapPayload,
    item: MapItem,
    layers: MapItemLayers | undefined,
  ): void {
    if (!layers) {
      return;
    }

    const style = itemStyle(payload, item);
    layers.boundaries.forEach((layer) => {
      layer.setStyle({
        color: style.color,
        fillColor: style.fillColor,
        fillOpacity: style.boundaryFillOpacity,
      });
      layer.bindPopup(() => popupHtml(payload, item));
    });
    layers.markers.forEach((marker) => {
      marker.setRadius(style.markerRadius);
      marker.setStyle({
        color: style.color,
        fillColor: style.fillColor,
        fillOpacity: style.markerFillOpacity,
      });
      marker.getElement()?.classList.toggle(
        "reference-map-marker--live",
        style.isLive,
      );
      marker.bindPopup(() => popupHtml(payload, item));
      if (style.isLive) {
        const content = liveTooltipHtml(item);
        if (marker.getTooltip()) {
          marker.setTooltipContent(content);
        } else {
          marker.bindTooltip(content, {
            className: "reference-map-live-tooltip",
            opacity: 1,
          });
        }
      } else {
        marker.unbindTooltip();
      }
    });
    layers.symbols.forEach((symbol) => {
      symbol.setIcon(resultStatusIcon(item.potaStatus?.status, payload.variant === "on-air"));
    });
    layers.liveIndicators.forEach((indicator) => {
      indicator.getElement()?.classList.toggle("reference-map-live-indicator--active", style.isLive);
    });
  }

  function resultStatusIcon(status: PublicParkPotaStatus["status"] | undefined, showUnknown = false): L.DivIcon {
    const activityStatus = status === "confirmed" || status === "observed"
      ? "activated" : status ?? (showUnknown ? "unknown" : "needed");
    const symbol = { activated: "✓", scheduled: "", needed: "—", unknown: "" }[activityStatus];
    return L.divIcon({
      className: `reference-map-status-symbol reference-map-status-symbol--${activityStatus}`,
      html: `<span aria-hidden="true">${symbol}</span>`,
      iconSize: [18, 18],
      iconAnchor: [9, 9],
    });
  }

  function updateLiveSpots(
    payload: MapPayload,
    layersByReference: Map<string, MapItemLayers>,
    spots: LivePotaSpot[],
  ): void {
    const spotsByReference = new Map<string, LivePotaSpot[]>();
    for (const spot of spots) {
      const spotReferences = payload.resultsMode || payload.variant === "on-air"
        ? potaSpotReferenceEvidence(spot).map((evidence) => evidence.parkReference)
        : [spot.parkReference];
      for (const reference of spotReferences) {
        const parkSpots = spotsByReference.get(reference) ?? [];
        parkSpots.push(spot);
        spotsByReference.set(reference, parkSpots);
      }
    }

    for (const item of payload.items) {
      item.liveSpots = spotsByReference.get(item.reference) ?? [];
      updateMapItemLayers(payload, item, layersByReference.get(item.reference));
    }
  }

  function updatePotaStatuses(
    mapElement: HTMLElement,
    payload: MapPayload,
    layersByReference: Map<string, MapItemLayers>,
    statuses: PublicParkPotaStatus[],
  ): void {
    const byReference = new Map(statuses.map((status) => [status.reference, status]));
    for (const item of payload.items) {
      item.potaStatus = byReference.get(item.reference);
      updateMapItemLayers(payload, item, layersByReference.get(item.reference));
    }
    updateMapLegend(mapElement, payload);
  }

  function fitReferenceBounds(
    map: L.Map,
    bounds: L.LatLngBounds,
    payload: MapPayload,
  ): void {
    if (bounds.isValid()) {
      if (payload.variant === "on-air") {
        // Attribution wraps on narrow maps: keep southern parks above it and
        // leave room for their full markers, including after fonts settle.
        const attributionHeight = map.attributionControl.getContainer()?.clientHeight ?? 0;
        map.fitBounds(bounds, {
          maxZoom: referenceMapFitBoundsOptions.maxZoom,
          paddingTopLeft: [16, 16],
          paddingBottomRight: [16, Math.max(48, attributionHeight) + 16],
        });
        return;
      }
      const wideDirectoryMap =
        payload.variant === "directory" &&
        window.matchMedia("(min-width: 981px)").matches;
      map.fitBounds(
        bounds,
        wideDirectoryMap
          ? {
              maxZoom: referenceMapFitBoundsOptions.maxZoom,
              paddingTopLeft: [Math.min(760, window.innerWidth * 0.52), 32],
              paddingBottomRight: [32, 32],
            }
          : referenceMapFitBoundsOptions,
      );
      return;
    }

    map.setView([41.58, -71.48], 9);
  }

  function setupPopupActions(mapElement: HTMLElement): void {
    mapElement.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }

      const button = target.closest<HTMLButtonElement>("[data-map-add-activation]");
      const reference = button?.dataset.reference;
      if (!reference) {
        return;
      }

      void trackAnalyticsEvent("activate-ri-2026", "map_action", {
        action: "add_to_plan",
      });

      document.dispatchEvent(
        new CustomEvent("activate-ri:add-park", {
          detail: { reference },
        }),
      );
    });
  }

  async function refreshLiveCoverage(
    mapElement: HTMLElement,
    payload: MapPayload,
    layersByReference: Map<string, MapItemLayers>,
  ): Promise<void> {
    try {
      const stops = await fetchPublicActivationStops();

      const coverageByReference = deriveCoverage(
        payload.parks,
        stops.filter((stop) => !stop.id.startsWith("sample-")),
        payload,
      );

      payload.coverageState = "ready";
      for (const item of payload.items) {
        item.coverage = coverageByReference.get(item.reference) ?? item.coverage;
        updateMapItemLayers(payload, item, layersByReference.get(item.reference));
      }
      const status = mapElement.closest(".map-preview")?.querySelector<HTMLElement>("[data-map-coverage-status]");
      if (status) status.hidden = true;
      updateMapLegend(mapElement, payload);
    } catch {
      payload.coverageState = "unavailable";
      for (const item of payload.items) {
        updateMapItemLayers(payload, item, layersByReference.get(item.reference));
      }
      const status = mapElement.closest(".map-preview")?.querySelector<HTMLElement>("[data-map-coverage-status]");
      if (status) status.textContent = "The event schedule is unavailable. Try refreshing this page. Park locations are still shown.";
      updateMapLegend(mapElement, payload);
    }
  }

  function updateMapLegend(mapElement: HTMLElement, payload: MapPayload): void {
    const mapPreview = mapElement.closest(".map-preview");
    if (!mapPreview) {
      return;
    }

    const visibleStatuses = new Set(payload.variant === "on-air" && !payload.resultsMode
      ? payload.items.some((item) => (item.liveSpots?.length ?? 0) > 0) ? ["live"] : []
      : payload.resultsMode
      ? payload.items.flatMap((item) => [item.potaStatus?.status, itemStyle(payload, item).isLive ? "live" : undefined]).filter(Boolean)
      : payload.items.map((item) => item.coverage?.status).filter(Boolean));

    mapPreview.querySelectorAll<HTMLElement>("[data-map-legend-item]").forEach((item) => {
      if (!payload.resultsMode && payload.variant !== "on-air" && payload.coverageState && payload.coverageState !== "ready") {
        item.hidden = true;
        return;
      }
      const statuses = (item.dataset.mapLegendStatuses ?? "").split(" ").filter(Boolean);
      item.hidden = !statuses.some((status) => visibleStatuses.has(status));
    });
    const legend = mapPreview.querySelector<HTMLElement>(".map-legend");
    if (legend) legend.hidden = !legend.querySelector("[data-map-legend-item]:not([hidden])");
  }

  function deriveCoverage(
    parks: PublicPark[],
    stops: PublicStop[],
    payload: MapPayload,
  ): Map<string, MapCoverage> {
    const stopsByReference = new Map<string, PublicStop[]>();
    for (const stop of stops) {
      const parkStops = stopsByReference.get(stop.parkReference) ?? [];
      parkStops.push(stop);
      stopsByReference.set(stop.parkReference, parkStops);
    }

    return new Map(
      parks.map((park) => {
        const parkStops = sortStops(stopsByReference.get(park.reference) ?? []);
        const scheduledStops = parkStops.filter((stop) =>
          stop.status === "scheduled" || stop.status === "delayed",
        );
        const completedStops = parkStops.filter((stop) => stop.status === "completed");
        const cancelledStops = parkStops.filter((stop) => stop.status === "cancelled");
        const status =
          scheduledStops.length > 1
            ? "multiple-scheduled"
            : scheduledStops.length === 1
              ? "scheduled"
              : completedStops.length > 0
                ? "completed"
                : cancelledStops.length > 0
                  ? "cancelled-needs-replacement"
                  : "uncovered";

        return [
          park.reference,
          {
            status,
            label: payload.coverageStatusLabels[status] ?? status,
            color: payload.referenceMapStatusColors[status] ?? "#172026",
            stops: parkStops,
          },
        ];
      }),
    );
  }

  function popupHtml(payload: MapPayload, item: MapItem): string {
    if (payload.variant === "on-air" && !payload.resultsMode) {
      return `
        <strong>${escapeHtml(item.reference)}</strong>
        <span>${escapeHtml(item.name)}</span>
        <em>${escapeHtml(detailLine(item))}</em>
        ${liveSpotsHtml(item)}
        <span class="map-popup__links">${localFieldGuideLink(item)}</span>
      `;
    }
    if (payload.variant === "home" || payload.variant === "directory") {
      return `
        <strong>${escapeHtml(item.reference)}</strong>
        <span>${escapeHtml(item.name)}</span>
        <em>${escapeHtml(detailLine(item))}</em>
        ${payload.variant === "home" ? liveSpotsHtml(item) : ""}
        <span>Map data comes from official POTA park data and reviewed public sources.</span>
        <span class="map-popup__links">
          ${localFieldGuideLink(item)}
        </span>
      `;
    }

    if (payload.resultsMode) {
      const status = item.potaStatus;
      const unknownEventStatus = payload.variant === "on-air" && !status;
      const statusLabel = unknownEventStatus
        ? payload.eventStatusState === "loading" ? "Loading event progress…" : "Event progress unavailable"
        : potaStatusLabel(status?.status);
      return `
        <strong>${escapeHtml(item.reference)}</strong>
        <span>${escapeHtml(item.name)}</span>
        <span><b>${escapeHtml(statusLabel)}</b>${itemStyle(payload, item).isLive ? " · On air now" : ""}</span>
        <span class="map-popup__links">
          ${parkScheduleLink(item)}
          <a href="/activate-ri-2026/parks/?progress-q=${encodeURIComponent(item.reference)}#park-results">View activation results</a>
        </span>
        ${upcomingStopsHtml(payload, item)}
        ${payload.variant === "on-air" ? liveSpotsHtml(item) : ""}
        ${unknownEventStatus ? "" : potaEvidenceHtml(status)}
        <em>${escapeHtml(detailLine(item))}</em>
        <span class="map-popup__links">
          ${localFieldGuideLink(item)}
        </span>
      `;
    }

    const volunteerAction =
      payload.variant === "volunteer"
        ? `<button class="map-popup__action" type="button" data-map-add-activation data-reference="${escapeHtml(item.reference)}">Add activation</button>`
        : `<a href="/activate-ri-2026/volunteer/?park=${encodeURIComponent(item.reference)}" data-analytics-event="event_cta_clicked" data-analytics-feature="map" data-analytics-placement="map" data-analytics-action="volunteer">Volunteer for this park</a>`;

    return `
      <strong>${escapeHtml(item.reference)}</strong>
      <span>${escapeHtml(item.name)}</span>
      <em>${escapeHtml(detailLine(item))}</em>
      <span><b>${escapeHtml(item.coverage?.label ?? (payload.coverageState === "loading" ? "Loading schedule…" : "Schedule unavailable"))}</b></span>
      ${coverageStopsHtml(item)}
      <span class="map-popup__links">
        ${parkScheduleLink(item)}
        <a href="/activate-ri-2026/parks/">Open coverage table</a>
        ${localFieldGuideLink(item)}
        ${volunteerAction}
      </span>
    `;
  }

  function parkScheduleLink(item: MapItem): string {
    return `<a href="/activate-ri-2026/schedule/?q=${encodeURIComponent(item.reference)}">View this park’s schedule</a>`;
  }

  function upcomingStopsHtml(payload: MapPayload, item: MapItem): string {
    if (payload.coverageState !== "ready") {
      return `<span>${payload.coverageState === "unavailable" ? "Planned activations are temporarily unavailable." : "Loading planned activations…"}</span>`;
    }
    const stops = upcomingMapStops(item.coverage?.stops ?? []);
    if (stops.length === 0) return "<span>No upcoming activation windows published.</span>";
    return `
      <span class="map-popup__stops" data-map-upcoming-stops>
        <b>Now and upcoming</b>
        ${stops.slice(0, 3).map((stop) => `
          <span class="map-popup__stop">
            <b>${escapeHtml(stop.activatorCallsign)}${stop.status === "delayed" ? " · Delayed" : ""}</b>
            <span>${escapeHtml(formatActivationDate(stop))}, ${escapeHtml(formatActivationTimeRange(stop))}</span>
          </span>
        `).join("")}
        ${stops.length > 3 ? `<span>${stops.length - 3} more windows in the park schedule.</span>` : ""}
      </span>
    `;
  }

  function potaStatusLabel(status: string | undefined): string {
    return {
      confirmed: "Activated",
      observed: "Activated",
      scheduled: "Scheduled",
      needed: "Still needed",
    }[status ?? "needed"] ?? "Still needed";
  }

  function potaEvidenceHtml(status: PublicParkPotaStatus | undefined): string {
    if (status?.confirmation) {
      return `<span>POTA log: ${escapeHtml(status.confirmation.activeCallsign)} · ${escapeHtml(status.confirmation.qsoDate)} UTC · ${status.confirmation.totalQsos} QSOs</span>`;
    }
    if (status?.lastObservation) {
      return `<span>Last spotted ${escapeHtml(formatLiveSpotTime(status.lastObservation.lastObservedAt))} · ${escapeHtml(status.lastObservation.activeCallsign)}</span>`;
    }
    if ((status?.attempts.length ?? 0) > 0) {
      const attempt = status?.attempts[0];
      return attempt
        ? `<span>Attempt recorded: ${escapeHtml(attempt.activeCallsign)} · ${attempt.totalQsos} QSOs</span>`
        : "";
    }
    return "<span>No event POTA evidence yet.</span>";
  }

  function liveTooltipHtml(item: MapItem): string {
    const rows = [...new Set((item.liveSpots ?? []).map((spot) =>
      [spot.activatorCallsign, spot.frequency || spot.mode ? formatRadioDetails(spot.frequency, spot.mode) : ""]
        .filter(Boolean).join(" · "),
    ))];
    return `
      <strong>On air now · ${escapeHtml(item.reference)}</strong>
      ${rows.slice(0, 2).map((row) => `<span>${escapeHtml(row)}</span>`).join("")}
      ${rows.length > 2 ? `<span>+${rows.length - 2} more</span>` : ""}
    `;
  }

  function liveSpotsHtml(item: MapItem): string {
    const spots = item.liveSpots ?? [];
    if (spots.length === 0) {
      return "";
    }

    return `
      <span class="map-popup__live-label">On air now</span>
      <span class="map-popup__stops">
        ${spots.map((spot) => `
          <span class="map-popup__stop">
            <b>${escapeHtml(spot.activatorCallsign)}</b>
            <span>${escapeHtml(formatRadioDetails(spot.frequency, spot.mode))}</span>
            <span>Spotted ${escapeHtml(formatLiveSpotTime(spot.spotTime))}</span>
            ${spot.sourceLabel ? `<span>via ${escapeHtml(spot.sourceLabel)}</span>` : ""}
          </span>
        `).join("")}
      </span>
    `;
  }

  function coverageStopsHtml(item: MapItem): string {
    if (!item.coverage) return "";
    const stops = item.coverage.stops.filter((stop) => stop.status !== "cancelled");
    if (stops.length === 0) {
      return `<span>Needs coverage.</span>`;
    }

    return `
      <span class="map-popup__stops">
        ${stops.map((stop) => `
          <span class="map-popup__stop">
            <b>${escapeHtml(stop.activatorCallsign)}</b>
            <span>${escapeHtml(scheduleStopStatusLabel(stop))}</span>
            ${stop.activity ? `<span>${escapeHtml(stopActivityLabel(stop.activity))}</span>` : ""}
            <span>${escapeHtml(formatActivationDate(stop))}, ${escapeHtml(formatActivationTimeRange(stop))}</span>
            <span>${escapeHtml(formatList(stop.bands))} / ${escapeHtml(formatList(stop.modes))}</span>
            ${stop.publicNotes ? `<span>${escapeHtml(stop.publicNotes)}</span>` : ""}
          </span>
        `).join("")}
      </span>
    `;
  }

  function localFieldGuideLink(item: MapItem): string {
    return `<a href="${escapeHtml(parkGuidePath(item.reference))}">Open local field guide</a>`;
  }

  function detailLine(item: MapItem): string {
    return [item.grid, item.locationDesc, item.counties.join(", ")].filter(Boolean).join(" · ");
  }

  function sortStops(stops: PublicStop[]): PublicStop[] {
    return [...stops].sort((left, right) => {
      const leftKey = `${left.plannedDate}T${left.startTime}`;
      const rightKey = `${right.plannedDate}T${right.startTime}`;
      return leftKey.localeCompare(rightKey);
    });
  }

  function formatList(items: string[]): string {
    return items.length > 0 ? items.join(", ") : "TBD";
  }

  function formatLiveSpotTime(value: string): string {
    const timestamp = /(Z|[+-]\d{2}:?\d{2})$/i.test(value) ? value : `${value}Z`;
    const date = new Date(timestamp);
    if (!Number.isFinite(date.valueOf())) {
      return value;
    }

    return new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: "UTC",
      timeZoneName: "short",
    }).format(date);
  }

  function escapeHtml(value: string): string {
    return String(value).replace(/[&<>"']/g, (char) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };

      return entities[char] ?? char;
    });
  }
</script>

