---
import "leaflet/dist/leaflet.css";
import parks from "../../public/data/activate-ri-2026/parks.json";
import {
  parksCatalog,
  referenceBoundaries,
  referenceGeojsonByPath,
} from "../lib/pota/catalog";
import {
  buildReferenceMapItems,
  coverageStatusLabels,
  displayedReferenceMapLegendItems,
  referenceMapLegendItems,
  referenceMapStatusColors,
  type ReferenceMapVariant,
} from "../lib/reference-map";
import type { PublicParkSummary } from "../lib/activate-ri/types";

type Props = {
  id: string;
  variant: ReferenceMapVariant;
  title: string;
  caption: string;
  phaseFocus?: "volunteer" | "hunter";
  legendPlacement?: "overlay" | "below" | "none";
  legendTitle?: string;
  showBoundaries?: boolean;
  resultsMode?: boolean;
};

const {
  id,
  variant,
  title,
  caption,
  phaseFocus = "volunteer",
  legendPlacement = variant === "home" || variant === "directory" ? "none" : "overlay",
  legendTitle,
  showBoundaries = true,
  resultsMode = false,
} = Astro.props;
const eventParks = parks as PublicParkSummary[];
const isEventMap = variant === "coverage" || variant === "volunteer";
const mapItems = buildReferenceMapItems({
  references: parksCatalog.references,
  boundaries: referenceBoundaries,
  geojsonByPath: referenceGeojsonByPath,
  markerPlacement: variant === "directory" ? "reference-coordinate" : "geometry-center",
  parks: isEventMap ? eventParks : undefined,
  stops: isEventMap ? [] : undefined,
});
const potaLegendItems = [
  { label: "POTA confirmed", color: "#2d7a4b", statuses: ["confirmed"] },
  { label: "Activity observed / attempt", color: "#b56b00", statuses: ["observed"] },
  { label: "Scheduled", color: "#0b7180", statuses: ["scheduled"] },
  { label: "Still needed", color: "#707b78", statuses: ["needed"] },
  { label: "On air now", color: "#f6bd46", statuses: ["live"] },
];
const legendItems = isEventMap ? (resultsMode ? potaLegendItems : referenceMapLegendItems) : [];
const visibleLegendLabels = new Set(resultsMode
  ? potaLegendItems.map((item) => item.label)
  : displayedReferenceMapLegendItems(
    mapItems
      .map((item) => item.coverage?.status)
      .filter((status) => status !== undefined),
  ).map((item) => item.label));
const showLegend = legendPlacement !== "none" && legendItems.length > 0;
const showCaption = caption.trim().length > 0;
const dataId = `${id}-data`;
const locationResultsId = `${id}-location-results`;
const payload = JSON.stringify({
  variant,
  phaseFocus,
  items: mapItems.map((item) => ({
    ...item,
    geojson: showBoundaries ? item.geojson : null,
  })),
  parks: isEventMap ? eventParks : [],
  coverageStatusLabels,
  referenceMapStatusColors,
  resultsMode,
  potaStatusColors: {
    confirmed: "#2d7a4b",
    observed: "#b56b00",
    scheduled: "#0b7180",
    needed: "#707b78",
  },
});
---

<figure
  class:list={[
    "map-preview",
    "reference-map-preview",
    `reference-map-preview--legend-${legendPlacement}`,
    {
      "reference-map-preview--has-toolbar": variant === "volunteer",
      "reference-map-preview--has-location": variant === "directory",
    },
  ]}
  aria-label={title}
>
  {
    variant === "volunteer" && (
      <div class="reference-map-toolbar">
        <label class="event-coverage-toggle">
          <input type="checkbox" data-map-coverage-filter />
          <span>
            Only show parks needing coverage <span data-map-coverage-count></span>
          </span>
        </label>
      </div>
    )
  }
  {
    showLegend && legendPlacement === "overlay" && (
      <div class="map-legend" aria-label={legendTitle ?? "Coverage status legend"}>
        {legendTitle && <span class="map-legend__title">{legendTitle}</span>}
        {legendItems.map((item) => (
          <span
            class="map-legend__item"
            data-map-legend-item
            data-map-legend-statuses={item.statuses.join(" ")}
            data-map-legend-optional={item.statuses.includes("completed") ? "true" : undefined}
            hidden={!visibleLegendLabels.has(item.label)}
          >
            <span style={`--map-status-color: ${item.color}`} />
            {item.label}
          </span>
        ))}
      </div>
    )
  }
  <div id={id} class="ri-reference-map" data-reference-map data-map-data-id={dataId}></div>
  {
    variant === "directory" && (
      <>
        <button
          class="reference-map-location-button"
          type="button"
          aria-label="Show my location"
          aria-controls={locationResultsId}
          aria-pressed="false"
          data-reference-map-location
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
          </svg>
        </button>

        <aside
          id={locationResultsId}
          class="reference-map-location-results"
          aria-label="Parks at and near my location"
          data-reference-location-results
          data-tone="neutral"
          hidden
        >
          <header>
            <div class="reference-map-location-results__modebar">
              <span>
                <span aria-hidden="true"></span>
                Location mode
              </span>
              <button type="button" data-reference-location-stop>
                Exit location mode <span aria-hidden="true">×</span>
              </button>
            </div>
            <div
              class="reference-map-location-results__status"
              role="status"
              aria-live="polite"
              aria-atomic="true"
            >
              <span class="reference-map-location-results__shape" aria-hidden="true"></span>
              <span>
                <strong data-reference-location-primary></strong>
                <small data-reference-location-secondary></small>
              </span>
            </div>
            <div class="reference-map-location-results__key" aria-label="Map key">
              <span><span data-kind="park" aria-hidden="true"></span>Park map point</span>
              <span><span data-kind="location" aria-hidden="true"></span>Your location</span>
            </div>
          </header>

          <section data-reference-location-section="inside" hidden>
            <h3>Mapped matches</h3>
            <ul data-reference-location-list></ul>
          </section>
          <section data-reference-location-section="uncertain" hidden>
            <h3>Boundary uncertainty</h3>
            <ul data-reference-location-list></ul>
          </section>
          <section data-reference-location-section="nearby" hidden>
            <h3>Closest parks</h3>
            <ul data-reference-location-list></ul>
            <button
              class="reference-map-location-results__more"
              type="button"
              aria-expanded="false"
              data-reference-location-more
              hidden
            >Show more parks</button>
          </section>
        </aside>
      </>
    )
  }
  {
    showLegend && legendPlacement === "below" && (
      <div class="map-legend map-legend--below" aria-label={legendTitle ?? "Coverage status legend"}>
        {legendTitle && <span class="map-legend__title">{legendTitle}</span>}
        {legendItems.map((item) => (
          <span
            class="map-legend__item"
            data-map-legend-item
            data-map-legend-statuses={item.statuses.join(" ")}
            data-map-legend-optional={item.statuses.includes("completed") ? "true" : undefined}
            hidden={!visibleLegendLabels.has(item.label)}
          >
            <span style={`--map-status-color: ${item.color}`} />
            {item.label}
          </span>
        ))}
      </div>
    )
  }
  {showCaption && <figcaption class="map-preview__caption">{caption}</figcaption>}
</figure>

<script is:inline type="application/json" id={dataId} set:html={payload} />
<script>
  import L from "leaflet";
  import { fetchPublicActivationStops } from "../lib/activate-ri/public-stops-client";
  import { livePotaSpotsStore } from "../lib/pota/live-spots-store";
  import { potaParkStatusStore } from "../lib/activate-ri/pota-status-store";
  import type { PublicParkPotaStatus } from "../lib/activate-ri/pota-status-client";
  import type { LivePotaSpot } from "../lib/pota/spots";
  import {
    formatActivationDate,
    formatActivationTimeRange,
  } from "../lib/activate-ri/time";
  import {
    referenceMapFitBoundsOptions,
    referenceMapLeafletOptions,
  } from "../lib/reference-map";
  import type { LocationGeometryKind } from "../lib/location/classify";
  import { trackAnalyticsEvent } from "../lib/analytics/client";

  type PublicStop = {
    id: string;
    parkReference: string;
    plannedDate: string;
    startTime: string;
    endTime: string;
    activatorCallsign: string;
    bands: string[];
    modes: string[];
    publicNotes?: string;
    status: string;
  };

  type PublicPark = {
    reference: string;
    name: string;
    counties?: string[];
  };

  type MapCoverage = {
    status: string;
    label: string;
    color: string;
    stops: PublicStop[];
  };

  type MapItem = {
    reference: string;
    name: string;
    counties: string[];
    grid: string;
    locationDesc: string;
    potaUrl: string;
    marker: {
      latitude: number;
      longitude: number;
    } | null;
    geometryKind: LocationGeometryKind;
    boundaryStatus: string;
    sourceName: string;
    sourceUrl: string;
    geojson: GeoJSON.FeatureCollection | null;
    coverage: MapCoverage | null;
    liveSpots?: LivePotaSpot[];
    potaStatus?: PublicParkPotaStatus;
  };

  type MapPayload = {
    variant: "home" | "directory" | "coverage" | "volunteer";
    phaseFocus: "volunteer" | "hunter";
    items: MapItem[];
    parks: PublicPark[];
    coverageStatusLabels: Record<string, string>;
    referenceMapStatusColors: Record<string, string>;
    resultsMode: boolean;
    potaStatusColors: Record<string, string>;
  };

  type MapItemLayers = {
    boundaries: L.Path[];
    markers: L.CircleMarker[];
    symbols: L.Marker[];
    displayLayers: L.Layer[];
  };

  document.querySelectorAll<HTMLElement>("[data-reference-map]").forEach(setupReferenceMap);

  function setupReferenceMap(mapElement: HTMLElement): void {
    const dataElement = document.getElementById(mapElement.dataset.mapDataId ?? "");
    if (!dataElement) {
      return;
    }

    const payload = JSON.parse(dataElement.textContent ?? "{}") as MapPayload;
    const map = L.map(mapElement, referenceMapLeafletOptions);
    const bounds = L.latLngBounds([]);
    const layersByReference = new Map<string, MapItemLayers>();

    if (payload.variant === "coverage" || payload.variant === "volunteer") {
      map.on("popupopen", () => {
        void trackAnalyticsEvent("activate-ri-2026", "map_action", {
          action: "open_popup",
        });
      });
    }

    L.control.zoom({
      position: "topleft",
      zoomInTitle: "Zoom in to separate nearby parks",
      zoomOutTitle: "Zoom out to see more of Rhode Island",
    }).addTo(map);

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);
    map.setView([41.58, -71.48], 9);

    for (const item of payload.items) {
      const layers = renderMapItem(map, bounds, payload, item);
      layersByReference.set(item.reference, layers);
    }

    fitReferenceBounds(map, bounds, payload);
    setupPopupActions(mapElement);
    updateMapLegend(mapElement, payload);
    const applyCoverageFilter = setupCoverageFilter(
      mapElement,
      map,
      payload,
      layersByReference,
    );

    if (payload.variant === "directory") {
      void import("../lib/location/reference-map-location").then((locationMap) => {
        locationMap.setupReferenceMapLocation({
          mapElement,
          map,
          items: payload.items,
          layersByReference,
          getBaseStyle: (item) => itemStyle(payload, item),
        });
      });
    }

    if (payload.variant === "home") {
      livePotaSpotsStore.subscribe((state) => {
        if (state.status !== "loading") {
          updateLiveSpots(
            payload,
            layersByReference,
            state.status === "ready" ? state.snapshot.spots : [],
          );
        }
      });
      livePotaSpotsStore.start();
    } else if (payload.resultsMode) {
      potaParkStatusStore.subscribe((state) => {
        if (state.status === "ready") {
          updatePotaStatuses(mapElement, payload, layersByReference, state.snapshot.parks);
        }
      });
      potaParkStatusStore.start();
    } else if (payload.variant === "coverage" || payload.variant === "volunteer") {
      refreshLiveCoverage(mapElement, payload, layersByReference, applyCoverageFilter);
    }
  }

  function renderMapItem(
    map: L.Map,
    bounds: L.LatLngBounds,
    payload: MapPayload,
    item: MapItem,
  ): MapItemLayers {
    const boundaries: L.Path[] = [];
    const markers: L.CircleMarker[] = [];
    const symbols: L.Marker[] = [];
    const displayLayers: L.Layer[] = [];
    const style = itemStyle(payload, item);

    if (item.geojson) {
      const layer = L.geoJSON(item.geojson as GeoJSON.GeoJsonObject, {
        style: () => ({
          color: style.color,
          fillColor: style.fillColor,
          fillOpacity: style.boundaryFillOpacity,
          opacity: 0.9,
          weight: 2,
        }),
        onEachFeature: (_feature, featureLayer) => {
          featureLayer.bindPopup(() => popupHtml(payload, item));
          if (featureLayer instanceof L.Path) {
            boundaries.push(featureLayer);
          }
        },
      }).addTo(map);
      displayLayers.push(layer);

      const layerBounds = layer.getBounds();
      if (layerBounds.isValid()) {
        bounds.extend(layerBounds);
      }
    }

    if (item.marker) {
      const marker = L.circleMarker([item.marker.latitude, item.marker.longitude], {
        radius: style.markerRadius,
        className: "reference-map-marker",
        color: style.color,
        fillColor: style.fillColor,
        fillOpacity: style.markerFillOpacity,
        opacity: 1,
        weight: 2,
      })
        .addTo(map)
        .bindPopup(() => popupHtml(payload, item));
      markers.push(marker);
      displayLayers.push(marker);
      if (payload.resultsMode) {
        const symbol = L.marker([item.marker.latitude, item.marker.longitude], {
          icon: resultStatusIcon(item.potaStatus?.status),
          interactive: false,
          keyboard: false,
        }).addTo(map);
        symbols.push(symbol);
        displayLayers.push(symbol);
      }
      bounds.extend([item.marker.latitude, item.marker.longitude]);
    }

    return { boundaries, markers, symbols, displayLayers };
  }

  function itemStyle(payload: MapPayload, item: MapItem) {
    const isDiscoveryMap = payload.variant === "home" || payload.variant === "directory";
    const isLive = payload.resultsMode
      ? item.potaStatus?.live === true
      : payload.variant === "home" && (item.liveSpots?.length ?? 0) > 0;
    const resultColor = item.potaStatus
      ? payload.potaStatusColors[item.potaStatus.status]
      : undefined;
    const color = isLive && !payload.resultsMode
      ? "#6f4300"
      : resultColor ?? item.coverage?.color ?? "#172026";
    const fillColor = isLive && !payload.resultsMode
      ? "#f6bd46"
      : payload.resultsMode
        ? resultColor ?? "#707b78"
        : isDiscoveryMap
        ? "#d7913a"
        : color;

    return {
      color,
      fillColor,
      boundaryFillOpacity: isDiscoveryMap ? 0.16 : 0.22,
      markerFillOpacity: 0.95,
      markerRadius: isLive ? 10 : isDiscoveryMap ? 6 : 7,
      isLive,
    };
  }

  function updateMapItemLayers(
    payload: MapPayload,
    item: MapItem,
    layers: MapItemLayers | undefined,
  ): void {
    if (!layers) {
      return;
    }

    const style = itemStyle(payload, item);
    layers.boundaries.forEach((layer) => {
      layer.setStyle({
        color: style.color,
        fillColor: style.fillColor,
        fillOpacity: style.boundaryFillOpacity,
      });
      layer.bindPopup(() => popupHtml(payload, item));
    });
    layers.markers.forEach((marker) => {
      marker.setRadius(style.markerRadius);
      marker.setStyle({
        color: style.color,
        fillColor: style.fillColor,
        fillOpacity: style.markerFillOpacity,
      });
      marker.getElement()?.classList.toggle(
        "reference-map-marker--live",
        style.isLive,
      );
      marker.bindPopup(() => popupHtml(payload, item));
    });
    layers.symbols.forEach((symbol) => {
      symbol.setIcon(resultStatusIcon(item.potaStatus?.status));
    });
  }

  function resultStatusIcon(status: PublicParkPotaStatus["status"] | undefined): L.DivIcon {
    const symbol = { confirmed: "✓", observed: "•", scheduled: "S", needed: "—" }[status ?? "needed"];
    return L.divIcon({
      className: `reference-map-status-symbol reference-map-status-symbol--${status ?? "needed"}`,
      html: `<span aria-hidden="true">${symbol}</span>`,
      iconSize: [18, 18],
      iconAnchor: [9, 9],
    });
  }

  function updateLiveSpots(
    payload: MapPayload,
    layersByReference: Map<string, MapItemLayers>,
    spots: LivePotaSpot[],
  ): void {
    const spotsByReference = new Map<string, LivePotaSpot[]>();
    for (const spot of spots) {
      const parkSpots = spotsByReference.get(spot.parkReference) ?? [];
      parkSpots.push(spot);
      spotsByReference.set(spot.parkReference, parkSpots);
    }

    for (const item of payload.items) {
      item.liveSpots = spotsByReference.get(item.reference) ?? [];
      updateMapItemLayers(payload, item, layersByReference.get(item.reference));
    }
  }

  function updatePotaStatuses(
    mapElement: HTMLElement,
    payload: MapPayload,
    layersByReference: Map<string, MapItemLayers>,
    statuses: PublicParkPotaStatus[],
  ): void {
    const byReference = new Map(statuses.map((status) => [status.reference, status]));
    for (const item of payload.items) {
      item.potaStatus = byReference.get(item.reference);
      updateMapItemLayers(payload, item, layersByReference.get(item.reference));
    }
    updateMapLegend(mapElement, payload);
  }

  function fitReferenceBounds(
    map: L.Map,
    bounds: L.LatLngBounds,
    payload: MapPayload,
  ): void {
    if (bounds.isValid()) {
      const wideDirectoryMap =
        payload.variant === "directory" &&
        window.matchMedia("(min-width: 981px)").matches;
      map.fitBounds(
        bounds,
        wideDirectoryMap
          ? {
              maxZoom: referenceMapFitBoundsOptions.maxZoom,
              paddingTopLeft: [Math.min(760, window.innerWidth * 0.52), 32],
              paddingBottomRight: [32, 32],
            }
          : referenceMapFitBoundsOptions,
      );
      return;
    }

    map.setView([41.58, -71.48], 9);
  }

  function setupPopupActions(mapElement: HTMLElement): void {
    mapElement.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }

      const button = target.closest<HTMLButtonElement>("[data-map-add-activation]");
      const reference = button?.dataset.reference;
      if (!reference) {
        return;
      }

      void trackAnalyticsEvent("activate-ri-2026", "map_action", {
        action: "add_to_plan",
      });

      document.dispatchEvent(
        new CustomEvent("activate-ri:add-park", {
          detail: { reference },
        }),
      );
    });
  }

  function setupCoverageFilter(
    mapElement: HTMLElement,
    map: L.Map,
    payload: MapPayload,
    layersByReference: Map<string, MapItemLayers>,
  ): () => void {
    const mapPreview = mapElement.closest(".map-preview");
    const filter = mapPreview?.querySelector<HTMLInputElement>("[data-map-coverage-filter]");
    const count = mapPreview?.querySelector<HTMLElement>("[data-map-coverage-count]");

    const applyFilter = () => {
      const onlyNeedsCoverage = filter?.checked ?? false;
      let coverageGapCount = 0;

      for (const item of payload.items) {
        const needsCoverage =
          item.coverage?.status === "uncovered" ||
          item.coverage?.status === "cancelled-needs-replacement";
        coverageGapCount += needsCoverage ? 1 : 0;

        for (const layer of layersByReference.get(item.reference)?.displayLayers ?? []) {
          if (!onlyNeedsCoverage || needsCoverage) {
            if (!map.hasLayer(layer)) {
              layer.addTo(map);
            }
          } else if (map.hasLayer(layer)) {
            map.removeLayer(layer);
          }
        }
      }

      if (count) {
        count.textContent = `(${coverageGapCount})`;
      }
    };

    filter?.addEventListener("change", () => {
      applyFilter();
      document.dispatchEvent(
        new CustomEvent("activate-ri:coverage-filter-change", {
          detail: { enabled: filter.checked },
        }),
      );
    });
    document.addEventListener("activate-ri:coverage-filter-change", (event) => {
      if (!filter) {
        return;
      }
      filter.checked =
        (event as CustomEvent<{ enabled?: boolean }>).detail?.enabled ?? false;
      applyFilter();
    });
    applyFilter();
    return applyFilter;
  }

  async function refreshLiveCoverage(
    mapElement: HTMLElement,
    payload: MapPayload,
    layersByReference: Map<string, MapItemLayers>,
    applyCoverageFilter: () => void,
  ): Promise<void> {
    try {
      const stops = await fetchPublicActivationStops();

      const coverageByReference = deriveCoverage(
        payload.parks,
        stops.filter((stop) => !stop.id.startsWith("sample-")),
        payload,
      );

      for (const item of payload.items) {
        item.coverage = coverageByReference.get(item.reference) ?? item.coverage;
        updateMapItemLayers(payload, item, layersByReference.get(item.reference));
      }
      updateMapLegend(mapElement, payload);
      applyCoverageFilter();
    } catch {
      return;
    }
  }

  function updateMapLegend(mapElement: HTMLElement, payload: MapPayload): void {
    const mapPreview = mapElement.closest(".map-preview");
    if (!mapPreview) {
      return;
    }

    const visibleStatuses = new Set(payload.resultsMode
      ? payload.items.flatMap((item) => [item.potaStatus?.status, item.potaStatus?.live ? "live" : undefined]).filter(Boolean)
      : payload.items.map((item) => item.coverage?.status).filter(Boolean));

    mapPreview.querySelectorAll<HTMLElement>("[data-map-legend-item]").forEach((item) => {
      if (item.dataset.mapLegendOptional !== "true") {
        item.hidden = false;
        return;
      }

      const statuses = (item.dataset.mapLegendStatuses ?? "").split(" ").filter(Boolean);
      item.hidden = !statuses.some((status) => visibleStatuses.has(status));
    });
  }

  function deriveCoverage(
    parks: PublicPark[],
    stops: PublicStop[],
    payload: MapPayload,
  ): Map<string, MapCoverage> {
    const stopsByReference = new Map<string, PublicStop[]>();
    for (const stop of stops) {
      const parkStops = stopsByReference.get(stop.parkReference) ?? [];
      parkStops.push(stop);
      stopsByReference.set(stop.parkReference, parkStops);
    }

    return new Map(
      parks.map((park) => {
        const parkStops = sortStops(stopsByReference.get(park.reference) ?? []);
        const scheduledStops = parkStops.filter((stop) =>
          stop.status === "scheduled" || stop.status === "delayed",
        );
        const completedStops = parkStops.filter((stop) => stop.status === "completed");
        const cancelledStops = parkStops.filter((stop) => stop.status === "cancelled");
        const status =
          scheduledStops.length > 1
            ? "multiple-scheduled"
            : scheduledStops.length === 1
              ? "scheduled"
              : completedStops.length > 0
                ? "completed"
                : cancelledStops.length > 0
                  ? "cancelled-needs-replacement"
                  : "uncovered";

        return [
          park.reference,
          {
            status,
            label: payload.coverageStatusLabels[status] ?? status,
            color: payload.referenceMapStatusColors[status] ?? "#172026",
            stops: parkStops,
          },
        ];
      }),
    );
  }

  function popupHtml(payload: MapPayload, item: MapItem): string {
    if (payload.variant === "home" || payload.variant === "directory") {
      return `
        <strong>${escapeHtml(item.reference)}</strong>
        <span>${escapeHtml(item.name)}</span>
        <em>${escapeHtml(detailLine(item))}</em>
        ${payload.variant === "home" ? liveSpotsHtml(item) : ""}
        <span>Map data comes from official POTA park data and reviewed public sources.</span>
        <span class="map-popup__links">
          ${localFieldGuideLink(item)}
          ${officialLink(item)}
        </span>
      `;
    }

    if (payload.resultsMode) {
      const status = item.potaStatus;
      return `
        <strong>${escapeHtml(item.reference)}</strong>
        <span>${escapeHtml(item.name)}</span>
        <em>${escapeHtml(detailLine(item))}</em>
        <span><b>${escapeHtml(potaStatusLabel(status?.status))}</b>${status?.live ? " · On air now" : ""}</span>
        ${potaEvidenceHtml(status)}
        ${status?.scheduled ? "<span>Planned event coverage is also scheduled; that plan is not POTA confirmation.</span>" : ""}
        <span class="map-popup__links">
          <a href="/activate-ri-2026/parks/">Open full evidence list</a>
          ${localFieldGuideLink(item)}
          ${officialLink(item)}
        </span>
      `;
    }

    const volunteerAction =
      payload.variant === "volunteer"
        ? `<button class="map-popup__action" type="button" data-map-add-activation data-reference="${escapeHtml(item.reference)}">Add activation</button>`
        : `<a href="/activate-ri-2026/volunteer/?park=${encodeURIComponent(item.reference)}" data-analytics-event="event_cta_clicked" data-analytics-feature="map" data-analytics-placement="map" data-analytics-action="volunteer">Volunteer for this park</a>`;

    return `
      <strong>${escapeHtml(item.reference)}</strong>
      <span>${escapeHtml(item.name)}</span>
      <em>${escapeHtml(detailLine(item))}</em>
      <span><b>${escapeHtml(item.coverage?.label ?? "Needs coverage")}</b></span>
      ${coverageStopsHtml(item)}
      <span class="map-popup__links">
        <a href="/activate-ri-2026/parks/">Open coverage table</a>
        ${localFieldGuideLink(item)}
        ${volunteerAction}
      </span>
    `;
  }

  function potaStatusLabel(status: string | undefined): string {
    return {
      confirmed: "POTA confirmed",
      observed: "Activity observed; not confirmed",
      scheduled: "Scheduled; not confirmed",
      needed: "Still needed",
    }[status ?? "needed"] ?? "Still needed";
  }

  function potaEvidenceHtml(status: PublicParkPotaStatus | undefined): string {
    if (status?.confirmation) {
      return `<span>${escapeHtml(status.confirmation.activeCallsign)} · ${escapeHtml(status.confirmation.qsoDate)} UTC · ${status.confirmation.totalQsos} QSOs</span>`;
    }
    if (status?.lastObservation) {
      return `<span>Last spotted ${escapeHtml(formatLiveSpotTime(status.lastObservation.lastObservedAt))} · ${escapeHtml(status.lastObservation.activeCallsign)}</span>`;
    }
    if ((status?.attempts.length ?? 0) > 0) {
      const attempt = status?.attempts[0];
      return attempt
        ? `<span>Attempt recorded: ${escapeHtml(attempt.activeCallsign)} · ${attempt.totalQsos} QSOs</span>`
        : "";
    }
    return "<span>No event POTA evidence yet.</span>";
  }

  function liveSpotsHtml(item: MapItem): string {
    const spots = item.liveSpots ?? [];
    if (spots.length === 0) {
      return "";
    }

    return `
      <span class="map-popup__live-label">On air now</span>
      <span class="map-popup__stops">
        ${spots.map((spot) => `
          <span class="map-popup__stop">
            <b>${escapeHtml(spot.activatorCallsign)}</b>
            <span>${escapeHtml(formatRadioDetails(spot.frequency, spot.mode))}</span>
            <span>Spotted ${escapeHtml(formatLiveSpotTime(spot.spotTime))}</span>
            ${spot.sourceLabel ? `<span>via ${escapeHtml(spot.sourceLabel)}</span>` : ""}
          </span>
        `).join("")}
      </span>
    `;
  }

  function formatRadioDetails(frequency: string, mode: string): string {
    const parts = [frequency ? `${frequency} kHz` : "", mode]
      .filter(Boolean);
    return parts.length > 0 ? parts.join(" · ") : "Not provided";
  }

  function coverageStopsHtml(item: MapItem): string {
    const stops = item.coverage?.stops ?? [];
    if (stops.length === 0) {
      return `<span>Needs coverage.</span>`;
    }

    return `
      <span class="map-popup__stops">
        ${stops.map((stop) => `
          <span class="map-popup__stop">
            <b>${escapeHtml(stop.activatorCallsign)}</b>
            <span>${escapeHtml(formatActivationDate(stop))}, ${escapeHtml(formatActivationTimeRange(stop))}</span>
            <span>${escapeHtml(formatList(stop.bands))} / ${escapeHtml(formatList(stop.modes))}</span>
            ${stop.publicNotes ? `<span>${escapeHtml(stop.publicNotes)}</span>` : ""}
          </span>
        `).join("")}
      </span>
    `;
  }

  function officialLink(item: MapItem): string {
    if (!item.potaUrl) {
      return "";
    }

    return `<a href="${escapeHtml(item.potaUrl)}" target="_blank" rel="noreferrer">Open official POTA page</a>`;
  }

  function localFieldGuideLink(item: MapItem): string {
    return `<a href="/parks/${encodeURIComponent(item.reference.toLowerCase())}/">Open local field guide</a>`;
  }

  function detailLine(item: MapItem): string {
    return [item.grid, item.locationDesc, item.counties.join(", ")].filter(Boolean).join(" · ");
  }

  function sortStops(stops: PublicStop[]): PublicStop[] {
    return [...stops].sort((left, right) => {
      const leftKey = `${left.plannedDate}T${left.startTime}`;
      const rightKey = `${right.plannedDate}T${right.startTime}`;
      return leftKey.localeCompare(rightKey);
    });
  }

  function formatList(items: string[]): string {
    return items.length > 0 ? items.join(", ") : "TBD";
  }

  function formatLiveSpotTime(value: string): string {
    const timestamp = /(Z|[+-]\d{2}:?\d{2})$/i.test(value) ? value : `${value}Z`;
    const date = new Date(timestamp);
    if (!Number.isFinite(date.valueOf())) {
      return value;
    }

    return new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: "UTC",
      timeZoneName: "short",
    }).format(date);
  }

  function escapeHtml(value: string): string {
    return String(value).replace(/[&<>"']/g, (char) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };

      return entities[char] ?? char;
    });
  }
</script>

