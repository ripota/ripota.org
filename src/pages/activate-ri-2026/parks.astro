---
import EventNav from "../../components/activate-ri/EventNav.astro";
import ParkCoverageTable from "../../components/activate-ri/ParkCoverageTable.astro";
import PotaParkProgress from "../../components/activate-ri/PotaParkProgress.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventPhaseViews from "../../components/activate-ri/EventPhaseViews.astro";
---

<BaseLayout
  title="Activate All RI 2026 Park Coverage"
  description="Coverage status for Rhode Island POTA references in Activate All RI 2026."
  canonicalPath="/activate-ri-2026/parks/"
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-label="Event park coverage">
      <div class="container">
        <EventNav />
        <EventPhaseViews>
        <div slot="planning">
        <div class="section-header">
          <p class="eyebrow">Park coverage</p>
          <h1 id="parks-title">Activation plans by park</h1>
          <p class="lead">
            Find planned activations across Rhode Island. Additional times, bands,
            and modes are welcome at parks already scheduled.
          </p>
        </div>
        <ParkCoverageTable />
        </div>
        <div slot="results">
          <div class="section-header">
            <p class="eyebrow">Park coverage</p>
            <h1>Event progress by park</h1>
            <p class="lead">Follow current spots, planned activations, and POTA confirmations across Rhode Island.</p>
          </div>
          <PotaParkProgress />
        </div>
        </EventPhaseViews>
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>
