---
import AdminDashboard from "../../components/activate-ri/AdminDashboard.astro";
import AdminOpsRoom from "../../components/activate-ri/AdminOpsRoom.astro";
import AdminPotaStatus from "../../components/activate-ri/AdminPotaStatus.astro";
import AdminAccountSecurity from "../../components/activate-ri/AdminAccountSecurity.astro";
import AdminMedia from "../../components/activate-ri/AdminMedia.astro";
import EventNav from "../../components/activate-ri/EventNav.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Activate All RI 2026 Admin"
  description="Organizer tools for Activate All RI 2026 plans, live coordination, event evidence, and account security."
  privatePage
  bodyClass="admin-app-page"
>
  <SiteHeader variant="solid" compact />
  <main id="main" class="admin-app-main">
    <section class="admin-app" aria-labelledby="admin-title" data-admin-app>
      <div class="container admin-app__container">
        <EventNav showProgress />
        <div class="admin-app__intro">
          <div>
            <p class="eyebrow">Organizer console</p>
            <h1 id="admin-title">Activate RI operations</h1>
          </div>
          <p class="lead">
            Run the room, help activators, and review event activity from one focused workspace.
          </p>
        </div>

        <nav class="admin-workspace-tabs" aria-label="Organizer workspaces" data-admin-workspace-tabs>
          <button type="button" data-admin-workspace="ops" aria-controls="admin-ops">Ops Room</button>
          <button type="button" data-admin-workspace="plans" aria-controls="admin-plans">Plans <span data-admin-plan-count></span></button>
          <button type="button" data-admin-workspace="activity" aria-controls="admin-activity">Activity</button>
          <button type="button" data-admin-workspace="pota" aria-controls="admin-pota">POTA evidence</button>
          <button type="button" data-admin-workspace="media" aria-controls="admin-media">Photos & Videos</button>
          <button type="button" data-admin-workspace="security" aria-controls="admin-security">Account security</button>
        </nav>

        <AdminDashboard />
        <AdminOpsRoom />
        <AdminPotaStatus />
        <AdminMedia />
        <AdminAccountSecurity />
      </div>
    </section>
    <Notice />
  </main>
</BaseLayout>

<script>
  import { setupAdminTabs } from "../../lib/activate-ri/admin-tabs";

  const adminApp = document.querySelector<HTMLElement>("[data-admin-app]");
  const workspaceTabs = adminApp?.querySelector<HTMLElement>("[data-admin-workspace-tabs]");
  const workspaceKey = "activate-ri-admin-workspace";
  const validWorkspaces = new Set(["ops", "plans", "activity", "pota", "media", "security"]);

  if (adminApp && workspaceTabs) {
    const buttons = [...workspaceTabs.querySelectorAll<HTMLButtonElement>("[data-admin-workspace]")];
    const panels = buttons.map((button) => document.getElementById(button.getAttribute("aria-controls")!)!);
    const showWorkspace = setupAdminTabs(workspaceTabs, buttons, panels, (next) => {
      try { localStorage.setItem(workspaceKey, next); } catch { /* Storage is optional. */ }
      const url = new URL(location.href);
      url.searchParams.delete("view");
      url.hash = next;
      history.replaceState(null, "", url);
    });
    function requestedWorkspace(): string {
      const hash = location.hash.slice(1);
      if (validWorkspaces.has(hash)) return hash;
      const requested = new URL(location.href).searchParams.get("view") ?? "";
      if (validWorkspaces.has(requested)) return requested;
      if (hash.startsWith("ops-message-")) return "ops";
      try {
        const saved = localStorage.getItem(workspaceKey) ?? "ops";
        return validWorkspaces.has(saved) ? saved : "ops";
      } catch { return "ops"; }
    }
    showWorkspace(requestedWorkspace(), false);
    window.addEventListener("hashchange", () => showWorkspace(requestedWorkspace(), false));
  }
</script>
