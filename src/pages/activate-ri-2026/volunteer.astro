---
import EventNav from "../../components/activate-ri/EventNav.astro";
import VolunteerForm from "../../components/activate-ri/VolunteerForm.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import ReferenceMap from "../../components/ReferenceMap.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { eventPhaseAt } from "../../lib/activate-ri/event-phase";

const registrationClosed = eventPhaseAt() === "post-event";
---

<BaseLayout
  title="Volunteer for Activate All RI 2026"
  description="Submit a Rhode Island POTA activation plan for organizer review."
  canonicalPath="/activate-ri-2026/volunteer/"
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="volunteer-title">
      <div class="container">
        <EventNav />
        <div class="section-header">
          <p class="eyebrow">Activator signup</p>
          <h1 id="volunteer-title" tabindex="-1">{registrationClosed ? "2026 registration is closed" : "Volunteer to activate"}</h1>
          <p class="lead" data-volunteer-introduction>
            {registrationClosed
              ? "Thank you for putting Rhode Island on the air. New activation plans for this event are now closed."
              : "Add one park or a multi-park route. More activations are welcome at parks already scheduled. New plans appear after organizer review."}
          </p>
        </div>
        <div data-volunteer-closed hidden={!registrationClosed}>
          <p>Existing activators can still open My Plan, manage their account, and share photos from the weekend.</p>
          <div class="button-row">
            <a class="button" data-variant="primary" href="/activate-ri-2026/">Explore the event recap</a>
            <a class="button" data-variant="light" href="/activate-ri-2026/activator/media/">Share photos</a>
            <a class="button" data-variant="light" href="/activate-ri-2026/activator/plan/">Open My Plan</a>
          </div>
          <p><a href="/activate-ri-2026/media/">Browse the event photos</a> or <a href="/activate-ri-2026/help/">contact the organizers</a> if you need help with a correction.</p>
        </div>
        <div data-volunteer-registration-open hidden={registrationClosed}>
        <aside class="event-guidance event-guidance--compact" data-volunteer-account-state>
          <p data-volunteer-account-message>
            Already signed up? <a data-volunteer-my-plan href="/activate-ri-2026/activator/plan/">Open My Plan</a>
            to add parks or change your stops. New here? We'll email you a link after you submit.
          </p>
        </aside>
        <VolunteerForm />
        <ReferenceMap
          id="activate-ri-volunteer-map"
          variant="volunteer"
          title="Choose a park from the map"
          caption="Use the map to add a stop to the form above. Review your dates and times before submitting."
          phaseFocus="volunteer"
          showBoundaries={false}
        />
        <section
          class="event-guidance event-guidance--compact"
          id="update-your-plan-when-things-change"
          aria-labelledby="after-submit-title"
        >
          <div class="section-header section-header--compact">
            <p class="eyebrow">After submitting</p>
            <h2 id="after-submit-title">
              <a
                class="section-heading-anchor"
                href="#update-your-plan-when-things-change"
                aria-label="Update My Plan when things change"
              >
                Update My Plan when things change
              </a>
            </h2>
            <p class="lead">
              We'll email you a link to open and update your plan. Each link
              works once and expires in 15 minutes; request another if needed.
              You can also save a passkey for faster sign-in.
            </p>
          </div>
          <ul class="event-help-list">
            <li>Pending plans stay in organizer review until approved.</li>
            <li>Use the same email address to keep all your stops together.</li>
            <li>Approved plans should be updated instead of submitted again.</li>
          </ul>
        </section>
        <div class="button-row">
          <a class="button" data-variant="light" data-volunteer-sign-in href="/account/sign-in/?returnTo=%2Factivate-ri-2026%2Factivator%2Fplan%2F">
            Sign in to My Plan
          </a>
        </div>
        </div>
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { planningPrefillPlanUrl, readPlanningPrefill } from "../../lib/activate-ri/planning-prefill";
  import { subscribeEventPhase } from "../../lib/activate-ri/event-phase";

  const registration = document.querySelector<HTMLElement>("[data-volunteer-registration-open]");
  const closedNotice = document.querySelector<HTMLElement>("[data-volunteer-closed]");
  const heading = document.querySelector<HTMLElement>("#volunteer-title");
  const introduction = document.querySelector<HTMLElement>("[data-volunteer-introduction]");
  subscribeEventPhase((phase) => {
    const closed = phase === "post-event";
    const focusedRegistration = closed && registration?.contains(document.activeElement);
    if (registration) registration.hidden = closed;
    if (closedNotice) closedNotice.hidden = !closed;
    if (heading) heading.textContent = closed ? "2026 registration is closed" : "Volunteer to activate";
    if (introduction) introduction.textContent = closed
      ? "Thank you for putting Rhode Island on the air. New activation plans for this event are now closed."
      : "Add one park or a multi-park route. More activations are welcome at parks already scheduled. New plans appear after organizer review.";
    if (focusedRegistration) heading?.focus();
  });

  const planUrl = planningPrefillPlanUrl(readPlanningPrefill(window.location.search));
  const existingPlanLink = document.querySelector<HTMLAnchorElement>("[data-volunteer-my-plan]");
  if (existingPlanLink) existingPlanLink.href = planUrl;
  const signInLink = document.querySelector<HTMLAnchorElement>("[data-volunteer-sign-in]");
  if (signInLink) signInLink.href = `/account/sign-in/?${new URLSearchParams({ returnTo: planUrl })}`;
  const message = document.querySelector<HTMLElement>("[data-volunteer-account-message]");
  void showAccountState();
  async function showAccountState(): Promise<void> {
    try {
    const response = await fetch("/api/auth/session", { headers: { accept: "application/json" } });
    const body = await response.json().catch(() => null);
    if (!isRecord(body) || body.signedIn !== true || !isRecord(body.user)) return;
    const email = typeof body.user.email === "string" ? body.user.email : "your RI POTA account";
    const planLink = document.createElement("a");
    planLink.href = planUrl;
    planLink.textContent = "Open My Plan";
    message?.replaceChildren(`Signed in as ${email}. Use the same email to keep your stops together. `, planLink);
    } catch {
      // The signup form remains usable when the optional account hint cannot load.
    }
  }
  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === "object" && value !== null && !Array.isArray(value);
  }
</script>
