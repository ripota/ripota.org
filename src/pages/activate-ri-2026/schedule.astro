---
import EventNav from "../../components/activate-ri/EventNav.astro";
import ScheduleTable from "../../components/activate-ri/ScheduleTable.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { eventPhaseAt } from "../../lib/activate-ri/event-phase";
const postEvent = eventPhaseAt() === "post-event";
---

<BaseLayout
  title="Activate All RI 2026 Schedule"
  description="Planned Activate All RI 2026 activation windows by date, park, and activator."
  canonicalPath="/activate-ri-2026/schedule/"
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="schedule-title">
      <div class="container">
        <EventNav />
        <div class="section-header">
          <p class="eyebrow">Activation windows</p>
          <h1 id="schedule-title">Event schedule</h1>
          <p class="lead" data-schedule-live hidden={postEvent}>
            Planned activation times for Activate All RI 2026. Check current POTA spots for frequencies and changes.
          </p>
          <p class="lead" data-schedule-archive hidden={!postEvent}>The plans shared for Activate All RI 2026, preserved here as the event schedule. For what was recorded on the air, <a href="/activate-ri-2026/parks/">see the park results</a>.</p>
          <p data-schedule-live hidden={postEvent}><a class="button" href="/on-air/">See RI on air now</a></p>
        </div>
        <ScheduleTable />
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { subscribeEventPhase } from "../../lib/activate-ri/event-phase";
  subscribeEventPhase((phase) => {
    document.querySelectorAll<HTMLElement>("[data-schedule-live]").forEach((element) => { element.hidden = phase === "post-event"; });
    document.querySelectorAll<HTMLElement>("[data-schedule-archive]").forEach((element) => { element.hidden = phase !== "post-event"; });
  });
</script>
