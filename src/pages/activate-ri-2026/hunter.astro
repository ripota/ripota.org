---
import EventNav from "../../components/activate-ri/EventNav.astro";
import HunterChecklist from "../../components/activate-ri/HunterChecklist.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { eventEnd, eventPhaseAt } from "../../lib/activate-ri/event-phase";
const postEvent = eventPhaseAt() === "post-event";
---

<BaseLayout
  title="Activate All RI 2026 Hunters"
  description="Thank you to the hunters who joined Activate All RI 2026. Find the event recap and park results."
  canonicalPath="/activate-ri-2026/hunter/"
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="hunter-title">
      <div class="container">
        <EventNav />
        <div class="section-header">
          <p class="eyebrow">For hunters</p>
          <h1 id="hunter-title" tabindex="-1">{postEvent ? "Thanks for answering the call." : "For Rhode Island hunters"}</h1>
          <div data-hunter-retired hidden={!postEvent}>
            <p class="lead">The 2026 event checklist has been retired. Thank you for listening for Rhode Island and helping fill the logs.</p>
            <p>Any checklist data you saved in this browser has been left in place.</p>
            <div class="hunter-page-actions">
              <a class="button" data-variant="primary" href="/activate-ri-2026/">See the event recap</a>
              <a class="button" data-variant="light" href="/activate-ri-2026/parks/">Explore park results</a>
            </div>
          </div>
        </div>
        <div data-hunter-tool-mount></div>
        <noscript>
          <style>#main [data-hunter-retired] { display: block !important; }</style>
        </noscript>
        <template data-hunter-tool-template>
        <div data-hunter-active>
        <div class="section-header">
          <p class="lead">
            Work toward POTA's Worked All RI award by hunting Rhode Island's 61 current references.
            Find parks you still need and plan when to listen.
          </p>
          <div class="hunter-page-actions">
            <a class="button" data-variant="primary" href="/activate-ri-2026/schedule/">View event schedule</a>
            <a class="button" data-variant="light" href="/on-air/">See RI on air now</a>
            <a class="button" data-variant="light" href="/activate-ri-2026/media/">Explore photos</a>
          </div>
          <p>
            Already hunted RI parks? Import your POTA Hunted Parks CSV below to personalize your schedule.
            You can also start a blank checklist or enter the park references you want to hunt.
            Your past contacts count toward the chase; this checklist is not limited to the event.
            <a href="https://docs.pota.app/docs/awards.html#worked-all-references-awards" target="_blank" rel="noopener noreferrer">See the official POTA award details</a>.
          </p>
        </div>
        <HunterChecklist />
        </div>
        </template>
        <script is:inline define:vars={{ eventEnd }}>
          // Keep the retired tool inert. Historical pre-event views mount before
          // the component's deferred script initializes, without touching storage.
          if (Date.now() < eventEnd) {
            const template = document.querySelector("[data-hunter-tool-template]");
            if (template instanceof HTMLTemplateElement) {
              document.querySelector("[data-hunter-tool-mount]")?.appendChild(template.content);
              template.remove();
            }
          }
        </script>
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { subscribeEventPhase } from "../../lib/activate-ri/event-phase";
  subscribeEventPhase((phase) => {
    const postEvent = phase === "post-event";
    const heading = document.querySelector<HTMLElement>("#hunter-title");
    const notice = document.querySelector<HTMLElement>("[data-hunter-retired]");
    const active = document.querySelector<HTMLElement>("[data-hunter-active]");
    if (heading) heading.textContent = postEvent ? "Thanks for answering the call." : "Plan your Worked All RI hunt";
    if (notice) notice.hidden = !postEvent;
    if (postEvent && active) {
      const moveFocus = active.contains(document.activeElement);
      active.remove();
      if (moveFocus) heading?.focus();
    }
  });
</script>

<style>
  .hunter-page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0;
  }
</style>
