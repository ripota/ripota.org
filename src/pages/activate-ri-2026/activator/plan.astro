---
import ActivatorEditForm from "../../../components/activate-ri/ActivatorEditForm.astro";
import ActivatorPlanPrint from "../../../components/activate-ri/ActivatorPlanPrint.astro";
import ActivatorPortalNav from "../../../components/activate-ri/ActivatorPortalNav.astro";
import EventNav from "../../../components/activate-ri/EventNav.astro";
import Footer from "../../../components/Footer.astro";
import Notice from "../../../components/Notice.astro";
import ReferenceMap from "../../../components/ReferenceMap.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Edit Activate All RI 2026 Plan"
  description="Private Activate All RI 2026 activator plan editor."
  privatePage
  bodyClass="activator-plan-page"
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="edit-title">
      <div class="container">
        <EventNav />
        <ActivatorPortalNav />
        <div class="section-header">
          <p class="eyebrow">My activation plan</p>
          <h1 id="edit-title">My Plan</h1>
          <p class="lead">
            Update your Activate All RI 2026 plan before or after organizer
            approval.
          </p>
          <div class="button-row">
            <button class="button" data-variant="light" type="button" data-print-plan disabled aria-describedby="plan-print-help">
              Print my plan
            </button>
          </div>
          <p class="form-help" id="plan-print-help">Prints your saved plan. Save changes before printing.</p>
        </div>
        <ActivatorEditForm />
        <ReferenceMap
          id="activate-ri-edit-map"
          variant="volunteer"
          title="Choose a park from the map"
          caption="Use the map to add a stop to your activation plan above. Save changes when your plan is ready."
          phaseFocus="volunteer"
          showBoundaries={false}
        />
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
  <ActivatorPlanPrint />
</BaseLayout>
