---
import ActivatorPortalNav from "../../../components/activate-ri/ActivatorPortalNav.astro";
import ActivatorOpsRoom from "../../../components/activate-ri/ActivatorOpsRoom.astro";
import EventNav from "../../../components/activate-ri/EventNav.astro";
import Notice from "../../../components/Notice.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Activate All RI 2026 Activator Portal"
  description="Private Activate All RI 2026 activator portal."
  privatePage
  bodyClass="ops-app-page"
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main" class="ops-app-main">
    <section class="ops-app" aria-labelledby="portal-title">
      <div class="container ops-app__container">
        <EventNav />
        <ActivatorPortalNav />
        <div class="ops-app__intro">
          <div>
            <p class="eyebrow">Activate All RI · private coordination</p>
            <h1 id="portal-title">Ops Room</h1>
          </div>
          <p>
            Quick updates from the field. Not continuously monitored or for emergencies.
          </p>
        </div>
        <ActivatorOpsRoom />
      </div>
    </section>
    <Notice />
  </main>
</BaseLayout>
