---
import ActivatorMedia from "../../components/activate-ri/ActivatorMedia.astro";
import EventNav from "../../components/activate-ri/EventNav.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import shareCardMetadata from "../../../public/assets/activate-ri-2026-media-share-card.meta.json";

const galleryShareImage = {
  src: `/assets/activate-ri-2026-media-share-card.png?v=${shareCardMetadata.fingerprint.slice(0, 16)}`,
  alt: "Photos & videos from Activate All RI 2026, with a framed Rhode Island shoreline photo and RI POTA branding.",
  width: shareCardMetadata.width,
  height: shareCardMetadata.height,
  type: "image/png",
};
---

<BaseLayout title="Photos & Videos — Activate All RI 2026" description="See the places, people, and moments behind Activate All RI 2026, captured by Rhode Island park activators." canonicalPath="/activate-ri-2026/media/" image={galleryShareImage}>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page media-page" aria-labelledby="public-media-title">
      <div class="container stack">
        <EventNav />
        <ActivatorMedia publicGallery />
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>

<style>
  .media-page { padding-block: clamp(1rem, 3vw, 2rem) 3rem; }
</style>
