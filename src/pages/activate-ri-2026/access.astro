---
import EditLinkResendForm from "../../components/activate-ri/EditLinkResendForm.astro";
import EventNav from "../../components/activate-ri/EventNav.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Activate All RI 2026 Private Access"
  description="Private access for Activate All RI 2026 activators."
  privatePage
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="access-title">
      <div class="container">
        <EventNav />
        <div class="section-header">
          <p class="eyebrow">Private activator access</p>
          <h1 id="access-title">Activator portal access</h1>
          <p class="lead" data-access-status aria-live="polite">
            Checking this browser for an active activator session…
          </p>
          <p data-access-help hidden>
            Open the private link from your signup email to authorize this browser for 14 days,
            or request a fresh link below.
          </p>
        </div>
        <div class="event-guidance event-guidance--compact" data-access-recovery hidden>
          <section class="event-guidance__item" aria-labelledby="new-activator-title">
            <p class="eyebrow">New activator</p>
            <h2 id="new-activator-title">Volunteer to activate</h2>
            <p>
              Submit one park or a multi-park route for organizer review. You do not
              need a private link to get started.
            </p>
            <div class="button-row">
              <a class="button" data-variant="primary" href="/activate-ri-2026/volunteer/">
                Plan an activation
              </a>
            </div>
          </section>
          <EditLinkResendForm />
        </div>
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>("[data-access-status]");
  const help = document.querySelector<HTMLElement>("[data-access-help]");
  const token = decodeURIComponent(window.location.hash.slice(1));
  window.history.replaceState(null, "", window.location.pathname);

  void openPortal();

  async function openPortal(): Promise<void> {
    try {
      if (!token) {
        const existing = await fetch("/api/activate-ri-2026/activator/session", {
          headers: { accept: "application/json" },
        });
        if (existing.ok) {
          window.location.replace("/activate-ri-2026/activators/");
          return;
        }

        showFailure("No active activator session was found in this browser.");
        return;
      }

      const response = await fetch("/api/activate-ri-2026/activator/session", {
        method: "POST",
        headers: {
          accept: "application/json",
          "content-type": "application/json",
        },
        body: JSON.stringify({ token }),
      });
      if (!response.ok) {
        showFailure("This private link is invalid or has been replaced.");
        return;
      }

      window.location.replace("/activate-ri-2026/activators/plan/");
    } catch {
      showFailure("Private access is temporarily unavailable. Please try again.");
    }
  }

  function showFailure(message: string): void {
    status?.replaceChildren(message);
    help?.removeAttribute("hidden");
    document.querySelector("[data-access-recovery]")?.removeAttribute("hidden");
  }
</script>
