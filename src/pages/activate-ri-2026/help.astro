---
import EventNav from "../../components/activate-ri/EventNav.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { eventPhaseAt } from "../../lib/activate-ri/event-phase";
const postEvent = eventPhaseAt() === "post-event";

const qrzEmbedSnippet = `<p style="margin: 0 auto; max-width: 960px; text-align: center;">
  <iframe
    src="https://ripota.org/embed/activate-ri-2026/"
    title="Activate All RI 2026"
    width="100%"
    height="420"
    frameborder="0"
    scrolling="no"
  ></iframe>
</p>`;
---

<BaseLayout
  title="Activate All RI 2026 Help"
  description="Help with Activate All RI 2026 logs, hunter credit, photos, account access, and corrections."
  canonicalPath="/activate-ri-2026/help/"
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="faq-title">
      <div class="container">
        <EventNav />
        <div class="section-header">
          <p class="eyebrow" data-help-before="Event guide" data-help-after="Activate All RI 2026">{postEvent ? "Activate All RI 2026" : "Event guide"}</p>
          <h1 id="faq-title" tabindex="-1" data-help-before="Activate All RI FAQ" data-help-after="A few things to wrap up">{postEvent ? "A few things to wrap up" : "Activate All RI FAQ"}</h1>
          <p class="lead" data-help-live hidden={postEvent}>
            Find event details and practical answers for activators and hunters
            participating in Activate All RI 2026.
          </p>
          <p class="lead" data-help-archive hidden={!postEvent}>Thank you for being part of the weekend. Here’s where to send your logs and photos, check a missing contact, or get a hand with your account.</p>
        </div>

        <nav class="faq-jump-links" aria-label="FAQ sections">
          <a href="#general-faq" data-help-before="General FAQ" data-help-after="Logs & results">{postEvent ? "Logs & results" : "General FAQ"}</a>
          <a href="#activator-faq" data-help-before="Activator FAQ" data-help-after="Photos & your account">{postEvent ? "Photos & your account" : "Activator FAQ"}</a>
          <a href="#hunter-faq" data-help-before="Hunter FAQ" data-help-after="Hunter credit & corrections">{postEvent ? "Hunter credit & corrections" : "Hunter FAQ"}</a>
        </nav>

        <div class="faq-groups">
          <section class="faq-group" id="general-faq" aria-labelledby="general-faq-title">
            <div class="faq-group__header">
              <p class="eyebrow" data-help-live hidden={postEvent}>About the weekend</p>
              <h2 id="general-faq-title" data-help-before="General FAQ" data-help-after="Logs and results">{postEvent ? "Logs and results" : "General FAQ"}</h2>
            </div>
            <div class="event-guidance event-guidance--stacked" data-help-archive hidden={!postEvent}>
              <article class="event-guidance__item">
                <h3>Still have a log to upload?</h3>
                <p>Please upload it to the <a href="https://pota.app/">official POTA app</a> as usual. It isn’t too late: POTA has no log-submission deadline. Even an attempt with fewer than 10 contacts can give your hunters credit. See the <a href="https://docs.pota.app/docs/rules.html#logging-requirements">POTA logging rules</a>.</p>
              </article>
              <article class="event-guidance__item">
                <h3>Why are the results still changing?</h3>
                <p>The <a href="/activate-ri-2026/#weekend-results">recap numbers</a> and <a href="/activate-ri-2026/parks/">park results</a> are provisional while logs arrive. A spot or a planned stop isn’t a confirmed activation. The <a href="/activate-ri-2026/schedule/">2026 schedule</a> preserves what people planned; the park results show what was recorded.</p>
                <details>
                  <summary>Which dates do the results cover?</summary>
                  <p>Our reporting window runs from September 10 at 00:00 UTC up to September 14 at 00:00 UTC, including the early start. That’s September 9 at 8 p.m. through September 13 at 8 p.m. EDT. These are the site’s reporting boundaries, not a POTA log-submission deadline.</p>
                </details>
              </article>
            </div>
            <div class="event-guidance event-guidance--stacked" data-help-live hidden={postEvent}>
              <article class="event-guidance__item">
                <h3>What is Activate All RI?</h3>
                <p>
                  Activate All RI is a three-day POTA activation effort from
                  Friday, September 11 through Sunday, September 13. We hope
                  operators will join in an attempt to activate all 61 Rhode
                  Island POTA references. Hunters can work toward completing
                  their Rhode Island hunted list, and activators can add a few
                  new parks to their lists too.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>Can I join the early activations on September 10?</h3>
                <p>
                  Yes. Early activity is planned for Thursday, September 10,
                  before the main September 11–13 weekend. Browse the
                  <a href="/activate-ri-2026/schedule/?timeline=2026-09-10">September 10 schedule</a>
                  for planned windows and check <a href="/on-air/">Rhode Island on air</a>
                  for current spots.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>Which time zone does the schedule use?</h3>
                <p>
                  The event-day filter always uses Rhode Island's calendar day.
                  The time-zone selector changes the dates and times displayed
                  in the schedule and its printout. Eastern (RI / EDT) is four
                  hours behind UTC during the event: September 10 at 9 p.m. EDT
                  appears as September 11 at 01:00 UTC, while remaining in the
                  September 10 event-day filter.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>What period do the event progress pages cover?</h3>
                <p>
                  This site's <a href="/activate-ri-2026/progress/">event progress</a>
                  uses September 10 at 00:00 UTC up to September 14 at 00:00 UTC:
                  September 9 at 8 p.m. through September 13 at 8 p.m. EDT.
                  These are reporting boundaries, not park operating hours or
                  an official POTA award deadline. Official POTA rules still
                  determine credit.
                </p>
              </article>

              <article class="event-guidance__item" data-help-live hidden={postEvent}>
                <h3>How can I promote the event?</h3>
                <p>
                  Include an announcement on your nets, talk it up on the air,
                  and post to social media. You can share the
                  <a href="https://drive.google.com/file/d/1gtihnT-KiDTAM71OzQ87f64ijt6jTXsA/view?usp=sharing">Activate All Rhode Island poster PDF</a>.
                </p>
              </article>

              <article class="event-guidance__item" data-help-live hidden={postEvent}>
                <h3>I heard there is a cookout. What are the details?</h3>
                <p>
                  Newport County Radio Club has invited Activate All Rhode
                  Island participants to a cookout on Sunday, September 13 from
                  11 a.m. to 4 p.m. at Colt State Park, Pavilion 2. There is no
                  charge, but optional donations to offset the cost are
                  appreciated. Please
                  <a href="https://forms.gle/sE3GeGEasuigx6u79">RSVP for the NCRC cookout</a>.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>Which information comes from official POTA resources?</h3>
                <p>
                  ripota.org is an unofficial community coordination site.
                  Official Parks on the Air resources remain authoritative for
                  rules, references, accounts, spots, logs, awards, and whether
                  an activation is valid. Use the
                  <a href="https://docs.pota.app/">official POTA documentation</a>
                  and <a href="https://pota.app/">POTA app</a> as the source of
                  truth.
                </p>
              </article>
            </div>
          </section>

          <section class="faq-group" id="activator-faq" aria-labelledby="activator-faq-title">
            <div class="faq-group__header">
              <p class="eyebrow" data-help-live hidden={postEvent}>Putting parks on the air</p>
              <h2 id="activator-faq-title" data-help-before="Activator FAQ" data-help-after="Photos and your account">{postEvent ? "Photos and your account" : "Activator FAQ"}</h2>
            </div>
            <div class="event-guidance event-guidance--stacked" data-help-archive hidden={!postEvent}>
              <article class="event-guidance__item">
                <h3>Have a photo to share?</h3>
                <p>We’d love to see your view of the weekend. Activators can <a href="/activate-ri-2026/activator/media/">add photos</a> through their existing account. You can also <a href="/activate-ri-2026/media/">browse the event gallery</a> to see what others shared.</p>
              </article>
              <article class="event-guidance__item">
                <h3>Can I still get into my account?</h3>
                <p>Yes. <a href="/activate-ri-2026/activator/plan/">Open My Plan</a>, or <a href="/account/sign-in/?returnTo=%2Factivate-ri-2026%2Factivator%2Fplan%2F">sign in with your passkey or an email link</a> using the address on your plan. Registration for new 2026 plans is closed, but existing activators can still make corrections and share media. If you’re stuck, <a href="#corrections">get in touch below</a>.</p>
              </article>
            </div>
            <div class="event-guidance event-guidance--stacked" data-help-live hidden={postEvent}>
              <article class="event-guidance__item" data-help-live hidden={postEvent}>
                <h3>How do I sign up to put one or more RI parks on the air?</h3>
                <p>
                  Open the <a href="/activate-ri-2026/volunteer/">activator signup</a>
                  and add one park or a multi-park route to the event schedule.
                </p>
              </article>

              <article class="event-guidance__item" data-help-live hidden={postEvent}>
                <h3>Can I schedule a park that already has an activation scheduled?</h3>
                <p>
                  Yes. Most, if not all, parks have at least one activation
                  scheduled, but please add more. Multiple activations and modes
                  give hunters more opportunities to get Rhode Island in the
                  log.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>What seasonal access and facilities should I check?</h3>
                <p>
                  Check the park's official website and posted hours before
                  leaving. DEM's <a href="https://dem.ri.gov/press-releases/wave-goodbye-state-beach-season">September 1 beach-season notice</a>
                  says state beach pavilion restrooms close after September 7.
                  Beach parking gates and lots remain open unless extreme
                  weather requires closure; portable toilets are available at
                  most state beaches as conditions allow.
                </p>
                <p>
                  Starting Saturday, September 12, 2026,
                  <a href="https://rules.sos.ri.gov/Regulations/part/250-100-00-7">Rhode Island's orange-clothing rule (§ 7.23)</a>
                  requires nonexempt users of state management areas and
                  designated undeveloped state parks to wear 200 square inches
                  of solid daylight fluorescent orange. This includes people
                  who are not hunting. Check the
                  <a href="https://rules.sos.ri.gov/Regulations/part/250-60-00-9">hunting regulations and exemptions</a>
                  for the area you plan to visit.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>I've scheduled a park on ripota.org. What else do I need to do?</h3>
                <p>
                  Follow all the usual steps for activating a park. You can
                  pre-schedule your activation and spot yourself in the
                  <a href="https://pota.app/">official POTA app</a>. Keep a good
                  log and upload it to POTA as usual when you are done.
                </p>
                <p>
                  If your plans change or you need to cancel, please update your
                  ripota.org plan so hunters and other activators see the latest
                  estimate.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>How do I update or cancel my activation plan?</h3>
                <p>
                  Open <a href="/account/sign-in/?returnTo=%2Factivate-ri-2026%2Factivator%2Fplan%2F">RI POTA sign-in</a>
                  and sign in with a passkey or request a 15-minute, single-use
                  email link for the address on your plan. Previously issued
                  private links continue to work. In My Plan, update the time,
                  parks, bands, modes, notes, or cancellation status as needed.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>How do I add the Activate All RI widget to my QRZ biography?</h3>
                <p>
                  On QRZ, choose <strong>Edit your callsign</strong>, then
                  <strong>Add or edit your biography text, fonts, etc.</strong>
                  In the biography editor, choose <strong>Source</strong> and
                  paste this iframe where you want the event widget to appear.
                  Choose the disk icon to save, then return to your callsign
                  listing.
                </p>
                <pre class="faq-code"><code>{qrzEmbedSnippet}</code></pre>
              </article>

              <article class="event-guidance__item">
                <h3>I've completed my activation. What now?</h3>
                <p>
                  Upload your log as usual to the official POTA app and
                  congratulate yourself on a job well done. Come to the Sunday
                  cookout at Colt State Park if you can. Thanks for
                  participating.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>What if I have a problem or question during the event?</h3>
                <p>
                  Activators can use the in-app chat in the
                  <a href="/activate-ri-2026/activator/">Activator Ops Room</a>
                  for event coordination. You can also call:
                </p>
                <ul class="event-help-list">
                  <li>Rob Jackson, N1RWJ, or Brian Swann, N1BS: <a href="tel:+14012625225">401-262-5225</a></li>
                  <li>Brian Maynard, K1NW: <a href="tel:+14014875958">401-487-5958</a></li>
                </ul>
              </article>
            </div>
          </section>

          <section class="faq-group" id="hunter-faq" aria-labelledby="hunter-faq-title">
            <div class="faq-group__header">
              <p class="eyebrow" data-help-live hidden={postEvent}>Finding Rhode Island activations</p>
              <h2 id="hunter-faq-title" data-help-before="Hunter FAQ" data-help-after="Hunter credit and corrections">{postEvent ? "Hunter credit and corrections" : "Hunter FAQ"}</h2>
            </div>
            <div class="event-guidance event-guidance--stacked" data-help-archive hidden={!postEvent}>
              <article class="event-guidance__item">
                <h3>A park I hunted hasn’t appeared in POTA yet.</h3>
                <p>The activator’s log may still be on its way. <a href="https://docs.pota.app/docs/rules.html#logging-requirements">Hunters receive credit through activator logs</a> and don’t submit their own logs to POTA. Check your <a href="https://pota.app/">official POTA record</a> as logs come in.</p>
              </article>
              <article class="event-guidance__item" id="corrections">
                <h3>Something looks wrong, or I need a hand.</h3>
                <p>Feel free to reach out to any of us. We’re happy to help.</p>
                <ul class="event-help-list">
                  <li><a href="https://www.qrz.com/db/N1RWJ">Rob Jackson — N1RWJ</a></li>
                  <li><a href="https://www.qrz.com/db/N1BS">Brian Swann — N1BS</a></li>
                  <li><a href="https://www.qrz.com/db/K1NW">Brian Maynard — K1NW</a></li>
                </ul>
              </article>
            </div>
            <div class="event-guidance event-guidance--stacked" data-help-live hidden={postEvent}>
              <article class="event-guidance__item">
                <h3>I'm a POTA hunter. How do I participate?</h3>
                <p>
                  Open <a href="/on-air/">Rhode Island on air</a> to find current
                  spots, then review the <a href="/activate-ri-2026/schedule/">event schedule</a>
                  and <a href="/activate-ri-2026/parks/">Rhode Island parks</a>.
                  Decide which references you most want to contact and note the
                  planned activation windows. The schedule is an estimate, not
                  a guarantee that an activator will be on the air at that time.
                </p>
                <p>
                  You can also open the
                  <a href="/activate-ri-2026/hunter/">Rhode Island hunter checklist</a>
                  and import your official POTA <code>hunter_parks.csv</code> to
                  see which of the 61 references you have already hunted. The
                  file stays in your browser and is not uploaded.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>How can I find participating activators on the air?</h3>
                <p>
                  Use <a href="/on-air/">Rhode Island on air</a>. It shows
                  current official POTA spots at Rhode Island references and
                  refreshes about once a minute. The event schedule is only an
                  estimate; the on-air page is where to check live activity.
                </p>
              </article>

              <article class="event-guidance__item">
                <h3>Do I need to do anything after contacting an activator?</h3>
                <p>
                  Hunters do not submit logs to POTA. Your official hunter
                  credit comes from the activator's uploaded log, so it may
                  appear later, even after the weekend. See the
                  <a href="https://docs.pota.app/docs/rules.html#logging-requirements">official POTA logging rules</a>.
                  Marking a park in this site's checklist only updates your
                  personal list; POTA determines official credit and
                  <a href="https://docs.pota.app/docs/awards.html#geographic-awards">awards</a>.
                </p>
              </article>
            </div>
          </section>
        </div>
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { subscribeEventPhase } from "../../lib/activate-ri/event-phase";
  subscribeEventPhase((phase) => {
    const moveFocus = phase === "post-event" && Array.from(document.querySelectorAll<HTMLElement>("[data-help-live]")).some((element) => element.contains(document.activeElement));
    document.querySelectorAll<HTMLElement>("[data-help-live]").forEach((element) => { element.hidden = phase === "post-event"; });
    document.querySelectorAll<HTMLElement>("[data-help-archive]").forEach((element) => { element.hidden = phase !== "post-event"; });
    if (moveFocus) document.querySelector<HTMLElement>("#faq-title")?.focus();
    document.querySelectorAll<HTMLElement>("[data-help-before][data-help-after]").forEach((element) => {
      element.textContent = (phase === "post-event" ? element.dataset.helpAfter : element.dataset.helpBefore) ?? "";
    });
  });
</script>
