---
import EventHero from "../../components/activate-ri/EventHero.astro";
import EventNav from "../../components/activate-ri/EventNav.astro";
import VolunteerCtaBand from "../../components/activate-ri/VolunteerCtaBand.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import shareCardMetadata from "../../../public/assets/activate-ri-2026-share-card.meta.json";
import { eventPhaseAt } from "../../lib/activate-ri/event-phase";

const activateRiShareImage = {
  src: `/assets/activate-ri-2026-share-card.png?v=${encodeURIComponent(shareCardMetadata.generatedAt)}`,
  alt: "Activate All RI 2026: activated parks, on-air activity, event progress, and a map of Rhode Island parks.",
  width: 1200,
  height: 630,
  type: "image/png",
};
---

<BaseLayout
  title="Activate All RI 2026"
  description="Thank you to the activators, hunters, and helpers who put Rhode Island on the air. Explore Activate All RI 2026 results and photos from the parks."
  canonicalPath="/activate-ri-2026/"
  image={activateRiShareImage}
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <noscript><style is:global>
      #main [data-event-view="planning"], #main [data-event-view="results"], #main [data-event-participation] { display: none !important; }
      #main [data-event-view="recap"][hidden] { display: block !important; }
    </style></noscript>
    <div class="container event-overview-nav">
      <EventNav />
    </div>
    <EventHero />
    <section class="section event-overview" aria-labelledby="event-overview-title" data-event-participation hidden={eventPhaseAt() === "post-event"}>
      <div class="container">
        <div class="section-header">
          <h2 id="event-overview-title">Two ways to join</h2>
        </div>
        <VolunteerCtaBand />
        <section class="event-guidance" aria-labelledby="how-this-works-title">
          <div class="section-header section-header--compact">
            <h2 id="how-this-works-title">How this works</h2>
            <p class="lead">
              Activators share their plans; hunters use the schedule to plan
              when to listen. Check current POTA spots when you are ready to operate.
            </p>
          </div>
          <div class="event-guidance__grid">
            <article class="event-guidance__item">
              <h3>Share a plan</h3>
              <p>
                Add one park or a multi-park route. New plans appear after
                organizer review. Update My Plan if your timing changes.
              </p>
            </article>
            <article class="event-guidance__item">
              <h3>Plan when to listen</h3>
              <p>
                Scheduled windows are estimates. Parks are not reserved, and
                another activation gives hunters more opportunities.
              </p>
            </article>
            <article class="event-guidance__item">
              <h3>Find current activity</h3>
              <p>
                Open <a href="/on-air/">RI on air now</a> for recent POTA spots,
                frequencies, and modes.
              </p>
            </article>
            <article class="event-guidance__item">
              <h3>Official records</h3>
              <p>
                Use official Parks on the Air resources for rules, references,
                accounts, spots, logs, awards, and activation validity.
              </p>
            </article>
          </div>
        </section>
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { subscribeEventPhase } from "../../lib/activate-ri/event-phase";
  subscribeEventPhase((phase) => {
    document.querySelectorAll<HTMLElement>("[data-event-participation]").forEach((section) => {
      section.hidden = phase === "post-event";
    });
  });
</script>
