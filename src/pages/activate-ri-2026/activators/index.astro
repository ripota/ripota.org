---
import ActivatorPortalNav from "../../../components/activate-ri/ActivatorPortalNav.astro";
import ActivatorOpsRoom from "../../../components/activate-ri/ActivatorOpsRoom.astro";
import Footer from "../../../components/Footer.astro";
import Notice from "../../../components/Notice.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Activate All RI 2026 Activator Portal"
  description="Private Activate All RI 2026 activator portal."
  privatePage
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="portal-title">
      <div class="container">
        <ActivatorPortalNav />
        <div class="section-header">
          <p class="eyebrow">Private activator portal</p>
          <h1 id="portal-title">Activator Ops Room</h1>
          <p class="lead">
            Coordinate park access, delays, and backup coverage with approved
            activators and organizers. This room is not for emergencies.
          </p>
        </div>
        <ActivatorOpsRoom />
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>
