---
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Account access" description="Complete RI POTA account access." privatePage>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="access-title">
      <div class="container form-card">
        <p class="eyebrow">RI POTA account</p>
        <h1 id="access-title">Opening your account</h1>
        <p data-account-access-status aria-live="polite">Checking this access link…</p>
        <p><a data-return-sign-in href="/account/sign-in/">Return to sign in</a></p>
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { safeLocalReturnPath } from "../../lib/auth-return-path";

  const status = document.querySelector<HTMLElement>("[data-account-access-status]");
  const token = decodeURIComponent(window.location.hash.slice(1));
  const returnTo = safeLocalReturnPath(new URLSearchParams(window.location.search).get("returnTo"));
  const signIn = document.querySelector<HTMLAnchorElement>("[data-return-sign-in]");
  if (signIn && returnTo) signIn.href = `/account/sign-in/?${new URLSearchParams({ returnTo })}`;
  window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
  void consume();
  async function consume(): Promise<void> {
    if (!token) {
      status?.replaceChildren("This access link is missing or expired.");
      return;
    }
    try {
      const response = await fetch("/api/auth/email-login/consume", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ token, returnTo }),
      });
      const body: unknown = await response.json();
      if (!response.ok || !isRecord(body)) throw new Error("invalid");
      window.location.replace(safeLocalReturnPath(body.nextPath) ?? "/account/security/");
    } catch {
      status?.replaceChildren("This access link is invalid, expired, or already used.");
    }
  }

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === "object" && value !== null && !Array.isArray(value);
  }
</script>
