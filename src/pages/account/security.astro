---
import AccountSecurityContent from "../../components/auth/AccountSecurityContent.astro";
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Account security" description="Manage RI POTA account security." privatePage>
  <SiteHeader variant="solid" showEventLink />
  <main id="main">
    <section class="section event-page" aria-labelledby="security-title">
      <div class="container stack">
        <AccountSecurityContent />
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>
