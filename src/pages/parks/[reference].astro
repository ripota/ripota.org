---
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import ParkCoordinates from "../../components/parks/ParkCoordinates.astro";
import ParkDetailMap from "../../components/parks/ParkDetailMap.astro";
import ParkHeroPhoto from "../../components/parks/ParkHeroPhoto.astro";
import { getParkHeroPhoto } from "../../lib/parks/images";
import ParkVisitInfo from "../../components/parks/ParkVisitInfo.astro";
import { getPark } from "@ripota/parks";
import SiteHeader from "../../components/SiteHeader.astro";
import { parksCatalog } from "../../lib/pota/catalog";
import type { CatalogRecord } from "@ripota/parks/types";
import {
  parkGeometryDescription,
  parkGeometryLabel,
  parkGuideNavigationItems,
  parkGuidePath,
  sameGeometryReferences,
} from "../../lib/parks/directory";
import BaseLayout from "../../layouts/BaseLayout.astro";

type Props = {
  park: CatalogRecord;
};

export function getStaticPaths() {
  return parksCatalog.references.map((park) => ({
    params: { reference: park.reference.toLowerCase() },
    props: { park },
  }));
}

const { park } = Astro.props;
const visitorInfo = getPark(park.reference)!;
const hero = await getParkHeroPhoto(visitorInfo);
const relatedParks = sameGeometryReferences(parksCatalog.references, park.reference);
const relationshipParks = [park, ...relatedParks];
const geometryLabel = parkGeometryLabel(park);
const navigationItems = parkGuideNavigationItems(relatedParks.length > 0);
const officialMultipleReferencesUrl =
  "https://docs.pota.app/docs/activator_reference/activator_guide-english.html#multiple-park-references";
---

<BaseLayout
  title={`${park.name} field guide`}
  description={`A Rhode Island field guide for ${park.name}, including its map, park identity, and source links.`}
  canonicalPath={parkGuidePath(park.reference)}
  image={hero ? {
    src: hero.src,
    alt: hero.image.alt,
    width: hero.width,
    height: hero.height,
    type: "image/webp",
  } : undefined}
  bodyClass="park-page"
>
  <SiteHeader variant="solid" />
  <main id="main">
    <section class="park-hero" aria-labelledby="park-title">
      <div class="park-hero__content container">
        <a class="park-identity__breadcrumb" href="/parks/">
          All Rhode Island parks <span aria-hidden="true">/</span> {park.counties.join(", ")}
        </a>
        <div class="park-identity">
          <div>
            <p class="park-identity__reference">{park.reference}</p>
            <h1 id="park-title">{park.name}</h1>
            {visitorInfo.summary && <p class="park-identity__summary">{visitorInfo.summary}</p>}
            <p class="park-identity__meta">
              {park.counties.join(" · ")} <span aria-hidden="true">·</span> Grid {park.grid}
            </p>
          </div>
          <div class="park-identity__actions">
            <ParkCoordinates park={park} />
            <a
              class="button park-identity__official-link"
              data-variant="primary"
              href={park.potaUrl}
              target="_blank"
              rel="noreferrer"
            >Official POTA page ↗</a>
          </div>
        </div>
      </div>
      <div class:list={["park-hero__media container", { "park-hero__media--with-photo": hero }]}>
        {hero && <ParkHeroPhoto hero={hero} sizes="(min-width: 1200px) 615px, (min-width: 861px) 52vw, 100vw" />}
        <div class="park-hero__map">
          <ParkDetailMap
            id={`park-boundary-map-${park.reference.toLowerCase()}`}
            park={park}
            relatedParks={relatedParks}
          />
        </div>
      </div>
    </section>

    <nav class="park-subnav" aria-label="On this park page">
      <div class="container park-subnav__inner">
        <span>On this page</span>
        {navigationItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </nav>

    <ParkVisitInfo park={visitorInfo} />

    <section class="park-map-facts section" id="map-facts" aria-labelledby="map-facts-title">
      <div class="container park-map-facts__layout">
        <div>
          <h2 id="map-facts-title">Map facts</h2>
          <p>{parkGeometryDescription(park)}</p>
        </div>
        <dl>
          <div>
            <dt>Map detail</dt>
            <dd>{geometryLabel}</dd>
          </div>
          <div>
            <dt>Map source</dt>
            <dd>{park.source.name}</dd>
          </div>
        </dl>
        <a href={park.source.url} target="_blank" rel="noreferrer">Open map source ↗</a>
      </div>
    </section>

    {relatedParks.length > 0 && (
      <section class="park-overlap section" id="overlap" aria-labelledby="overlap-title">
        <div class="container park-overlap__layout">
          <div>
            <p class="eyebrow">Mapped relationship</p>
            <h2 id="overlap-title">Possible 2-fer</h2>
            <p class="park-overlap__lead">
              {relationshipParks.map(({ reference }) => reference).join(" and ")} share the same
              mapped source features. Confirm both references before operating, and keep the entire
              station valid for both.
            </p>
            <a
              class="park-overlap__guidance"
              href={officialMultipleReferencesUrl}
              target="_blank"
              rel="noreferrer"
            >Read official POTA multiple-reference guidance ↗</a>
          </div>
          <ul aria-label="Possible 2-fer references">
            {relationshipParks.map((relationshipPark) => (
              <li>
                <strong>{relationshipPark.reference} · {relationshipPark.name}</strong>
                <span>
                  <a href={parkGuidePath(relationshipPark.reference)}>Local guide</a>
                  <a href={relationshipPark.potaUrl} target="_blank" rel="noreferrer">Official POTA ↗</a>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section
      class="park-community section"
      id="community-reports"
      aria-labelledby="community-reports-title"
    >
      <div class="container">
        <h2 id="community-reports-title">No community reports yet.</h2>
      </div>
    </section>

    <section class="park-sources section" id="sources" aria-labelledby="sources-title">
      <div class="container park-sources__layout">
        <div>
          <p class="eyebrow">Sources</p>
          <h2 id="sources-title">Check current details</h2>
          <p>Official POTA remains the source of truth for reference details and requirements.</p>
        </div>
        <ul>
          <li>
            <a href={visitorInfo.websiteUrl} target="_blank" rel="noreferrer">{visitorInfo.manager} park information ↗</a>
          </li>
          <li>
            <a href={park.potaUrl} target="_blank" rel="noreferrer">
              Official POTA reference — {park.reference} ↗
            </a>
          </li>
          <li>
            <a href={park.source.url} target="_blank" rel="noreferrer">{park.source.name} ↗</a>
          </li>
        </ul>
      </div>
    </section>

    <Notice />
  </main>
  <Footer />
</BaseLayout>

<style>
  .park-hero {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) 2rem;
    background: var(--surface-page);
  }

  .park-identity__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 750;
    text-decoration: none;
  }

  .park-identity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: 1.5rem;
  }

  .park-identity__reference {
    width: fit-content;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    margin-bottom: 0.9rem;
    padding: 0.28rem 0.55rem;
    color: var(--link-strong);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .park-identity h1 {
    color: var(--surface-ink);
    max-width: 20ch;
    font-size: clamp(2.6rem, 4.8vw, 4.5rem);
    line-height: 1;
    overflow-wrap: normal;
  }

  .park-identity__summary {
    max-width: 65ch;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .park-identity__meta {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .park-identity__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .park-identity__actions :global(.park-coordinates) {
    margin-top: 0;
  }

  .park-identity__official-link {
    width: fit-content;
  }

  .park-hero__media {
    display: grid;
    gap: 1rem;
    align-items: start;
    --park-hero-image-height: 390px;
  }

  .park-hero__media--with-photo {
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
  }

  .park-hero__map {
    position: relative;
    height: var(--park-hero-image-height);
    border: 1px solid var(--border-subtle);
    border-radius: 7px;
    overflow: hidden;
  }

  .park-hero[data-location-mode="active"] .park-hero__content,
  .park-hero[data-location-mode="active"] :global([data-park-hero-photo]) {
    display: none;
  }

  @media (max-width: 860px) {
    .park-identity {
      grid-template-columns: 1fr;
    }

    .park-identity h1 {
      font-size: clamp(2.5rem, 8vw, 4rem);
    }

    .park-identity__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }

    .park-hero__media--with-photo {
      grid-template-columns: 1fr;
    }

    .park-hero__media {
      --park-hero-image-height: clamp(250px, 60vw, 390px);
    }

    .park-hero__map {
      height: 360px;
    }
  }

  .park-subnav {
    position: sticky;
    z-index: 900;
    top: 0;
    border-bottom: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--surface-page) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  .park-subnav__inner {
    display: flex;
    min-height: 54px;
    align-items: center;
    gap: 1.15rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .park-subnav__inner::-webkit-scrollbar {
    display: none;
  }

  .park-subnav span,
  .park-subnav a {
    flex: 0 0 auto;
    font-size: 0.76rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .park-subnav span {
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .park-subnav a {
    color: var(--surface-ink);
    text-decoration: none;
  }

  .park-map-facts__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
    gap: 1.5rem clamp(2rem, 7vw, 6rem);
    align-items: start;
  }

  .park-map-facts h2,
  .park-overlap h2,
  .park-sources h2 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 5vw, 4.3rem);
  }

  .park-map-facts__layout > div > p:last-child,
  .park-sources__layout > div > p:last-child {
    max-width: 58ch;
    margin-top: 0.8rem;
    color: var(--text-muted);
  }

  .park-map-facts dl {
    margin: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .park-map-facts dl > div {
    display: grid;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.9rem 0;
  }

  .park-map-facts dt {
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .park-map-facts dd {
    margin: 0;
    color: var(--text-primary);
    font-weight: 700;
  }

  .park-map-facts__layout > a {
    grid-column: 2;
    width: fit-content;
    color: var(--link-strong);
    font-weight: 850;
  }

  .park-overlap {
    border-block: 1px solid color-mix(in srgb, var(--text-on-hero) 12%, transparent);
    background:
      radial-gradient(circle at 16% 12%, rgba(168, 115, 56, 0.24), transparent 27rem),
      var(--surface-brand);
    color: var(--text-on-hero);
  }

  .park-overlap__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: center;
  }

  .park-overlap .eyebrow {
    color: color-mix(in srgb, var(--accent) 70%, white);
  }

  .park-overlap h2 {
    color: var(--text-on-hero);
  }

  .park-overlap__lead {
    max-width: 58ch;
    margin-top: 1rem;
    color: color-mix(in srgb, var(--text-on-hero) 82%, transparent);
  }

  .park-overlap__guidance {
    display: inline-block;
    margin-top: 1.2rem;
    color: var(--text-on-hero);
    font-weight: 850;
  }

  .park-overlap ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(255, 250, 240, 0.2);
    border-radius: 8px;
    background: rgba(255, 250, 240, 0.07);
    list-style: none;
  }

  .park-overlap li {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
  }

  .park-overlap li + li {
    border-top: 1px solid rgba(255, 250, 240, 0.18);
  }

  .park-overlap li span {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .park-overlap li a {
    color: var(--text-on-hero);
    font-size: 0.82rem;
    font-weight: 850;
  }

  .park-community {
    background: var(--surface-raised);
  }

  .park-community h2 {
    margin: 0;
    color: var(--surface-ink);
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .park-sources {
    border-top: 1px solid var(--border-subtle);
  }

  .park-sources__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 7vw, 6rem);
  }

  .park-sources ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .park-sources li {
    border-top: 1px solid var(--border-subtle);
    padding: 0.9rem 0;
  }

  .park-sources li:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  .park-sources a {
    color: var(--link-strong);
    font-weight: 850;
  }

  @media (max-width: 860px) {
    .park-map-facts__layout,
    .park-overlap__layout,
    .park-sources__layout {
      grid-template-columns: 1fr;
    }

    .park-map-facts__layout > a {
      grid-column: 1;
    }
  }

  @media (max-width: 560px) {
    .park-subnav span { display: none; }
    .park-subnav__inner { gap: 1rem; }
  }
</style>
