---
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parksCatalog } from "../../lib/pota/catalog";
import {
  parkGeometryLabel,
  parkGuidePath,
  sameGeometryReferenceSet,
} from "../../lib/parks/directory";

const parks = [...parksCatalog.references].sort((left, right) =>
  left.name.localeCompare(right.name),
);
const counties = [...new Set(parks.flatMap(({ counties }) => counties))].sort();
const sameGeometryReferences = sameGeometryReferenceSet(parks);
const geometryCounts = Object.fromEntries(
  ["Boundary", "Activation zone", "Point only"].map((label) => [
    label,
    parks.filter((park) => parkGeometryLabel(park) === label).length,
  ]),
);
---

<BaseLayout
  title="Rhode Island park field guides"
  description="Browse Rhode Island Parks on the Air references by name, county, and mapped coverage."
  canonicalPath="/parks/"
  bodyClass="parks-directory-page"
>
  <SiteHeader variant="solid" />
  <main id="main">
    <section class="parks-directory-hero" aria-labelledby="parks-directory-title">
      <div class="container parks-directory-hero__layout">
        <div>
          <p class="eyebrow">Rhode Island field guide</p>
          <h1 id="parks-directory-title">Rhode Island park field guides</h1>
          <p>
            Browse all {parks.length} Rhode Island POTA references, with local
            maps and links to current official details.
          </p>
        </div>
        <dl aria-label="Park directory summary">
          <div>
            <dt>References</dt>
            <dd>{parks.length}</dd>
          </div>
          <div>
            <dt>Mapped boundaries</dt>
            <dd>{geometryCounts.Boundary}</dd>
          </div>
          <div>
            <dt>Point-only records</dt>
            <dd>{geometryCounts["Point only"]}</dd>
          </div>
          <div>
            <dt>Activation zones</dt>
            <dd>{geometryCounts["Activation zone"]}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="parks-directory section" aria-labelledby="browse-parks-title">
      <div class="container">
        <header class="parks-directory__heading">
          <div>
            <p class="eyebrow">Park directory</p>
            <h2 id="browse-parks-title">Browse all references</h2>
          </div>
          <p>
            Open a field guide for its map, park identity, useful mapped
            relationships, and source links.
          </p>
        </header>

        <form class="parks-directory__filters" data-park-directory-filters aria-label="Filter parks">
          <label class="parks-directory__search">
            <span>Search parks</span>
            <input
              type="search"
              name="query"
              placeholder="Name or reference, like US-2878"
              autocomplete="off"
              data-park-filter-query
            />
          </label>
          <label>
            <span>County</span>
            <select name="county" data-park-filter-county>
              <option value="all">All counties</option>
              {counties.map((county) => <option value={county}>{county}</option>)}
            </select>
          </label>
          <label>
            <span>Map data</span>
            <select name="geometry" data-park-filter-geometry>
              <option value="all">All geometry</option>
              <option value="Boundary">Boundary ({geometryCounts.Boundary})</option>
              <option value="Activation zone">Activation zone ({geometryCounts["Activation zone"]})</option>
              <option value="Point only">Point only ({geometryCounts["Point only"]})</option>
            </select>
          </label>
          <label class="parks-directory__check">
            <input type="checkbox" data-park-filter-related />
            <span>Possible 2-fers</span>
          </label>
        </form>

        <div class="parks-directory__result-bar">
          <p role="status" aria-live="polite" data-park-directory-count>
            Showing all {parks.length} parks
          </p>
        </div>

        <ol class="parks-directory__list" data-park-directory-list>
          {parks.map((park) => {
            const geometryLabel = parkGeometryLabel(park);
            const hasSameGeometry = sameGeometryReferences.has(park.reference);
            return (
              <li
                data-park-row
                data-name={`${park.reference} ${park.name}`.toLowerCase()}
                data-counties={park.counties.join("|")}
                data-geometry={geometryLabel}
                data-related={hasSameGeometry ? "true" : "false"}
              >
                <a href={parkGuidePath(park.reference)}>
                  <span class="parks-directory__reference">{park.reference}</span>
                  <span class="parks-directory__park-name">{park.name}</span>
                  <span class="parks-directory__location">
                    {park.counties.join(", ")} · {park.grid}
                  </span>
                  <span class="parks-directory__badges">
                    <span>{geometryLabel}</span>
                    {hasSameGeometry && <span data-variant="relationship">Possible 2-fer</span>}
                  </span>
                  <span class="parks-directory__open" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ol>
        <p class="parks-directory__empty" data-park-directory-empty hidden>
          No parks match those filters. Clear a filter and try again.
        </p>
      </div>
    </section>

    <Notice />
  </main>
  <Footer />
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-park-directory-filters]")
    .forEach(setupParkDirectory);

  function setupParkDirectory(filters: HTMLFormElement): void {
    const list = document.querySelector<HTMLOListElement>("[data-park-directory-list]");
    const count = document.querySelector<HTMLElement>("[data-park-directory-count]");
    const empty = document.querySelector<HTMLElement>("[data-park-directory-empty]");
    const query = filters.querySelector<HTMLInputElement>("[data-park-filter-query]");
    const county = filters.querySelector("[data-park-filter-county]") as unknown as HTMLSelectElement | null;
    const geometry = filters.querySelector("[data-park-filter-geometry]") as unknown as HTMLSelectElement | null;
    const related = filters.querySelector<HTMLInputElement>("[data-park-filter-related]");
    if (!list || !query || !county || !geometry || !related) {
      return;
    }

    const rows = [...list.querySelectorAll<HTMLElement>("[data-park-row]")];
    const apply = (): void => {
      const search = query.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const matchesQuery = !search || (row.dataset.name ?? "").includes(search);
        const matchesCounty = county.value === "all" ||
          (row.dataset.counties ?? "").split("|").includes(county.value);
        const matchesGeometry = geometry.value === "all" || row.dataset.geometry === geometry.value;
        const matchesRelated = !related.checked || row.dataset.related === "true";
        row.hidden = !(matchesQuery && matchesCounty && matchesGeometry && matchesRelated);
        visible += row.hidden ? 0 : 1;
      }

      count?.replaceChildren(
        visible === rows.length
          ? `Showing all ${rows.length} parks`
          : `Showing ${visible} of ${rows.length} parks`,
      );
      if (empty) {
        empty.hidden = visible !== 0;
      }
    };

    filters.addEventListener("input", apply);
    filters.addEventListener("change", apply);
    apply();
  }
</script>

<style>
  .parks-directory-hero {
    border-bottom: 1px solid color-mix(in srgb, var(--text-on-hero) 14%, transparent);
    background:
      radial-gradient(circle at 88% 20%, rgba(168, 115, 56, 0.28), transparent 28rem),
      var(--surface-brand);
    color: var(--text-on-hero);
    padding: clamp(3rem, 7vw, 6rem) 0;
  }

  .parks-directory-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .parks-directory-hero .eyebrow {
    color: color-mix(in srgb, var(--accent) 72%, white);
  }

  .parks-directory-hero h1 {
    max-width: 12ch;
    font-size: clamp(3.3rem, 7vw, 6.3rem);
    line-height: 0.95;
  }

  .parks-directory-hero__layout > div > p:last-child {
    max-width: 62ch;
    margin-top: 1.2rem;
    color: color-mix(in srgb, var(--text-on-hero) 82%, transparent);
    font-size: 1.08rem;
  }

  .parks-directory-hero dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 250, 240, 0.2);
    border-radius: 8px;
    background: rgba(255, 250, 240, 0.18);
  }

  .parks-directory-hero dl > div {
    display: grid;
    gap: 0.15rem;
    background: color-mix(in srgb, var(--surface-brand) 90%, transparent);
    padding: 1rem;
  }

  .parks-directory-hero dt {
    color: color-mix(in srgb, var(--text-on-hero) 64%, transparent);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .parks-directory-hero dd {
    margin: 0;
    color: var(--text-on-hero);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
    font-weight: 800;
  }

  .parks-directory__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.7fr);
    gap: 2rem;
    align-items: end;
  }

  .parks-directory__heading h2 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }

  .parks-directory__heading > p {
    color: var(--text-muted);
  }

  .parks-directory__filters {
    display: grid;
    grid-template-columns: minmax(260px, 1.4fr) repeat(2, minmax(180px, 0.75fr)) auto;
    gap: 0.75rem;
    margin-top: 2.2rem;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: var(--surface-raised);
    box-shadow: var(--shadow-soft);
    padding: 0.9rem;
  }

  .parks-directory__filters label {
    display: grid;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .parks-directory__filters input[type="search"],
  .parks-directory__filters select {
    width: 100%;
    min-height: 46px;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    background: var(--surface-page);
    color: var(--text-primary);
    padding: 0.65rem 0.75rem;
  }

  .parks-directory__check {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    align-self: end;
    min-height: 46px;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.55rem 0.7rem;
  }

  .parks-directory__check input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .parks-directory__result-bar {
    margin-top: 1.35rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .parks-directory__list {
    display: grid;
    gap: 0;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .parks-directory__list li {
    border-top: 1px solid var(--border-subtle);
  }

  .parks-directory__list li:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  .parks-directory__list li[hidden] {
    display: none;
  }

  .parks-directory__list a {
    display: grid;
    grid-template-columns: 6.5rem minmax(220px, 1.4fr) minmax(190px, 0.8fr) minmax(280px, 1fr) auto;
    gap: 1rem;
    align-items: center;
    min-height: 78px;
    padding: 0.9rem 0.6rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  .parks-directory__list a:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--text-primary);
  }

  .parks-directory__reference {
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.05em;
  }

  .parks-directory__park-name {
    color: var(--surface-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.18rem;
    font-weight: 800;
    line-height: 1.12;
  }

  .parks-directory__location {
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .parks-directory__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .parks-directory__badges > span {
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.22rem 0.45rem;
    color: var(--text-muted);
    font-size: 0.64rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .parks-directory__badges > span[data-variant="relationship"] {
    border-color: color-mix(in srgb, var(--link) 42%, var(--border-subtle));
    background: color-mix(in srgb, var(--link) 8%, transparent);
    color: var(--link-strong);
  }

  .parks-directory__open {
    color: var(--accent-strong);
    font-size: 1.4rem;
    font-weight: 900;
  }

  .parks-directory__empty {
    border: 1px dashed var(--border-subtle);
    border-radius: 8px;
    margin-top: 1rem;
    padding: 2rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 980px) {
    .parks-directory-hero__layout,
    .parks-directory__heading {
      grid-template-columns: 1fr;
    }

    .parks-directory-hero dl {
      max-width: 600px;
    }

    .parks-directory__filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .parks-directory__list a {
      grid-template-columns: 5.5rem minmax(0, 1.3fr) minmax(170px, 0.7fr) auto;
    }

    .parks-directory__badges {
      grid-column: 2 / 4;
    }

    .parks-directory__open {
      grid-column: 4;
      grid-row: 1 / 3;
    }
  }

  @media (max-width: 620px) {
    .parks-directory-hero h1 {
      font-size: clamp(3rem, 15vw, 4.5rem);
    }

    .parks-directory__filters {
      grid-template-columns: 1fr;
    }

    .parks-directory__list a {
      grid-template-columns: 5.1rem minmax(0, 1fr) auto;
      gap: 0.4rem 0.65rem;
      padding-block: 1rem;
    }

    .parks-directory__reference {
      grid-column: 1;
      grid-row: 1;
    }

    .parks-directory__park-name {
      grid-column: 2;
      grid-row: 1;
      font-size: 1.05rem;
    }

    .parks-directory__location {
      grid-column: 2;
      grid-row: 2;
    }

    .parks-directory__badges {
      grid-column: 2;
      grid-row: 3;
    }

    .parks-directory__open {
      grid-column: 3;
      grid-row: 1 / 4;
    }
  }
</style>
