---
import Footer from "../../components/Footer.astro";
import Notice from "../../components/Notice.astro";
import ReferenceMap from "../../components/ReferenceMap.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import OrangeSeason from "../../components/parks/OrangeSeason.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parks as allParks } from "@ripota/parks";
import { parksCatalog } from "../../lib/pota/catalog";
import { amenityLabels, orangeLabel, parkTypeLabels } from "../../lib/parks/metadata";
import {
  parkGuidePath,
  sameGeometryReferenceSet,
} from "../../lib/parks/directory";

const parks = [...allParks].sort((left, right) =>
  left.name.localeCompare(right.name),
);
const counties = [...new Set(parks.flatMap(({ counties }) => counties))].sort();
const sameGeometryReferences = sameGeometryReferenceSet(parksCatalog.references);
const parkTypes = [...new Set(parks.map((park) => park.type))].sort((a, b) => parkTypeLabels[a].localeCompare(parkTypeLabels[b]));
const amenities = [...new Set(parks.flatMap((park) => park.amenities))].sort((a, b) => amenityLabels[a].localeCompare(amenityLabels[b]));
---

<BaseLayout
  title="Rhode Island park field guides"
  description="Explore all Rhode Island Parks on the Air references on a statewide map, then browse by name, reference, or county."
  canonicalPath="/parks/"
  bodyClass="parks-directory-page"
>
  <SiteHeader variant="solid" />
  <main id="main">
    <section class="parks-directory-hero" aria-labelledby="parks-directory-title">
      <div class="parks-directory-hero__map">
        <ReferenceMap
          id="parks-directory-reference-map"
          variant="directory"
          title="Map of all Rhode Island POTA parks"
          caption=""
          legendPlacement="none"
        />
      </div>
      <div class="container parks-directory-hero__content">
        <div class="parks-directory-hero__intro">
          <p class="eyebrow">Rhode Island field guide</p>
          <h1 id="parks-directory-title">Rhode Island park field guides</h1>
          <p>
            Explore all {parks.length} Rhode Island POTA parks. Select a park on
            the map for its local field guide and current official details.
          </p>
          <a href="#browse-parks-title">Browse the park list <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <section class="parks-directory section" aria-labelledby="browse-parks-title">
      <div class="container">
        <header class="parks-directory__heading">
          <div>
            <p class="eyebrow">Park directory</p>
            <h2 id="browse-parks-title">Browse all references</h2>
          </div>
          <p>
            Find a spot with the access and amenities you need. Each guide includes
            parking notes, seasonal orange guidance, a map, and park links.
          </p>
        </header>

        <aside class="parks-directory__orange" aria-labelledby="orange-season-title" data-orange-seasonal hidden>
          <h3 id="orange-season-title">Pack fluorescent orange for hunting season</h3>
          <p>
            At state management areas and designated undeveloped parks, wear 200 square inches
            from the second Saturday in September through February, and the third Saturday in
            April through May. Shotgun deer season requires 500 square inches. Some areas are
            exempt or have different guidance—see each park's guide.{" "}
            <a href="https://rules.sos.ri.gov/regulations/part/250-100-00-7" target="_blank" rel="noreferrer">DEM orange guidance ↗</a>
          </p>
        </aside>

        <form class="parks-directory__filters" data-park-directory-filters aria-label="Filter parks">
          <label class="parks-directory__search">
            <span>Search parks</span>
            <input
              type="search"
              name="query"
              placeholder="Name or reference, like US-2878"
              autocomplete="off"
              data-park-filter-query
            />
          </label>
          <label>
            <span>County</span>
            <select name="county" data-park-filter-county>
              <option value="all">All counties</option>
              {counties.map((county) => <option value={county}>{county}</option>)}
            </select>
          </label>
          <label>
            <span>Park type</span>
            <select name="type" data-park-filter-type>
              <option value="all">All types</option>
              {parkTypes.map((type) => <option value={type}>{parkTypeLabels[type]}</option>)}
            </select>
          </label>
          <label>
            <span>Amenity</span>
            <select name="amenity" data-park-filter-amenity>
              <option value="all">Any amenities</option>
              {amenities.map((amenity) => <option value={amenity}>{amenityLabels[amenity]}</option>)}
            </select>
          </label>
          <label class="parks-directory__check">
            <input type="checkbox" data-park-filter-related />
            <span>Possible 2-fers</span>
          </label>
          <button type="reset" class="parks-directory__clear">Clear filters</button>
        </form>

        <div class="parks-directory__result-bar">
          <p role="status" aria-live="polite" data-park-directory-count>
            Showing all {parks.length} parks
          </p>
        </div>

        <ol class="parks-directory__list" data-park-directory-list>
          {parks.map((park) => {
            const hasSameGeometry = sameGeometryReferences.has(park.reference);
            return (
              <li
                data-park-row
                data-name={`${park.reference} ${park.name}`.toLowerCase()}
                data-reference={park.reference}
                data-manager={park.manager}
                data-type={park.type}
                data-amenities={park.amenities.join("|")}
                data-counties={park.counties.join("|")}
                data-related={hasSameGeometry ? "true" : "false"}
              >
                <a href={parkGuidePath(park.reference)}>
                  <span class="parks-directory__reference">{park.reference}</span>
                  <span class="parks-directory__identity">
                    <span class="parks-directory__park-name">{park.name}</span>
                    <span class="parks-directory__manager">{park.manager}</span>
                  </span>
                  <span class="parks-directory__location">
                    {park.counties.join(", ")} · {park.grid}
                    {park.amenities.length > 0 && <span class="parks-directory__amenities">{park.amenities.map((amenity) => amenityLabels[amenity]).join(" · ")}</span>}
                  </span>
                  <span class="parks-directory__badges">
                    <span>{parkTypeLabels[park.type]}</span>
                    {park.orange.status !== "not-required" && (
                      <span data-variant="orange" data-orange-seasonal hidden title={`${park.orange.season ?? ""} ${park.orange.details}`}>{orangeLabel(park.orange)}</span>
                    )}
                    {hasSameGeometry && <span data-variant="relationship">Possible 2-fer</span>}
                  </span>
                  <span class="parks-directory__open" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ol>
        <p class="parks-directory__empty" data-park-directory-empty hidden>
          No parks match those filters. Clear a filter and try again.
        </p>
      </div>
    </section>

    <Notice />
  </main>
  <Footer />
</BaseLayout>

<OrangeSeason />

<script>
  import type { ParkType, ParkAmenity } from "@ripota/parks";
  import { parkMatchesFilters } from "../../lib/parks/metadata";
  document
    .querySelectorAll<HTMLFormElement>("[data-park-directory-filters]")
    .forEach(setupParkDirectory);

  function setupParkDirectory(filters: HTMLFormElement): void {
    const list = document.querySelector<HTMLOListElement>("[data-park-directory-list]");
    const count = document.querySelector<HTMLElement>("[data-park-directory-count]");
    const empty = document.querySelector<HTMLElement>("[data-park-directory-empty]");
    const query = filters.querySelector<HTMLInputElement>("[data-park-filter-query]");
    const county = filters.querySelector("[data-park-filter-county]") as unknown as HTMLSelectElement | null;
    const related = filters.querySelector<HTMLInputElement>("[data-park-filter-related]");
    const type = filters.querySelector("[data-park-filter-type]") as unknown as HTMLSelectElement | null;
    const amenity = filters.querySelector("[data-park-filter-amenity]") as unknown as HTMLSelectElement | null;
    if (!list || !query || !county || !related || !type || !amenity) {
      return;
    }

    const rows = [...list.querySelectorAll<HTMLElement>("[data-park-row]")];
    let searchEditing = false;
    const restoreFilters = (): void => {
      const params = new URLSearchParams(location.search);
      query.value = params.get("query")?.trim() ?? "";
      for (const select of [county, type, amenity]) {
        const value = params.get(select.name);
        select.value = value && [...select.options].some((option) => option.value === value) ? value : "all";
      }
      related.checked = params.get("related") === "1";
    };
    const apply = (): void => {
      let visible = 0;
      for (const row of rows) {
        const matches = parkMatchesFilters({
          reference: row.dataset.reference ?? "",
          name: row.dataset.name ?? "",
          manager: row.dataset.manager ?? "",
          type: row.dataset.type as ParkType,
          counties: (row.dataset.counties ?? "").split("|"),
          amenities: (row.dataset.amenities ?? "").split("|").filter(Boolean) as ParkAmenity[],
        }, { query: query.value, county: county.value, type: type.value, amenity: amenity.value });
        const matchesRelated = !related.checked || row.dataset.related === "true";
        row.hidden = !(matches && matchesRelated);
        visible += row.hidden ? 0 : 1;
      }

      count?.replaceChildren(
        visible === rows.length
          ? `Showing all ${rows.length} parks`
          : `Showing ${visible} of ${rows.length} parks`,
      );
      if (empty) {
        empty.hidden = visible !== 0;
      }
    };

    const updateUrl = (mode: "push" | "replace" = "push"): boolean => {
      const url = new URL(location.href);
      for (const [key, value] of Object.entries({ query: query.value.trim(), county: county.value, type: type.value, amenity: amenity.value, related: related.checked ? "1" : "" })) {
        if (value && (key === "query" || value !== "all")) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      if (url.href === location.href) return false;
      if (mode === "push") history.pushState(history.state, "", url);
      else history.replaceState(history.state, "", url);
      return true;
    };

    filters.addEventListener("submit", (event) => event.preventDefault());
    query.addEventListener("input", () => {
      searchEditing = updateUrl(searchEditing ? "replace" : "push") || searchEditing;
      apply();
    });
    query.addEventListener("blur", () => { searchEditing = false; });
    filters.addEventListener("change", () => {
      searchEditing = false;
      updateUrl();
      apply();
    });
    window.addEventListener("popstate", () => {
      searchEditing = false;
      restoreFilters();
      apply();
    });
    filters.addEventListener("reset", (event) => {
      event.preventDefault();
      query.value = "";
      for (const select of [county, type, amenity]) select.value = "all";
      related.checked = false;
      searchEditing = false;
      updateUrl();
      apply();
      query.focus();
    });
    restoreFilters();
    updateUrl("replace");
    apply();
  }
</script>

<style>
  .parks-directory-hero {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    background: var(--surface-brand);
    color: var(--text-on-hero);
  }

  .parks-directory-hero__map,
  .parks-directory-hero__map :global(.map-preview),
  .parks-directory-hero__map :global(.ri-reference-map) {
    width: 100%;
    min-height: 620px;
    height: 620px;
  }

  .parks-directory-hero__map :global(.map-preview) {
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .parks-directory-hero__content {
    position: absolute;
    z-index: 800;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-block: 2rem;
    pointer-events: none;
  }

  .parks-directory-hero__intro {
    width: min(610px, 100%);
    border: 1px solid rgba(255, 250, 240, 0.22);
    border-radius: 10px;
    background: rgba(18, 39, 37, 0.94);
    box-shadow: 0 28px 85px rgba(5, 17, 16, 0.38);
    padding: clamp(1.35rem, 3.5vw, 2.2rem);
    pointer-events: auto;
    backdrop-filter: blur(14px);
  }

  .parks-directory-hero .eyebrow {
    color: color-mix(in srgb, var(--accent) 72%, white);
  }

  .parks-directory-hero h1 {
    max-width: 11ch;
    color: var(--text-on-hero);
    font-size: clamp(2.8rem, 5vw, 4.7rem);
    line-height: 0.96;
  }

  .parks-directory-hero__intro > p:nth-of-type(2) {
    max-width: 54ch;
    margin-top: 1rem;
    color: color-mix(in srgb, var(--text-on-hero) 82%, transparent);
    font-size: 1rem;
  }

  .parks-directory-hero__intro > a {
    display: inline-block;
    margin-top: 1.15rem;
    color: var(--text-on-hero);
    font-size: 0.86rem;
    font-weight: 900;
  }

  .parks-directory-hero[data-location-mode="active"] .parks-directory-hero__content {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.75rem);
  }

  @media (min-width: 760px) {
    .parks-directory-hero[data-location-mode="active"],
    .parks-directory-hero[data-location-mode="active"] .parks-directory-hero__map,
    .parks-directory-hero[data-location-mode="active"]
      .parks-directory-hero__map
      :global(.map-preview),
    .parks-directory-hero[data-location-mode="active"]
      .parks-directory-hero__map
      :global(.ri-reference-map) {
      min-height: calc(100svh - var(--header-height));
      height: calc(100svh - var(--header-height));
    }
  }

  @media (max-width: 759px) {
    .parks-directory-hero[data-location-mode="active"],
    .parks-directory-hero[data-location-mode="active"] .parks-directory-hero__map,
    .parks-directory-hero[data-location-mode="active"]
      .parks-directory-hero__map
      :global(.map-preview) {
      min-height: calc(100svh - var(--header-height));
      height: calc(100svh - var(--header-height));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .parks-directory-hero__content {
      transition:
        opacity 180ms ease,
        transform 180ms ease,
        visibility 180ms;
    }
  }

  .parks-directory__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.7fr);
    gap: 2rem;
    align-items: end;
  }

  .parks-directory__heading h2 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }

  .parks-directory__heading > p {
    color: var(--text-muted);
  }

  .parks-directory__filters {
    display: grid;
    grid-template-columns: minmax(240px, 1.4fr) repeat(3, minmax(150px, 1fr));
    gap: 0.75rem;
    margin-top: 2.2rem;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: var(--surface-raised);
    box-shadow: var(--shadow-soft);
    padding: 0.9rem;
  }

  .parks-directory__orange { margin-top: 1.75rem; border-left: 4px solid #c75a13; padding: 1rem 1.25rem; background: color-mix(in srgb, #ed853b 10%, var(--surface-page)); }
  .parks-directory__orange h3 { font-size: 1.05rem; }
  .parks-directory__orange p { margin-top: 0.45rem; max-width: 100ch; font-size: 0.85rem; color: var(--text-muted); }
  .parks-directory__orange a { color: var(--link-strong); font-weight: 800; }
  .parks-directory__clear { justify-self: start; align-self: end; min-height: 46px; border: 0; background: transparent; padding: 0.55rem 0.2rem; color: var(--link-strong); font-size: 0.8rem; font-weight: 850; cursor: pointer; text-decoration: underline; }
  .parks-directory__identity { display: grid; gap: 0.4rem; }
  .parks-directory__manager { color: var(--text-muted); font-size: 0.7rem; line-height: 1.4; }
  .parks-directory__amenities { display: block; margin-top: 0.4rem; font-size: 0.7rem; font-weight: 500; }

  .parks-directory__filters label {
    display: grid;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .parks-directory__filters input[type="search"],
  .parks-directory__filters select {
    width: 100%;
    min-height: 46px;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    background: var(--surface-page);
    color: var(--text-primary);
    padding: 0.65rem 0.75rem;
  }

  .parks-directory__check {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    align-self: end;
    min-height: 46px;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.55rem 0.7rem;
  }

  .parks-directory__check input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .parks-directory__result-bar {
    margin-top: 1.35rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .parks-directory__list {
    display: grid;
    gap: 0;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .parks-directory__list li {
    border-top: 1px solid var(--border-subtle);
  }

  .parks-directory__list li:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  .parks-directory__list li[hidden] {
    display: none;
  }

  .parks-directory__list a {
    display: grid;
    grid-template-columns: 6.5rem minmax(220px, 1.4fr) minmax(190px, 0.8fr) minmax(280px, 1fr) auto;
    gap: 1rem;
    align-items: center;
    min-height: 78px;
    padding: 0.9rem 0.6rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  .parks-directory__list a:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--text-primary);
  }

  .parks-directory__reference {
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.05em;
  }

  .parks-directory__park-name {
    color: var(--surface-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.18rem;
    font-weight: 800;
    line-height: 1.12;
  }

  .parks-directory__location {
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .parks-directory__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .parks-directory__badges > span {
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.22rem 0.45rem;
    color: var(--text-muted);
    font-size: 0.64rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .parks-directory__badges > span[data-variant="relationship"] {
    border-color: color-mix(in srgb, var(--link) 42%, var(--border-subtle));
    background: color-mix(in srgb, var(--link) 8%, transparent);
    color: var(--link-strong);
  }

  .parks-directory__badges > span[data-variant="orange"] { border-color: #b9541766; background: color-mix(in srgb, #ed853b 12%, var(--surface-page)); color: #873600; white-space: normal; }

  @media (prefers-color-scheme: dark) {
    .parks-directory__badges > span[data-variant="orange"] { color: #ffba87; border-color: #ed853b88; }
  }

  .parks-directory__open {
    color: var(--accent-strong);
    font-size: 1.4rem;
    font-weight: 900;
  }

  .parks-directory__empty {
    border: 1px dashed var(--border-subtle);
    border-radius: 8px;
    margin-top: 1rem;
    padding: 2rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 980px) {
    .parks-directory__heading {
      grid-template-columns: 1fr;
    }

    .parks-directory__filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .parks-directory__list a {
      grid-template-columns: 5.5rem minmax(0, 1.3fr) minmax(170px, 0.7fr) auto;
    }

    .parks-directory__badges {
      grid-column: 2 / 4;
    }

    .parks-directory__open {
      grid-column: 4;
      grid-row: 1 / 3;
    }
  }

  @media (max-width: 620px) {
    .parks-directory-hero {
      min-height: 0;
    }

    .parks-directory-hero__map,
    .parks-directory-hero__map :global(.map-preview),
    .parks-directory-hero__map :global(.ri-reference-map) {
      min-height: 460px;
      height: 460px;
    }

    .parks-directory-hero__content {
      position: static;
      padding-block: 1.25rem 1.5rem;
    }

    .parks-directory-hero[data-location-mode="active"] .parks-directory-hero__content {
      display: none;
    }

    .parks-directory-hero__intro {
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      padding: 0;
      backdrop-filter: none;
    }

    .parks-directory-hero h1 {
      max-width: 12ch;
      font-size: clamp(2.55rem, 12vw, 3.6rem);
    }

    .parks-directory__filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .parks-directory__search,
    .parks-directory__clear {
      grid-column: 1 / -1;
    }

    .parks-directory__list a {
      grid-template-columns: 5.1rem minmax(0, 1fr) auto;
      gap: 0.4rem 0.65rem;
      padding-block: 1rem;
    }

    .parks-directory__reference {
      grid-column: 1;
      grid-row: 1;
    }

    .parks-directory__identity {
      grid-column: 2;
      grid-row: 1;
    }

    .parks-directory__park-name {
      font-size: 1.05rem;
    }

    .parks-directory__location {
      grid-column: 2;
      grid-row: 2;
    }

    .parks-directory__badges {
      grid-column: 2;
      grid-row: 3;
    }

    .parks-directory__open {
      grid-column: 3;
      grid-row: 1 / 4;
    }
  }
</style>
