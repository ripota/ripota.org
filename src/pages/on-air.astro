---
import Footer from "../components/Footer.astro";
import Notice from "../components/Notice.astro";
import OnAirNow from "../components/OnAirNow.astro";
import OnAirEventProgress from "../components/OnAirEventProgress.astro";
import ReferenceMap from "../components/ReferenceMap.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Rhode Island on air"
  description="Live Parks on the Air spots in Rhode Island from the official POTA app."
  canonicalPath="/on-air/"
>
  <SiteHeader variant="solid" showEventLink />
  <main id="main" class="on-air-page">
    <section class="on-air-hero" aria-labelledby="on-air-page-title">
      <div class="container on-air-hero__inner">
        <div class="on-air-hero__heading">
          <p class="eyebrow on-air-hero__eyebrow">Live official spots</p>
          <h1 id="on-air-page-title">Rhode Island on air</h1>
          <p class="on-air-hero__copy">
            Live spots from the <a href="https://pota.app/">official POTA app</a>.
          </p>
        </div>
        <OnAirEventProgress />
        <div
          class="on-air-hero__spots"
          id="current-spots"
          aria-labelledby="on-air-now-title"
          data-on-air-section
          hidden
        >
          <OnAirNow variant="full" />
        </div>
        <div class="on-air-hero__map">
          <ReferenceMap
            id="on-air-map"
            variant="on-air"
            title="Rhode Island park activity map"
            caption=""
            legendPlacement="overlay"
            showBoundaries={false}
          />
        </div>
      </div>
    </section>
    <Notice />
  </main>
  <Footer />
</BaseLayout>
