{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ripota-org",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-14",
  "upload_source_maps": true,
  "build": {
    "command": "node scripts/guard-turnstile-production.mjs --required && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/account/*",
      "/embed/*",
      "/activate-ri-2026/admin*",
      "/activate-ri-2026/edit/*",
      "/activate-ri-2026/access*",
      "/activate-ri-2026/activator*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ripota-org",
      "database_id": "5fa75a4d-9387-437d-9f81-ebb06b645747"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVATE_RI_OPS_ROOM",
        "class_name": "ActivateRiOpsRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "activate-ri-ops-room-v1",
      "new_sqlite_classes": ["ActivateRiOpsRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "OPS_RATE_LIMIT_BURST",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 10 }
    },
    {
      "name": "OPS_RATE_LIMIT_SUSTAINED",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMIT_BURST",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 10 }
    },
    {
      "name": "AUTH_EMAIL_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CLIENT_ERROR_RATE_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "ACTIVATE_RI_EVENT_ID": "activate-ri-2026",
    "ACTIVATE_RI_EMAIL_FROM": "activate-ri-2026@ripota.org",
    "ACTIVATE_RI_EMAIL_FROM_NAME": "RI POTA",
    "SITE_ORIGIN": "https://ripota.org",
    "TURNSTILE_REQUIRED": "true",
    "AUTH_ADMIN_MODE": "passkey",
    "AUTH_ACTIVATOR_MODE": "unified",
    "AUTH_EMAIL_LOGIN_ENABLED": "true",
    "AUTH_LEGACY_LINK_ISSUANCE_ENABLED": "false"
  },
  "env": {
    "local": {
      "build": {
        "command": "npm run build:local"
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ripota-org",
          "database_id": "5fa75a4d-9387-437d-9f81-ebb06b645747"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ACTIVATE_RI_OPS_ROOM",
            "class_name": "ActivateRiOpsRoom"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "OPS_RATE_LIMIT_BURST",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 10 }
        },
        {
          "name": "OPS_RATE_LIMIT_SUSTAINED",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMIT_BURST",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 10 }
        },
        {
          "name": "AUTH_EMAIL_RATE_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "CLIENT_ERROR_RATE_LIMIT",
          "namespace_id": "1005",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "vars": {
        "ALLOW_LOCAL_ADMIN_AUTH": "true",
        "ACTIVATE_RI_EVENT_ID": "activate-ri-2026",
        "ACTIVATE_RI_EMAIL_FROM": "activate-ri-2026@ripota.org",
        "ACTIVATE_RI_EMAIL_FROM_NAME": "RI POTA",
        "LOCAL_ADMIN_EMAIL": "local-admin@ripota.org",
        "PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_REQUIRED": "false",
        "AUTH_ADMIN_MODE": "dual",
        "AUTH_ACTIVATOR_MODE": "dual",
        "AUTH_EMAIL_LOGIN_ENABLED": "true",
        "AUTH_LEGACY_LINK_ISSUANCE_ENABLED": "false"
      }
    },
    "production-data": {
      "build": {
        "command": "npm run build:local"
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ripota-org",
          "database_id": "5fa75a4d-9387-437d-9f81-ebb06b645747",
          "remote": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ACTIVATE_RI_OPS_ROOM",
            "class_name": "ActivateRiOpsRoom"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "OPS_RATE_LIMIT_BURST",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 10 }
        },
        {
          "name": "OPS_RATE_LIMIT_SUSTAINED",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMIT_BURST",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 10 }
        },
        {
          "name": "AUTH_EMAIL_RATE_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "CLIENT_ERROR_RATE_LIMIT",
          "namespace_id": "1005",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "vars": {
        "ACTIVATE_RI_EVENT_ID": "activate-ri-2026",
        "ACTIVATE_RI_EMAIL_FROM": "activate-ri-2026@ripota.org",
        "ACTIVATE_RI_EMAIL_FROM_NAME": "RI POTA",
        "ALLOW_LOCAL_ADMIN_AUTH": "true",
        "LOCAL_ADMIN_EMAIL": "local-admin@ripota.org",
        "PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "REMOTE_DATA_READ_ONLY": "true",
        "TURNSTILE_REQUIRED": "false",
        "AUTH_ADMIN_MODE": "dual",
        "AUTH_ACTIVATOR_MODE": "dual",
        "AUTH_EMAIL_LOGIN_ENABLED": "false",
        "AUTH_LEGACY_LINK_ISSUANCE_ENABLED": "true"
      }
    }
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
