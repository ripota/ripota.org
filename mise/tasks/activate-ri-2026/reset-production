#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; -*-
#MISE description="Back up and reset production Activate RI operational data"
#MISE raw=true
#USAGE flag "--confirm" help="Actually reset the remote production D1 rows"

set -euo pipefail

database_name="ripota-org"
wrangler=(npx wrangler)
base_env=(--env "")

reset_sql="
DELETE FROM activate_ri_ops_email_recipients;
DELETE FROM activate_ri_ops_email_broadcasts;
DELETE FROM activate_ri_ops_events;
DELETE FROM activate_ri_ops_messages;
DELETE FROM activate_ri_ops_memberships;
UPDATE activate_ri_ops_settings
SET room_mode = 'off', pinned_message_id = NULL,
    updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now'),
    updated_by = 'database-reset';
DELETE FROM activate_ri_activator_sessions;
DELETE FROM activate_ri_edit_tokens;
DELETE FROM auth_audit_events;
DELETE FROM auth_webauthn_challenges;
DELETE FROM auth_email_tokens;
DELETE FROM auth_sessions;
DELETE FROM auth_passkey_credentials;
DELETE FROM auth_activator_memberships;
DELETE FROM auth_event_roles;
DELETE FROM auth_user_emails;
DELETE FROM auth_users;
DELETE FROM activate_ri_activity_events;
DELETE FROM activate_ri_audit_events;
DELETE FROM activate_ri_stops;
DELETE FROM activate_ri_activators;
"

verify_sql="
SELECT 'ops_email_recipients' AS table_name, COUNT(*) AS row_count FROM activate_ri_ops_email_recipients
UNION ALL
SELECT 'ops_email_broadcasts', COUNT(*) FROM activate_ri_ops_email_broadcasts
UNION ALL
SELECT 'ops_events', COUNT(*) FROM activate_ri_ops_events
UNION ALL
SELECT 'ops_messages', COUNT(*) FROM activate_ri_ops_messages
UNION ALL
SELECT 'ops_memberships', COUNT(*) FROM activate_ri_ops_memberships
UNION ALL
SELECT 'activator_sessions', COUNT(*) FROM activate_ri_activator_sessions
UNION ALL
SELECT 'edit_tokens', COUNT(*) FROM activate_ri_edit_tokens
UNION ALL
SELECT 'auth_audit_events', COUNT(*) FROM auth_audit_events
UNION ALL
SELECT 'auth_challenges', COUNT(*) FROM auth_webauthn_challenges
UNION ALL
SELECT 'auth_email_tokens', COUNT(*) FROM auth_email_tokens
UNION ALL
SELECT 'auth_sessions', COUNT(*) FROM auth_sessions
UNION ALL
SELECT 'auth_passkeys', COUNT(*) FROM auth_passkey_credentials
UNION ALL
SELECT 'auth_memberships', COUNT(*) FROM auth_activator_memberships
UNION ALL
SELECT 'auth_roles', COUNT(*) FROM auth_event_roles
UNION ALL
SELECT 'auth_users', COUNT(*) FROM auth_users
UNION ALL
SELECT 'activity_events', COUNT(*) FROM activate_ri_activity_events
UNION ALL
SELECT 'audit_events', COUNT(*) FROM activate_ri_audit_events
UNION ALL
SELECT 'stops', COUNT(*) FROM activate_ri_stops
UNION ALL
SELECT 'activators', COUNT(*) FROM activate_ri_activators;
"

if [[ "${usage_confirm:-false}" != "true" ]]; then
  cat <<'EOF'
This task deletes production Activate RI operational rows from the remote D1
database. It keeps the schema and D1 migration metadata intact.

Run with --confirm to continue:

  mise run activate-ri-2026:reset-production -- --confirm
EOF
  exit 64
fi

echo "Checking Cloudflare Wrangler authentication."
"${wrangler[@]}" whoami

mise run backup-production

echo "Resetting production Activate RI operational rows in ${database_name}."
"${wrangler[@]}" d1 execute "${database_name}" --remote "${base_env[@]}" --command="${reset_sql}"

echo "Verifying production Activate RI operational row counts."
"${wrangler[@]}" d1 execute "${database_name}" --remote "${base_env[@]}" --command="${verify_sql}"
